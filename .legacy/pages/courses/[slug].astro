---
import Layout from "../../components/Layout.astro";
import { ui } from "../../i18n/ui";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses.map((c) => ({ params: { slug: c.id }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { data } = entry;
const lang = "en" as const;
const t = (k: keyof typeof ui.en) => ui[lang][k];
const title = data.title[lang];
const sections = [
  { key: "course.overview", body: data.summary[lang] },
];
const statusKey = data.status === "open" ? "course.statusOpen" : data.status === "planned" ? "course.statusPlanned" : "course.statusInDevelopment";
const curriculumEn = data.curriculum.en;
---

<Layout
  lang={lang}
  path={`/courses/${entry.id}`}
  title={`${title} — Ahmad Fathan Hidayatullah`}
  description={data.summary[lang]}
>
  <div class="border-b border-line bg-soft">
    <div class="container-site py-14">
      <nav class="text-xs font-medium text-faint" aria-label="Breadcrumb">
        <a href="/courses" class="hover:text-primary">Courses</a>
        <span class="mx-1.5" aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-primary-soft px-3 py-1 text-xs font-semibold text-primary">{t(statusKey)}</span>
        <span class="rounded-full bg-soft px-3 py-1 text-xs font-medium text-muted">{data.difficulty[lang]}</span>
        <span class="rounded-full bg-soft px-3 py-1 text-xs font-medium text-muted">{data.duration[lang]}</span>
      </div>
      <h1 class="mt-5 max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{data.summary[lang]}</p>
      <div class="mt-8">
        {data.registrationUrl ? (
          <a href={data.registrationUrl} class="btn btn-primary">{data.status === "open" ? t("course.register") : "Pre-register"}</a>
        ) : (
          <span class="inline-flex items-center gap-2 rounded-lg bg-paper px-5 py-2.5 text-sm font-semibold text-faint ring-1 ring-line" aria-disabled="true">
            {data.status === "open" ? t("course.register") : data.status === "planned" ? "Registration opens soon — stay tuned" : "In development"}
          </span>
        )}
      </div>
    </div>
  </div>

  <div class="container-site grid gap-12 py-14 lg:grid-cols-3">
    <div class="space-y-12 lg:col-span-2">
      <section>
        <h2 class="text-2xl font-bold tracking-tight">{t("course.overview")}</h2>
        <p class="mt-4 leading-relaxed text-muted">{data.summary[lang]}</p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight">{t("course.outcomes")}</h2>
        <ul class="mt-4 space-y-2.5">
          {data.outcomes[lang].map((o) => (
            <li class="flex items-start gap-3">
              <svg class="mt-1 shrink-0 text-primary" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{o}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight">{t("course.audience")}</h2>
        <ul class="mt-4 space-y-2.5">
          {data.targetAudience[lang].map((a) => (
            <li class="flex items-start gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span><span>{a}</span></li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight">{t("course.prerequisites")}</h2>
        <ul class="mt-4 space-y-2.5">
          {data.prerequisites[lang].map((p) => (
            <li class="flex items-start gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span><span>{p}</span></li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight">{t("course.curriculum")}</h2>
        <div class="mt-6 space-y-5">
          {curriculumEn.map((m, i) => (
            <div class="rounded-xl border border-line bg-paper p-6">
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-sm font-bold text-primary">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="text-lg font-semibold tracking-tight">{m.module}</h3>
              </div>
              <ul class="mt-3 space-y-1.5 pl-8 text-sm text-muted">
                {m.topics.map((topic) => <li>· {topic}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight">{t("course.format")}</h2>
        <p class="mt-4 leading-relaxed text-muted">{data.learningFormat[lang]}</p>
      </section>
    </div>

    <aside class="h-fit space-y-6 lg:sticky lg:top-24">
      <div class="rounded-xl border border-line bg-soft p-6">
        <p class="eyebrow">{t("course.instructor")}</p>
        <p class="mt-2 font-semibold">{t("course.instructorName")}</p>
        <p class="mt-1 text-sm text-muted">Lecturer · Researcher · Speaker</p>
        <p class="mt-1 text-sm text-muted">Universitas Islam Indonesia (UII)</p>
      </div>
      <div class="rounded-xl border border-line bg-paper p-6 text-sm text-muted">
        <p>Course status: <strong class="text-ink">{t(statusKey)}</strong></p>
        <p class="mt-2">Registration details will be published here when the course opens.</p>
      </div>
    </aside>
  </div>
</Layout>
