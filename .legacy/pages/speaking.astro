---
import Layout from "../components/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import EmptyState from "../components/EmptyState.astro";
import { ui, type UIKey } from "../i18n/ui";
import { profiles } from "../config/site";
import { getCollection } from "astro:content";

const t = (k: UIKey) => ui.en[k];
const events = (await getCollection("speaking")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const typeLabel: Record<string, { en: string }> = {
  seminar: { en: "Seminar" }, workshop: { en: "Workshop" }, training: { en: "Training" },
  "guest-lecture": { en: "Guest Lecture" }, conference: { en: "Conference" }, community: { en: "Community Sharing" },
};
const inviteSubject = encodeURIComponent("Speaking / workshop invitation for Ahmad Fathan Hidayatullah");
---

<Layout lang="en" path="/speaking" title="Speaking — Ahmad Fathan Hidayatullah" description="Speaking portfolio of Ahmad Fathan Hidayatullah: seminars, workshops, trainings, and guest lectures.">
  <PageHeader eyebrow="Speaking" title="Speaking & Sharing" lede="Seminars, workshops, trainings, guest lectures, and community sharing. Events are listed newest first." />

  <div class="container-site py-14 space-y-14">
    {events.length > 0 && (
      <div class="space-y-5">
        {events.map((e) => {
          const { data } = e;
          return (
            <article class="rounded-xl border border-line bg-paper p-6">
              <div class="flex flex-wrap items-center gap-2 text-xs font-medium text-faint">
                <span class="rounded-full bg-primary-soft px-2.5 py-0.5 font-semibold text-primary">{typeLabel[data.type].en}</span>
                <time datetime={data.date.toISOString()}>{data.date.toLocaleDateString("en-US", { year: "numeric", month: "long" })}</time>
                <span>·</span><span>{data.organizer}</span>
                <span>·</span><span>{data.location.en}</span>
              </div>
              <h2 class="mt-3 text-xl font-semibold tracking-tight">{data.title.en}</h2>
              {data.topic?.en && <p class="mt-1 text-sm font-medium text-primary">{data.topic.en}</p>}
              {data.description?.en && <p class="mt-3 text-sm leading-relaxed text-muted">{data.description.en}</p>}
              {(data.eventUrl || data.materialUrl) && (
                <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1.5 text-sm">
                  {data.eventUrl && <a href={data.eventUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:text-primary-dark">Event ↗</a>}
                  {data.materialUrl && <a href={data.materialUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:text-primary-dark">Materials ↗</a>}
                </div>
              )}
            </article>
          );
        })}
      </div>
    )}

    {events.length === 0 && <EmptyState lang="en" />}

    <section class="rounded-2xl border border-line bg-primary-soft/60 p-10 text-center">
      <h2 class="text-2xl font-bold tracking-tight">Invite Me to Speak</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">
        Looking for a speaker, trainer, or workshop facilitator on AI, NLP, Data Science, or academic topics?
        I am open to seminars, workshops, guest lectures, and training — for universities, communities, and professional audiences.
      </p>
      <a href={`mailto:${profiles.email}?subject=${inviteSubject}`} class="btn btn-primary mt-7">{t("cta.inviteSpeak")}</a>
    </section>
  </div>
</Layout>
