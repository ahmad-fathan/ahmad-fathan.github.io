---
import Layout from "../components/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { ui, type UIKey } from "../i18n/ui";

const t = (k: UIKey) => ui.en[k];
const sections = [
  { title: "Ceramah & Islamic Talks", desc: "Recorded talks and lecture notes on Islamic themes." },
  { title: "Pengajian Notes", desc: "Summaries and notes from regular study circles." },
  { title: "Basic Qur'an Learning", desc: "Guides and materials for learning to read the Qur'an." },
  { title: "Selected Readings", desc: "Curated articles and reminders for everyday practice." },
];
---

<Layout lang="en" path="/dakwah" title="Dakwah & Islamic Learning — Ahmad Fathan Hidayatullah" description="Islamic talks, study notes, and learning materials shared by Ahmad Fathan Hidayatullah.">
  <PageHeader eyebrow="Dakwah" title="Dakwah & Islamic Learning" lede="Islamic talks (ceramah), study circle notes (pengajian), basic Qur'an learning, and selected materials — shared in the same spirit of learning and teaching that drives the rest of this site." />

  <div class="container-site py-14">
    <div class="grid gap-5 sm:grid-cols-2">
      {sections.map((s) => (
        <div class="rounded-xl border border-dashed border-line bg-soft/50 p-7">
          <h2 class="text-lg font-semibold tracking-tight">{s.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.desc}</p>
          <p class="mt-4 text-xs font-medium text-faint">Materials coming soon.</p>
        </div>
      ))}
    </div>
  </div>
</Layout>
