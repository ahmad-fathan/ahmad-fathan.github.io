---
import Layout from "../../components/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import EmptyState from "../../components/EmptyState.astro";
import { ui, type UIKey } from "../../i18n/ui";
import { profiles } from "../../config/site";
import { getCollection } from "astro:content";

const t = (k: UIKey) => ui.id[k];
const events = (await getCollection("speaking")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const typeLabel: Record<string, { id: string }> = {
  seminar: { id: "Seminar" }, workshop: { id: "Lokakarya" }, training: { id: "Pelatihan" },
  "guest-lecture": { id: "Kuliah Tamu" }, conference: { id: "Konferensi" }, community: { id: "Berbagi Komunitas" },
};
const inviteSubject = encodeURIComponent("Undangan berbicara / lokakarya untuk Ahmad Fathan Hidayatullah");
---

<Layout lang="id" path="/id/speaking" title="Berbicara — Ahmad Fathan Hidayatullah" description="Portofolio berbicara Ahmad Fathan Hidayatullah: seminar, lokakarya, pelatihan, dan kuliah tamu.">
  <PageHeader eyebrow="Berbicara" title="Berbicara & Berbagi" lede="Seminar, lokakarya, pelatihan, kuliah tamu, dan berbagi dengan komunitas. Kegiatan dicantumkan dari yang terbaru." />

  <div class="container-site py-14 space-y-14">
    {events.length > 0 && (
      <div class="space-y-5">
        {events.map((e) => {
          const { data } = e;
          return (
            <article class="rounded-xl border border-line bg-paper p-6">
              <div class="flex flex-wrap items-center gap-2 text-xs font-medium text-faint">
                <span class="rounded-full bg-primary-soft px-2.5 py-0.5 font-semibold text-primary">{typeLabel[data.type].id}</span>
                <time datetime={data.date.toISOString()}>{data.date.toLocaleDateString("id-ID", { year: "numeric", month: "long" })}</time>
                <span>·</span><span>{data.organizer}</span>
                <span>·</span><span>{data.location.id}</span>
              </div>
              <h2 class="mt-3 text-xl font-semibold tracking-tight">{data.title.id}</h2>
              {data.topic?.id && <p class="mt-1 text-sm font-medium text-primary">{data.topic.id}</p>}
              {data.description?.id && <p class="mt-3 text-sm leading-relaxed text-muted">{data.description.id}</p>}
              {(data.eventUrl || data.materialUrl) && (
                <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1.5 text-sm">
                  {data.eventUrl && <a href={data.eventUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:text-primary-dark">Acara ↗</a>}
                  {data.materialUrl && <a href={data.materialUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:text-primary-dark">Materi ↗</a>}
                </div>
              )}
            </article>
          );
        })}
      </div>
    )}

    {events.length === 0 && <EmptyState lang="id" />}

    <section class="rounded-2xl border border-line bg-primary-soft/60 p-10 text-center">
      <h2 class="text-2xl font-bold tracking-tight">Undang Saya sebagai Pembicara</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">
        Mencari pembicara, pelatih, atau fasilitator lokakarya untuk topik AI, NLP, Sains Data, atau akademik?
        Saya terbuka untuk seminar, lokakarya, kuliah tamu, dan pelatihan — untuk universitas, komunitas, maupun audiens profesional.
      </p>
      <a href={`mailto:${profiles.email}?subject=${inviteSubject}`} class="btn btn-primary mt-7">{t("cta.inviteSpeak")}</a>
    </section>
  </div>
</Layout>
