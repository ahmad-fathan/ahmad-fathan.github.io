---
import Layout from "../../components/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import EmptyState from "../../components/EmptyState.astro";
import PublicationCite from "../../components/PublicationCite.astro";
import TeachingGroups from "../../components/TeachingGroups.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { site, profiles } from "../../config/site";
import { publications } from "../../data/publications";
import { ui } from "../../i18n/ui";
import { getCollection } from "astro:content";

const t = (k: keyof typeof ui.id) => ui.id[k];
const latest = [...publications].sort((a, b) => b.year - a.year).slice(0, 3);
const courseEntries = await getCollection("courses");
const featuredCourse = courseEntries[0];
const posts = (await getCollection("writing", ({ data }) => data.language === "id" && !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 4);

const what = [
  { title: t("home.teaching.title"), desc: t("home.teaching.desc"), href: "/id/teaching", num: "01" },
  { title: t("home.research.title"), desc: t("home.research.desc"), href: "/id/research", num: "02" },
  { title: t("home.speaking.title"), desc: t("home.speaking.desc"), href: "/id/speaking", num: "03" },
  { title: t("home.writing.title"), desc: t("home.writing.desc"), href: "/id/writing", num: "04" },
];
---

<Layout lang="id" path="/id/">
  <!-- Hero -->
  <section class="border-b border-line bg-soft">
    <div class="container-site py-20 text-center sm:py-24">
      <img
        src="/images/profile.jpg"
        alt="Ahmad Fathan Hidayatullah"
        width="512"
        height="512"
        class="mx-auto h-36 w-36 rounded-full border-4 border-paper object-cover shadow-xl ring-1 ring-line sm:h-44 sm:w-44"
      />
      <p class="eyebrow mt-8">Situs Akademik Pribadi</p>
      <h1 class="mx-auto mt-4 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">
        Ahmad Fathan Hidayatullah
      </h1>
      <p class="mt-4 text-lg font-semibold text-primary sm:text-xl">{site.tagline.id}</p>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-muted">{site.intro.id}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="/id/research" class="btn btn-primary">{t("cta.exploreResearch")}</a>
        <a href="/id/courses" class="btn btn-outline">{t("cta.learnDataScience")}</a>
      </div>
    </div>
  </section>

  <!-- What I Do -->
  <section class="container-site py-16 sm:py-20">
    <SectionHeading title={t("home.whatIDo")} />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {what.map((w) => (
        <a href={w.href} class="group rounded-xl border border-line bg-paper p-6 transition-colors hover:border-primary/50">
          <span class="font-mono text-xs font-semibold text-faint">{w.num}</span>
          <h3 class="mt-3 text-lg font-semibold tracking-tight group-hover:text-primary">{w.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{w.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured Research -->
  <section class="border-t border-line bg-soft">
    <div class="container-site py-16 sm:py-20">
      <SectionHeading title={t("home.featuredResearch")} linkHref="/id/research" linkLabel={t("cta.viewAll") + " →"} />
      <ol class="grid list-none gap-5 md:grid-cols-3">
        {latest.map((p) => (
          <li class="flex flex-col justify-between rounded-xl border border-line bg-paper p-5">
            <PublicationCite pub={p} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Teaching & Learning -->
  <section class="container-site py-16 sm:py-20">
    <SectionHeading title={t("home.teachingLearning")} />
    <TeachingGroups lang="id" />
  </section>

  <!-- Learn Data Science -->
  {featuredCourse && (
    <section class="border-t border-line bg-primary-soft/60">
      <div class="container-site grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-2">
        <div>
          <p class="eyebrow">{t("home.learnDataScience")}</p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">{featuredCourse.data.title.id}</h2>
          <p class="mt-4 max-w-xl leading-relaxed text-muted">{featuredCourse.data.summary.id}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={`/id/courses/${featuredCourse.id}`} class="btn btn-primary">{t("cta.learnDataScience")}</a>
            <a href="/id/courses" class="btn btn-outline">{t("cta.viewAll")}</a>
          </div>
        </div>
        <div class="rounded-xl border border-line bg-paper p-7">
          <p class="text-sm font-semibold text-ink">{featuredCourse.data.duration.id}</p>
          <ul class="mt-4 space-y-3">
            {featuredCourse.data.topics.map((topic) => (
              <li class="flex items-center gap-3 text-sm text-muted">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                {topic}
              </li>
            ))}
          </ul>
          <p class="mt-5 rounded-lg bg-soft px-4 py-3 text-xs font-medium text-faint">
            {featuredCourse.data.difficulty.id} · Direncanakan
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- Latest Writing -->
  <section class="container-site py-16 sm:py-20">
    <SectionHeading title={t("home.latestWriting")} linkHref="/id/writing" linkLabel={t("cta.viewAll") + " →"} />
    {posts.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2">
        {posts.map((p) => <ArticleCard entry={p} lang="id" />)}
      </div>
    ) : (
      <EmptyState lang="id" />
    )}
  </section>

  <!-- Speaking & Sharing -->
  <section class="border-t border-line bg-soft">
    <div class="container-site py-16 sm:py-20">
      <SectionHeading title={t("home.speakingSharing")} linkHref="/id/speaking" linkLabel={t("cta.viewAll") + " →"} />
      <EmptyState lang="id" />
      <div class="text-center">
        <a href={`mailto:${profiles.email}?subject=${encodeURIComponent("Undangan berbicara / lokakarya untuk Ahmad Fathan Hidayatullah")}`} class="btn btn-primary">{t("cta.inviteSpeak")}</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="container-site py-16 sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">{t("home.about")}</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">Ahmad Fathan Hidayatullah</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">{t("home.aboutExcerpt")}</p>
      <a href="/id/about" class="btn btn-outline mt-8">{t("cta.moreAbout")}</a>
    </div>
  </section>
</Layout>
