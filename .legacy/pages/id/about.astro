---
import Layout from "../../components/Layout.astro";
import { site, researchInterests } from "../../config/site";

const education = [
  { degree: "Ph.D.", field: "Computer Science", university: "Universiti Brunei Darussalam", country: "Brunei Darussalam", year: "2024" },
  { degree: "M.Cs.", field: "Computer Science", university: "Universitas Gadjah Mada", country: "Indonesia", year: "2014" },
  { degree: "B.Eng.", field: "Informatika", university: "Universitas Islam Negeri Sunan Kalijaga Yogyakarta", country: "Indonesia", year: "2010" },
];
const roles = [
  "Dosen pada program studi informatika di Universitas Islam Indonesia (UII)",
  "Peneliti di bidang Natural Language Processing, LLM, dan Sains Data",
  "Pembicara, pelatih, dan fasilitator lokakarya",
  "Penulis tentang teknologi, AI, kehidupan akademik, dan lainnya",
];
---

<Layout lang="id" path="/id/about" title="Tentang — Ahmad Fathan Hidayatullah" description="Kenali Ahmad Fathan Hidayatullah: dosen, peneliti, dan pembicara di bidang Kecerdasan Artifisial, NLP, dan Sains Data di Universitas Islam Indonesia.">
  <section class="border-b border-line bg-soft">
    <div class="container-site flex flex-col items-center gap-8 py-14 text-center sm:py-16 md:flex-row md:items-center md:gap-12 md:text-left">
      <img
        src="/images/profile.jpg"
        alt="Ahmad Fathan Hidayatullah"
        width="512"
        height="512"
        class="h-40 w-40 shrink-0 rounded-full border-4 border-paper object-cover shadow-xl ring-1 ring-line sm:h-48 sm:w-48"
      />
      <div>
        <p class="eyebrow">Tentang</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Ahmad Fathan Hidayatullah</h1>
        <p class="mt-3 text-lg font-semibold text-primary">{site.tagline.id}</p>
        <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-muted md:mx-0">{site.intro.id}</p>
      </div>
    </div>
  </section>

  <div class="container-site py-14">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-12">
        <!-- Biography -->
        <section aria-labelledby="intro">
          <h2 id="intro" class="text-2xl font-bold tracking-tight">Biografi</h2>
          <div class="prose-article mt-5">
            <p>
              Ahmad Fathan Hidayatullah adalah Asisten Profesor di Departemen Informatika, Fakultas Teknologi
              Industri, Universitas Islam Indonesia. Ia memperoleh gelar PhD bidang Computer Science pada tahun
              2024 dari School of Digital Science, Universiti Brunei Darussalam, dengan beasiswa Universiti Brunei
              Darussalam Graduate Scholarship (UGS).
            </p>
            <p>
              Ia meraih gelar Magister (M.Cs.) Ilmu Komputer dari Universitas Gadjah Mada, Indonesia, pada tahun
              2014, serta gelar Sarjana (B.Eng.) Informatika dari Universitas Islam Negeri Sunan Kalijaga
              Yogyakarta, Indonesia, pada tahun 2010.
            </p>
            <p>
              Minat risetnya meliputi text mining, pemrosesan bahasa alami, sains data, dan kecerdasan artifisial,
              dengan fokus khusus pada bahasa dengan sumber daya rendah (low-resource languages) dan NLP terapan.
              Ia aktif dalam riset kolaboratif di Center of Data Science, Universitas Islam Indonesia.
            </p>
          </div>
        </section>

        <!-- Current Roles -->
        <section aria-labelledby="roles">
          <h2 id="roles" class="text-2xl font-bold tracking-tight">Peran Saat Ini</h2>
          <ul class="mt-5 space-y-3">
            {roles.map((role) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                <span>{role}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Education -->
        <section aria-labelledby="education">
          <h2 id="education" class="text-2xl font-bold tracking-tight">Pendidikan</h2>
          <div class="mt-5 overflow-x-auto rounded-xl border border-line">
            <table class="w-full min-w-[560px] text-left text-sm">
              <thead class="bg-soft text-xs uppercase tracking-wider text-faint">
                <tr><th class="px-4 py-3 font-semibold">Gelar</th><th class="px-4 py-3 font-semibold">Bidang</th><th class="px-4 py-3 font-semibold">Universitas</th><th class="px-4 py-3 font-semibold">Negara</th><th class="px-4 py-3 font-semibold">Tahun</th></tr>
              </thead>
              <tbody class="divide-y divide-line">
                {education.map((e) => (
                  <tr>
                    <td class="px-4 py-3 font-medium">{e.degree}</td>
                    <td class="px-4 py-3 text-muted">{e.field}</td>
                    <td class="px-4 py-3 text-muted">{e.university}</td>
                    <td class="px-4 py-3 text-muted">{e.country}</td>
                    <td class="px-4 py-3 text-muted">{e.year}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-8">
        <div class="rounded-xl border border-line bg-soft p-6">
          <p class="eyebrow">Profil</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">Dosen · Peneliti · Pembicara</p>
          <p class="mt-3 text-sm text-muted"><strong class="text-ink">Lokasi:</strong> {site.location}</p>
          <p class="mt-2 text-sm text-muted"><strong class="text-ink">Universitas:</strong> Universitas Islam Indonesia</p>
        </div>
        <div>
          <p class="eyebrow">Minat Riset</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {researchInterests.map((r) => (
              <a href="/id/research" class="rounded-full border border-line px-3 py-1.5 text-sm text-muted hover:border-primary hover:text-primary">{r}</a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>
