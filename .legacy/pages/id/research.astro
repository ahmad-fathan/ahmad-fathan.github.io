---
import Layout from "../../components/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PublicationCite from "../../components/PublicationCite.astro";
import { researchInterests, profiles } from "../../config/site";
import { publications } from "../../data/publications";

const sorted = [...publications].sort((a, b) => b.year - a.year);
const years = [...new Set(sorted.map((p) => p.year))].sort((a, b) => b - a);

const scholarProfiles = [
  { label: "Google Scholar", href: profiles.googleScholar, id: "scholar" },
  { label: "Scopus", href: profiles.scopus, id: "scopus" },
  { label: "ORCID", href: profiles.orcid, id: "orcid" },
];
---

<Layout lang="id" path="/id/research" title="Publikasi & Riset — Ahmad Fathan Hidayatullah" description="Minat riset dan publikasi terbaru (2024–2026) Ahmad Fathan Hidayatullah: Natural Language Processing, Large Language Models, Text Mining, dan Sains Data.">
  <PageHeader
    eyebrow="Publikasi & Riset"
    title="Publikasi & Riset"
    lede="Minat riset dan publikasi terbaru di bidang Natural Language Processing, Large Language Models, Text Mining, dan Sains Data — dengan fokus pada bahasa dengan sumber daya terbatas dan bahasa campuran (code-mixed)."
  />

  <div class="container-site py-14 space-y-16">
    <section aria-labelledby="author-profiles">
      <h2 id="author-profiles" class="text-2xl font-bold tracking-tight">Profil Penulis</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
        Daftar publikasi lengkap dan metrik sitasi tersedia pada profil penulis berikut.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        {scholarProfiles.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
            aria-label={`Profil ${s.label} (terbuka di tab baru)`}
          >
            {s.label} ↗
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="interests">
      <h2 id="interests" class="text-2xl font-bold tracking-tight">Minat Riset</h2>
      <div class="mt-5 flex flex-wrap gap-2">
        {researchInterests.map((r) => (
          <span class="rounded-full border border-line bg-soft px-4 py-2 text-sm font-medium text-ink">{r}</span>
        ))}
      </div>
    </section>

    <section aria-labelledby="recent-publications">
      <h2 id="recent-publications" class="text-2xl font-bold tracking-tight">Publikasi Terbaru</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
        Publikasi tiga tahun terakhir (2024–2026) dalam format sitasi APA. Diambil dari
        <a href={profiles.googleScholar} target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:text-primary-dark"> Google Scholar</a>
        dan dilengkapi metadata DOI; profil Scholar tetap menjadi sumber daftar lengkap yang otoritatif dan selalu terbaru.
      </p>

      <div class="mt-8 space-y-10">
        {years.map((year) => (
          <div>
            <h3 class="flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-faint">
              <span>{year}</span>
              <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
            </h3>
            <ol class="mt-4 list-none space-y-5">
              {sorted
                .filter((p) => p.year === year)
                .map((p) => (
                  <li class="pl-8 -indent-8">
                    <PublicationCite pub={p} />
                  </li>
                ))}
            </ol>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
