---
import Layout from "../../../components/Layout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import { categoryLabel, categories } from "../../../lib/utils";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c } }));
}

const { category } = Astro.params;
const lang = "id" as const;
const posts = (await getCollection("writing", ({ data }) => data.language === "id" && !data.draft && data.category === category)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const catLabel = categoryLabel(category ?? "", lang);
const labels: Record<string, string> = { technology: "Teknologi", academic: "Akademik", islam: "Islam", life: "Kehidupan" };
---

<Layout
  lang={lang}
  path={`/id/writing/${category}`}
  title={`${catLabel} — Tulisan | Ahmad Fathan Hidayatullah`}
  description={`Artikel kategori ${catLabel} oleh Ahmad Fathan Hidayatullah.`}
>
  <PageHeader eyebrow="Tulisan" title={catLabel} lede="Artikel dalam kategori ini." />

  <div class="container-site py-14">
    <div class="mb-8 flex flex-wrap gap-2">
      <a href="/id/writing" class="rounded-full border border-line px-3 py-1.5 text-sm text-muted hover:border-primary hover:text-primary">Semua</a>
      {categories.filter((c) => c !== category).map((c) => (
        <a href={`/id/writing/${c}`} class="rounded-full border border-line px-3 py-1.5 text-sm text-muted hover:border-primary hover:text-primary">{labels[c]}</a>
      ))}
    </div>
    {posts.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2">
        {posts.map((p) => <ArticleCard entry={p} lang={lang} />)}
      </div>
    ) : (
      <p class="rounded-xl border border-dashed border-line p-8 text-center text-sm text-muted">Belum ada artikel pada kategori ini.</p>
    )}
  </div>
</Layout>
