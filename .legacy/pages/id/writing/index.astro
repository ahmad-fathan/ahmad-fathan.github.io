---
import Layout from "../../../components/Layout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import { categoryLabel } from "../../../lib/utils";
import { ui, type UIKey } from "../../../i18n/ui";
import { getCollection } from "astro:content";

const lang = "id" as const;
const t = (k: UIKey) => ui[lang][k];
const posts = (await getCollection("writing", ({ data }) => data.language === "id" && !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = [
  { slug: "technology", label: "Teknologi" },
  { slug: "academic", label: "Akademik" },
  { slug: "islam", label: "Islam" },
  { slug: "life", label: "Kehidupan" },
];
const counts = new Map<string, number>();
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
---

<Layout lang={lang} path="/id/writing" title="Tulisan — Ahmad Fathan Hidayatullah" description="Artikel oleh Ahmad Fathan Hidayatullah tentang teknologi, kehidupan akademik, Islam, dan refleksi pribadi.">
  <PageHeader eyebrow="Tulisan" title="Tulisan" lede="Catatan dan artikel tentang teknologi, kecerdasan artifisial, sains data, kehidupan akademik, Islam, dan refleksi pribadi." />

  <div class="container-site py-14">
    <div class="grid gap-5 md:grid-cols-4">
      {categories.map((c) => (
        <a href={`/id/writing/${c.slug}`} class="group rounded-xl border border-line bg-paper p-6 transition-colors hover:border-primary/50">
          <p class="font-mono text-xs font-semibold text-faint">{counts.get(c.slug) ?? 0} artikel</p>
          <h2 class="mt-2 text-lg font-semibold tracking-tight group-hover:text-primary">{c.label}</h2>
          <p class="mt-1 text-sm text-muted">Lihat →</p>
        </a>
      ))}
    </div>

    <section class="mt-16" aria-label={t("writing.categories")}>
      <h2 class="mb-6 text-2xl font-bold tracking-tight">Semua Artikel</h2>
      {posts.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2">
          {posts.map((p) => <ArticleCard entry={p} lang={lang} />)}
        </div>
      ) : (
        <p class="rounded-xl border border-dashed border-line p-8 text-center text-sm text-muted">Belum ada artikel yang dipublikasikan.</p>
      )}
    </section>
  </div>
</Layout>
