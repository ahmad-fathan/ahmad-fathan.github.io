---
import Layout from "../../components/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { ui, type UIKey } from "../../i18n/ui";
import { getCollection } from "astro:content";

const lang = "en" as const;
const t = (k: UIKey) => ui[lang][k];
const posts = (await getCollection("writing", ({ data }) => data.language === "en" && !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = [
  { slug: "technology", label: "Technology" },
  { slug: "academic", label: "Academic" },
  { slug: "islam", label: "Islam" },
  { slug: "life", label: "Life" },
];
const counts = new Map<string, number>();
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
---

<Layout lang={lang} path="/writing" title="Writing — Ahmad Fathan Hidayatullah" description="Articles by Ahmad Fathan Hidayatullah on technology, academic life, Islam, and personal reflections.">
  <PageHeader eyebrow="Writing" title="Writing" lede="Notes and articles on technology, artificial intelligence, data science, academic life, Islam, and personal reflections." />

  <div class="container-site py-14">
    <div class="grid gap-5 md:grid-cols-4">
      {categories.map((c) => (
        <a href={`/writing/${c.slug}`} class="group rounded-xl border border-line bg-paper p-6 transition-colors hover:border-primary/50">
          <p class="font-mono text-xs font-semibold text-faint">{counts.get(c.slug) ?? 0} articles</p>
          <h2 class="mt-2 text-lg font-semibold tracking-tight group-hover:text-primary">{c.label}</h2>
          <p class="mt-1 text-sm text-muted">Browse →</p>
        </a>
      ))}
    </div>

    <section class="mt-16" aria-label={t("writing.categories")}>
      <h2 class="mb-6 text-2xl font-bold tracking-tight">All Articles</h2>
      {posts.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2">
          {posts.map((p) => <ArticleCard entry={p} lang={lang} />)}
        </div>
      ) : (
        <p class="rounded-xl border border-dashed border-line p-8 text-center text-sm text-muted">No articles published yet.</p>
      )}
    </section>
  </div>
</Layout>
