---
import { ui, type Language } from "../i18n/ui";
import { courseUrl } from "../lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"courses">;
  lang: Language;
}
const { entry, lang } = Astro.props;
const { data } = entry;
const t = (k: keyof typeof ui.en) => ui[lang][k];
const statusKey = data.status === "open" ? "course.statusOpen" : data.status === "planned" ? "course.statusPlanned" : "course.statusInDevelopment";
---

<article class="relative flex flex-col rounded-xl border border-line bg-paper p-6 transition-shadow hover:shadow-sm">
  <div class="flex items-center justify-between gap-3">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-primary-soft px-2.5 py-0.5 text-xs font-semibold text-primary">
      <span class="h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true"></span>
      {t(statusKey)}
    </span>
    <span class="text-xs font-medium text-faint">{data.difficulty[lang]}</span>
  </div>
  <h3 class="mt-3 text-lg font-semibold tracking-tight">{data.title[lang]}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{data.summary[lang]}</p>
  <div class="mt-4 flex flex-wrap gap-1.5">
    {data.topics.slice(0, 4).map((topic) => (
      <span class="rounded-full bg-soft px-2.5 py-0.5 text-xs font-medium text-muted">{topic}</span>
    ))}
  </div>
  <a href={courseUrl(lang, entry.id)} class="mt-5 inline-flex w-fit items-center gap-1 text-sm font-semibold text-primary hover:text-primary-dark">{t("cta.readMore")} →</a>
</article>
