---
import { readTime, formatDate, categoryLabel, writingUrl } from "../lib/utils";
import { ui, type Language } from "../i18n/ui";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"writing">;
  lang: Language;
}
const { entry, lang } = Astro.props;
const { data } = entry;
const t = (k: keyof typeof ui.en) => ui[lang][k];
---

<article class="relative flex flex-col rounded-xl border border-line bg-paper p-6 transition-shadow hover:shadow-sm">
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium text-faint">
    <a href={`${lang === "en" ? "" : "/id"}/writing/${data.category}`} class="rounded-full bg-primary-soft px-2.5 py-0.5 font-semibold text-primary">{categoryLabel(data.category, lang)}</a>
    <span aria-hidden="true">·</span>
    <time datetime={data.date.toISOString()}>{formatDate(data.date, lang)}</time>
    <span aria-hidden="true">·</span>
    <span>{readTime(entry.body)} {t("tag.readTime")}</span>
  </div>
  <h3 class="mt-3 text-lg font-semibold leading-snug tracking-tight">
    <a href={writingUrl(lang, data.category, entry.id)} class="after:absolute after:inset-0 hover:text-primary">{data.title}</a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{data.description}</p>
</article>
