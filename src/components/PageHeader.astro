---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<div class="border-b border-line bg-soft">
  <div class="container-site py-14 sm:py-16">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
    {lede && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{lede}</p>}
  </div>
</div>
