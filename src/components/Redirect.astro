---
// Minimal redirect page for moved URLs. Keeps the #fragment (e.g. #b2) when JS runs,
// and falls back to a meta refresh when it does not.
import { site } from "../config/site";

interface Props {
  to: string; // absolute path on this site, e.g. "/teaching/data-science-fundamentals"
}
const { to } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={site.url + to} />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <script is:inline define:vars={{ to }}>location.replace(to + location.hash);</script>
  </head>
  <body>
    <p>This page has moved to <a href={to}>{to}</a>.</p>
  </body>
</html>
