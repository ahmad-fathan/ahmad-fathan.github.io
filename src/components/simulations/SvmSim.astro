      '<div class="sv-formula">' + m("<i>f</i>(<b>x</b>) = <b>w</b> · <b>x</b> + <i>b</i> = <i>w</i><sub>1</sub><i>x</i><sub>1</sub> + <i>w</i><sub>2</sub><i>x</i><sub>2</sub> + <i>b</i>") + "</div>" +
