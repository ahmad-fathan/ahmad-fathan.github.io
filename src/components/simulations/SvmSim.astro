      '<p class="sv-lead">Sometimes the groups are arranged so that <b>no straight line</b> can split them. SVM does not bend the line. It changes the space instead.</p>' +
      '<div class="sv-grid2"><div><p class="sv-text">Here every point has only <b>one</b> feature, ' + m("<i>x</i>") + ". The " + BLUE + " points sit in the middle and the " + ORANGE +
      " points on both ends. One cut cannot split orange | blue | orange.</p>" +
      '<p class="sv-text">Now add a second feature, ' + m("<i>x</i><sup>2</sup>") + ". Move the slider to lift every point by its square. Points near zero stay low, points far from zero rise high, and a flat line can separate them.</p>" +
      '<div class="sv-sliders" id="k1-s"></div>' +
      '<p class="sv-text sv-mt">A ' + term("kernel", "kernel") + " does this lifting for us, without ever building the new features. It only measures how similar two points are, as if they lived in the bigger space. The most popular one, the <b>RBF kernel</b>, can draw almost any curved boundary.</p></div>" +
      '<div class="sv-plot" id="k1-plot"></div></div>' +
      plain("Lift the data into a space with extra features, cut it there with a flat line, and the cut becomes a curve back in the original space. Kernels do the lifting for free.") +
      check("What does a kernel let SVM do?", [
        { t: "Draw curved boundaries, while the math still uses a flat cut", ok: true, why: "The cut is flat in the lifted space, which looks curved in the original space." },
        { t: "Skip the training step", ok: false, why: "SVM still trains; the kernel only changes how similarity is measured." },
        { t: "Remove the outliers", ok: false, why: "That is not what a kernel does. Outliers are handled by the soft margin." },
      ]);
    var s = slider($("#k1-s", el), "k1-lift", "Lift by x²", 0, 100, 1, 0, drawK1, function (v) { return v + "%"; });
    function drawK1() {
      var t = s.get() / 100, pts = X1D.map(function (x) { return [x, t * x * x, cls1D(x)]; });
      $("#k1-plot", el).innerHTML = plot({ pts: pts, dom: [-4.2, 4.2, -1, 14], xl: "x", yl: t > 0 ? "x² (new feature)" : " ", ticks: true,
        hlines: t > 0.98 ? [{ y: THR }] : [], streets: [], label: "One-feature data lifted by x squared" }) +
        (t > 0.98 ? '<p class="sv-small">The flat line at x² = ' + fmt(THR, 1) + " separates the groups. Back on the x-axis it means: blue if −" + fmt(Math.sqrt(THR), 2) + " &lt; x &lt; " + fmt(Math.sqrt(THR), 2) + ".</p>" :
          '<p class="sv-small">Drag the slider to 100%.</p>');
    }
