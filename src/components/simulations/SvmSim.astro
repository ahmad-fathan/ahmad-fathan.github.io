      '<p class="sv-lead">Turn and slide the boundary. Try to keep every point on its own side and make the street as wide as you can. Then compare with SVM.</p>' +
      '<div class="sv-grid2 sv-solver"><div class="sv-plot" id="b1-plot"></div><div class="sv-card">' +
      '<div class="sv-sliders" id="b1-s"></div><div class="sv-read" id="b1-read"></div>' +
      '<div class="sv-row"><button type="button" class="sv-btn sv-primary" id="b1-show">Show SVM\'s answer</button><button type="button" class="sv-btn" id="b1-reset">Reset</button></div>' +
      '<div id="b1-msg" class="sv-mt"></div></div></div>' +
      plain("Your street is as wide as twice the distance from the line to the nearest point. Only a few points (the circled ones) limit it. Those are the support vectors.");
    var c = $("#b1-s", el);
    b1.ang = slider(c, "b1-ang", "Turn the line", 0, 180, 1, 75, drawB1, function (v) { return v + "°"; });
    b1.pos = slider(c, "b1-pos", "Slide the line", -40, 40, 1, 0, drawB1, function (v) { return v > 0 ? "+" + v : v; });
    b1.show = false;
    $("#b1-show", el).addEventListener("click", function () { b1.show = !b1.show; drawB1(); });
    $("#b1-reset", el).addEventListener("click", function () { b1.ang.set(75); b1.pos.set(0); b1.show = false; drawB1(); });
    drawB1();
  });
  function drawB1() {
    var th = (b1.ang.get() + 90) * Math.PI / 180, n = [Math.cos(th), Math.sin(th)];
    var mean = [5, 5.2], c = dot(n, mean) + b1.pos.get() / 10;
    // orient so that orange points are on the positive side on average
    var so = P1.reduce(function (s, p) { return s + p[2] * (dot(n, p) - c); }, 0);
    if (so < 0) { n = [-n[0], -n[1]]; c = -c; }
    var wrong = [], dmin = Infinity, near = [];
    P1.forEach(function (p, i) { var d = p[2] * (dot(n, p) - c); if (d <= 0) wrong.push(i); dmin = Math.min(dmin, Math.abs(dot(n, p) - c)); });
    P1.forEach(function (p, i) { if (Math.abs(Math.abs(dot(n, p) - c) - dmin) < 1e-6) near.push(i); });
    var ok = wrong.length === 0, streets = [], rings = [];
    if (ok) { streets.push({ n: n, c: c, half: dmin }); rings = near; }
    if (b1.show) streets.push(bestStreet(BEST1, { fill: "none", edge: "var(--sv-good)" }));
    var lines = [{ n: n, c: c, color: ok ? "var(--sv-ink)" : "var(--sv-bad)" }];
    if (b1.show) lines.push({ n: BEST1.n, c: BEST1.c, color: "var(--sv-good)", dash: "8 5" });
    $("#b1-plot").innerHTML = plot({ pts: P1, streets: streets, lines: lines, rings: ok ? rings : wrong, ringColor: ok ? "var(--sv-ink)" : "var(--sv-bad)", label: "Your boundary and street" }) + legend();
    var mine = ok ? 2 * dmin : 0, best = 2 * BEST1.half;
    $("#b1-read").innerHTML = '<div class="' + (ok ? "good" : "bad") + '">Points on the wrong side<b>' + wrong.length + "</b></div>" +
      "<div>Your street width<b>" + (ok ? fmt(mine) : "–") + "</b></div>" + (b1.show ? '<div class="good">SVM\'s widest street<b>' + fmt(best) + "</b></div>" : "");
    var msg;
    if (!ok) msg = '<div class="sv-callout warn">The red-circled points are on the wrong side. A street only exists when every point is on its own side.</div>';
    else if (mine > best - 0.02) msg = '<div class="sv-callout ok">Excellent! Your street is as wide as SVM\'s. That is the widest possible street.</div>';
    else msg = '<div class="sv-callout">Your street is ' + fmt(mine / best * 100, 0) + "% as wide as the widest one. Watch the circled points: they block your street. Turn and slide to push them farther away.</div>";
    if (b1.show) msg += '<p class="sv-small sv-mt">Green dashed street: SVM\'s answer. It touches ' + BEST1.sv.length + " support vectors and is " + fmt(best) + " wide.</p>";
    $("#b1-msg").innerHTML = msg;
  }

  // ---------------------------------------------------------------- B2 worked example (stepper)
  var b2 = { step: 0 };
  var SVE = BESTE.sv.map(function (i) { return PE[i]; });
  function solve3(rows) { // rows: [a1, a2, a3, rhs] for unknowns (w1, w2, b)
    function det(a) { return a[0][0] * (a[1][1] * a[2][2] - a[1][2] * a[2][1]) - a[0][1] * (a[1][0] * a[2][2] - a[1][2] * a[2][0]) + a[0][2] * (a[1][0] * a[2][1] - a[1][1] * a[2][0]); }
    var A = rows.map(function (r) { return r.slice(0, 3); }), D = det(A), out = [];
    for (var k = 0; k < 3; k++) out.push(det(A.map(function (r, i) { var c = r.slice(); c[k] = rows[i][3]; return c; })) / D);
    return out;
  }
  var SOL = solve3(SVE.map(function (p) { return [p[0], p[1], 1, p[2]]; }));
  var Wx = SOL[0], Wy = SOL[1], Bb = SOL[2], NW = Math.hypot(Wx, Wy);
  var PNEW = [[4, 0, "P"], [1.5, 2, "Q"]];
  function fE(p) { return Wx * p[0] + Wy * p[1] + Bb; }
  function sgn(v) { return v < 0 ? "−" : "+"; }
  function eqText(p) { return m("<i>w</i><sub>1</sub>·(" + fmt(p[0]) + ") + <i>w</i><sub>2</sub>·(" + fmt(p[1]) + ") + <i>b</i> = " + (p[2] > 0 ? "+1" : "−1")); }
  var B2STEPS = [
    { t: "The data", body: function () {
      return '<p class="sv-text">Eight points. Four are ' + ORANGE + " (+1) and four are " + BLUE + " (−1).</p>" +
        '<div class="sv-scroll"><table class="sv-table"><thead><tr><th>Point</th><th>x₁</th><th>x₂</th><th>Group</th></tr></thead><tbody>' +
        PE.map(function (p, i) { return "<tr><td>" + (i + 1) + "</td><td>" + fmt(p[0]) + "</td><td>" + fmt(p[1]) + '</td><td class="' + (p[2] > 0 ? "lab-no" : "lab-yes") + '">' + (p[2] > 0 ? "+1" : "−1") + "</td></tr>"; }).join("") + "</tbody></table></div>";
    } },
    { t: "Find the support vectors", body: function () {
      return '<p class="sv-text">Look for the points closest to the gap between the groups. They will touch the edges of the widest street:</p>' +
        '<p class="sv-text">' + SVE.map(function (p) { return pill("(" + fmt(p[0]) + ", " + fmt(p[1]) + ") " + (p[2] > 0 ? "+1" : "−1")); }).join(" ") + "</p>" +
        '<p class="sv-small">All other points are farther away, so they do not affect the street.</p>';
    } },
    { t: "One equation per support vector", body: function () {
      return '<p class="sv-text">A support vector sits exactly on an edge, so its score is exactly +1 (orange) or −1 (blue). With ' + m("<i>f</i>(<b>x</b>) = <i>w</i><sub>1</sub><i>x</i><sub>1</sub> + <i>w</i><sub>2</sub><i>x</i><sub>2</sub> + <i>b</i>") + ":</p>" +
        '<div class="sv-calc">' + SVE.map(function (p, i) { return '<div class="sv-calcrow ' + (p[2] > 0 ? "no" : "yes") + '"><span class="lbl">Equation ' + (i + 1) + "</span>" + eqText(p) + "</div>"; }).join("") + "</div>";
    } },
    { t: "Solve the equations", body: function () {
      return '<p class="sv-text">Three equations, three unknowns. Combining them (for example, subtracting one equation from another to cancel <i>b</i>) gives:</p>' +
        '<div class="sv-formula">' + m("<i>w</i><sub>1</sub> = " + fmt(Wx) + ", &nbsp; <i>w</i><sub>2</sub> = " + fmt(Wy) + ", &nbsp; <i>b</i> = " + fmt(Bb)) + "</div>" +
        '<p class="sv-text">So the score is ' + m("<i>f</i>(<b>x</b>) = " + (Math.abs(Wx) > 1e-9 ? fmt(Wx) + "·<i>x</i><sub>1</sub> " : "") + (Math.abs(Wy) > 1e-9 ? sgn(Wy) + " " + fmt(Math.abs(Wy)) + "·<i>x</i><sub>2</sub> " : "") + sgn(Bb) + " " + fmt(Math.abs(Bb))) + ".</p>" +
        '<p class="sv-small">Check: plug each support vector back in. You get exactly +1 or −1.</p>';
    } },
    { t: "The boundary and the street", body: function () {
      return '<p class="sv-text">The boundary is where the score is 0. Here that is the vertical line ' + m("<i>x</i><sub>1</sub> = " + fmt(-Bb / Wx)) + ".</p>" +
        '<div class="sv-formula">' + m("margin = " + frac("2", "‖<b>w</b>‖") + " = " + frac("2", "√(" + fmt(Wx) + "² + " + fmt(Wy) + "²)") + " = " + frac("2", fmt(NW)) + " = <b>" + fmt(2 / NW) + "</b>") + "</div>" +
        '<p class="sv-text">The street runs from ' + m("<i>x</i><sub>1</sub> = " + fmt((-1 - Bb) / Wx)) + " to " + m("<i>x</i><sub>1</sub> = " + fmt((1 - Bb) / Wx)) + ", exactly where the support vectors are.</p>";
    } },
    { t: "Classify point P", body: function () {
      var p = PNEW[0], f = fE(p);
      return '<p class="sv-text">A new point ' + m("P = (" + fmt(p[0]) + ", " + fmt(p[1]) + ")") + " arrives.</p>" +
        '<div class="sv-formula">' + m("<i>f</i>(P) = " + fmt(Wx) + "·" + fmt(p[0]) + " + " + fmt(Wy) + "·" + fmt(p[1]) + " " + sgn(Bb) + " " + fmt(Math.abs(Bb)) + " = <b>" + fmt(f) + "</b>") + "</div>" +
        '<div class="sv-verdict">' + (f > 0 ? "Positive, so P is orange (+1)." : "Negative, so P is blue (−1).") + "</div>" +
        '<p class="sv-small sv-mt">' + (Math.abs(f) >= 1 ? "The score is beyond ±1, so P is outside the street: a confident answer." : "The score is between −1 and +1, so P is inside the street.") + "</p>";
    } },
    { t: "Classify point Q", body: function () {
      var p = PNEW[1], f = fE(p);
      return '<p class="sv-text">Another point ' + m("Q = (" + fmt(p[0]) + ", " + fmt(p[1]) + ")") + " arrives.</p>" +
        '<div class="sv-formula">' + m("<i>f</i>(Q) = " + fmt(Wx) + "·" + fmt(p[0]) + " + " + fmt(Wy) + "·" + fmt(p[1]) + " " + sgn(Bb) + " " + fmt(Math.abs(Bb)) + " = <b>" + fmt(f) + "</b>") + "</div>" +
        '<div class="sv-verdict">' + (f > 0 ? "Positive, so Q is orange (+1)." : "Negative, so Q is blue (−1).") + "</div>" +
        '<div class="sv-callout' + (Math.abs(f) < 1 ? " warn" : "") + '">' + (Math.abs(f) < 1 ? "But the score is between −1 and +1: Q is <b>inside</b> the street, so SVM is less sure about it." : "Q is outside the street.") + "</div>";
    } },
  ];
  page("b2", "B", "Example 2: Calculate an SVM by hand", function (el) {
    el.innerHTML =
      '<div class="sv-eyebrow">Part B · Example 2 of 4</div><h2 class="sv-h2">Example 2: Calculate an SVM by hand</h2>' +
      '<p class="sv-lead">A small data set that you can solve with pen and paper. Step through it, or use the arrow keys.</p>' +
      '<div class="sv-grid2 sv-solver"><div class="sv-plot" id="b2-plot"></div><div class="sv-card sv-stepcard"><span class="sv-stepchip" id="b2-chip"></span><h3 class="sv-h3" id="b2-title"></h3><div id="b2-body"></div>' +
      '<div class="sv-controls"><button type="button" class="sv-btn" id="b2-prev">← Back</button><button type="button" class="sv-btn sv-primary" id="b2-next">Next step →</button><div class="sv-dots" id="b2-dots"></div></div></div></div>';
    $("#b2-dots", el).innerHTML = B2STEPS.map(function (s, i) { return '<button type="button" class="sv-dot" data-s="' + i + '" aria-label="' + s.t + '">' + (i + 1) + "</button>"; }).join("");
    $$("#b2-dots .sv-dot", el).forEach(function (b) { b.addEventListener("click", function () { b2.step = +b.getAttribute("data-s"); drawB2(); }); });
    $("#b2-prev", el).addEventListener("click", function () { goB2(-1); });
    $("#b2-next", el).addEventListener("click", function () { goB2(1); });
    drawB2();
  });
  function goB2(d) { b2.step = Math.max(0, Math.min(B2STEPS.length - 1, b2.step + d)); drawB2(); }
  function drawB2() {
    var s = b2.step, st = B2STEPS[s];
    $("#b2-chip").textContent = "Step " + (s + 1) + " of " + B2STEPS.length;
    $("#b2-title").textContent = st.t;
    $("#b2-body").innerHTML = st.body();
    var n = [Wx / NW, Wy / NW], c = -Bb / NW;
    $("#b2-plot").innerHTML = plot({ pts: PE, dom: [-1.8, 7, -2.6, 3.4], ticks: true, labels: s === 0, r: 7, xl: "x₁", yl: "x₂",
      rings: s >= 1 ? BESTE.sv : [], ringColor: "var(--sv-good)",
      streets: s >= 4 ? [{ n: n, c: c, half: 1 / NW }] : [], lines: s >= 4 ? [{ n: n, c: c }] : [],
      stars: s >= 6 ? [PNEW[0], PNEW[1]] : s >= 5 ? [PNEW[0]] : [], label: "Worked example data" }) + legend();
    $$("#b2-dots .sv-dot").forEach(function (b, i) { if (i === s) b.setAttribute("aria-current", "step"); else b.removeAttribute("aria-current"); b.classList.toggle("done", i < s); });
    $("#b2-prev").disabled = s === 0; $("#b2-next").disabled = s === B2STEPS.length - 1;
  }

  // ---------------------------------------------------------------- B3 soft margin dial
  var b3 = { cache: {} };
  var PSX = PS.map(function (p) { return [p[0], p[1]]; }), PSY = PS.map(function (p) { return p[2]; });
  function cOf(v) { return Math.pow(10, v / 10); }
  page("b3", "B", "Example 3: Turn the C dial", function (el) {
    el.innerHTML =
      '<div class="sv-eyebrow">Part B · Example 3 of 4</div><h2 class="sv-h2">Example 3: Turn the C dial</h2>' +
      '<p class="sv-lead">These two groups overlap, and one blue point sits deep in orange territory. Move the slider and watch how the street reacts to the price of mistakes, ' + term("C", "C") + ".</p>" +
      '<div class="sv-grid2 sv-solver"><div class="sv-plot" id="b3-plot"></div><div class="sv-card"><div class="sv-sliders" id="b3-s"></div><div class="sv-read" id="b3-read"></div><div id="b3-msg"></div></div></div>' +
      plain("Small C: a wide, relaxed street that ignores a few odd points. Large C: a narrow, strict street that tries to keep every point out. Neither is always best; we check on validation data.");
    b3.c = slider($("#b3-s", el), "b3-c", "Price of a mistake (C)", -20, 20, 1, -12, drawB3, function (v) { var C = cOf(v); return C < 1 ? fmt(C, 2) : fmt(C, C < 10 ? 1 : 0); });
    drawB3();
  });
  function drawB3() {
    var v = b3.c.get();
    if (!b3.cache[v]) b3.cache[v] = trainSVM(PSX, PSY, cOf(v), 600);
    var md = b3.cache[v], nw = Math.hypot(md.w[0], md.w[1]), n = [md.w[0] / nw, md.w[1] / nw];
    var svIdx = []; md.alpha.forEach(function (a, i) { if (a > 1e-6) svIdx.push(i); });
    $("#b3-plot").innerHTML = plot({ pts: PS, r: 5.5, streets: [{ n: n, c: -md.b / nw, half: 1 / nw }], lines: [{ n: n, c: -md.b / nw }], rings: svIdx, label: "Soft margin street" }) + legend();
    $("#b3-read").innerHTML = "<div>Street width<b>" + fmt(md.width) + "</b></div><div>Support vectors<b>" + md.nsv + "</b></div><div>Training mistakes<b>" + md.wrong + "</b></div>";
    var C = cOf(v);
    $("#b3-msg").innerHTML = C < 0.3 ? '<div class="sv-callout">Mistakes are cheap: the street is wide and many points touch or enter it (all circled points are support vectors).</div>' :
      C > 10 ? '<div class="sv-callout warn">Mistakes are expensive: the street is narrow and only a few points still touch it. With noisy data this risks overfitting.</div>' :
      '<div class="sv-callout ok">A middle value: a fair balance between a wide street and few mistakes.</div>';
  }

  // ---------------------------------------------------------------- B4 ring + lifted feature
  var b4 = { lift: false };
  var PRX = PR.map(function (p) { return [p[0], p[1]]; }), PRY = PR.map(function (p) { return p[2]; });
  var M_LIN = trainSVM(PRX, PRY, 1, 800);
  var M_LIFT = trainSVM(PRX.map(function (x) { return [x[0], x[1], x[0] * x[0] + x[1] * x[1]]; }), PRY, 10, 1500);
  function accOf(fn) { return PR.filter(function (p) { return p[2] * fn(p[0], p[1]) > 0; }).length / PR.length; }
  var ACC_LIN = accOf(function (a, b) { return M_LIN.f([a, b]); }), ACC_LIFT = accOf(function (a, b) { return M_LIFT.f([a, b, a * a + b * b]); });
  page("b4", "B", "Example 4: A ring of points", function (el) {
    el.innerHTML =
      '<div class="sv-eyebrow">Part B · Example 4 of 4</div><h2 class="sv-h2">Example 4: A ring of points</h2>' +
      '<p class="sv-lead">The blue points sit in the middle, surrounded by a ring of orange points. Train an SVM with and without an extra feature, and compare.</p>' +
      '<div class="sv-row"><label class="sv-switch"><input type="checkbox" id="b4-lift"> Add the feature <b>&nbsp;distance² = x₁² + x₂²</b></label></div>' +
      '<div class="sv-grid2 sv-mt"><div><div class="sv-h3">What the SVM draws</div><div class="sv-plot" id="b4-plot"></div></div><div><div class="sv-h3">The new feature on its own</div><div class="sv-plot" id="b4-side"></div><div id="b4-msg"></div></div></div>' +
      plain("With the extra feature, the SVM still draws a flat cut, but in a space with three features. Seen in the original two features, that flat cut is a circle. A kernel gets this effect automatically.");
    $("#b4-lift", el).addEventListener("change", function (e) { b4.lift = e.target.checked; drawB4(); });
    drawB4();
  });
  function drawB4() {
    var fn = b4.lift ? function (a, b) { return M_LIFT.f([a, b, a * a + b * b]); } : function (a, b) { return M_LIN.f([a, b]); };
    $("#b4-plot").innerHTML = plot({ pts: PR, r: 4.5, dom: [-1.3, 1.3, -1.3, 1.3], regions: fn, xl: "x₁", yl: "x₂", label: "SVM regions on ring data" }) + legend();
    var inner = PR.filter(function (p) { return p[2] < 0; }).map(function (p) { return p[0] * p[0] + p[1] * p[1]; });
    var outer = PR.filter(function (p) { return p[2] > 0; }).map(function (p) { return p[0] * p[0] + p[1] * p[1]; });
    var thr = (Math.max.apply(null, inner) + Math.min.apply(null, outer)) / 2;
    var side = PR.map(function (p) { return [p[0], p[0] * p[0] + p[1] * p[1], p[2]]; });
    $("#b4-side").innerHTML = plot({ pts: side, r: 4.5, dom: [-1.3, 1.3, -0.05, 1.3], xl: "x₁", yl: "x₁² + x₂²", hlines: b4.lift ? [{ y: thr, dash: "6 4" }] : [], fade: function () { return !b4.lift; }, label: "Distance squared from the center" });
    $("#b4-msg").innerHTML = (b4.lift ?
      '<div class="sv-callout ok">Training accuracy: <b>' + fmt(ACC_LIFT * 100, 0) + "%</b>. On the new feature alone, one flat cut separates the groups, so the SVM can draw a circle.</div>" :
      '<div class="sv-callout warn">Training accuracy: <b>' + fmt(ACC_LIN * 100, 0) + "%</b>. A straight line cannot surround the blue points. Tick the box above to add the new feature.</div>");
  }

  // ---------------------------------------------------------------- C1 practice
  var qz = { right: 0, total: 0, cur: null };
  function rnd(a) { return a[Math.floor(Math.random() * a.length)]; }
  function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
  page("c1", "C", "Practice", function (el) {
    el.innerHTML =
      '<div class="sv-eyebrow">Part C · Practice</div><h2 class="sv-h2">Try it yourself</h2>' +
      '<p class="sv-lead">A random SVM model and a random point are picked. Answer three short questions. If you get stuck, press <b>Hint</b>.</p>' +
      '<div class="sv-card sv-mt"><div class="sv-quizhead"><div id="qz-query"></div><div class="sv-score" id="qz-score"></div></div><div id="qz-body"></div>' +
      '<div class="sv-controls"><button type="button" class="sv-btn sv-primary" id="qz-new">New question</button></div></div>';
    $("#qz-new", el).addEventListener("click", newQuestion);
    newQuestion();
  });
  function newQuestion() {
    var w1, w2, b, x1, x2, f;
    do {
      w1 = rnd([-2, -1, 1, 2, 3]); w2 = rnd([-2, -1, 0, 1, 2]); b = rnd([-3, -2, -1, 1, 2, 3]);
      x1 = rnd([-3, -2, -1, 0, 1, 2, 3]); x2 = rnd([-3, -2, -1, 1, 2, 3]);
      f = w1 * x1 + w2 * x2 + b;
    } while (f === 0);
    var wrongs = [w1 * x1 + w2 * x2, w1 * x1 - w2 * x2 + b, -f, w1 + x1 + w2 + x2 + b].filter(function (v) { return v !== f; });
    var opts1 = [f];
    wrongs.forEach(function (v) { if (opts1.indexOf(v) < 0 && opts1.length < 4) opts1.push(v); });
    var nw = Math.sqrt(w1 * w1 + w2 * w2), mg = 2 / nw;
    var opts3 = [fmt(mg), fmt(1 / nw), fmt(2 * nw), fmt(2 / (w1 * w1 + w2 * w2))].filter(function (v, i, a) { return a.indexOf(v) === i; });
    qz.cur = { w1: w1, w2: w2, b: b, x1: x1, x2: x2, f: f, opts1: shuffle(opts1), mg: fmt(mg), opts3: shuffle(opts3), a1: null, a2: null, a3: null, h: {} };
    renderQuiz();
  }
  function fs(v) { return v < 0 ? "(" + fmt(v) + ")" : fmt(v); }
  function renderQuiz() {
    var k = qz.cur, cls = k.f > 0 ? 1 : -1;
    $("#qz-query").innerHTML = "<b>Model:</b> " + pill(m("<b>w</b> = (" + fmt(k.w1) + ", " + fmt(k.w2) + ")")) + " " + pill(m("<i>b</i> = " + fmt(k.b))) + " &nbsp; <b>Point:</b> " + pill(m("<b>x</b> = (" + fmt(k.x1) + ", " + fmt(k.x2) + ")"));
    $("#qz-score").textContent = "Score: " + qz.right + " / " + qz.total;
    var h = '<div class="sv-q"><b>Question 1.</b> What is the score ' + m("<i>f</i>(<b>x</b>) = <i>w</i><sub>1</sub><i>x</i><sub>1</sub> + <i>w</i><sub>2</sub><i>x</i><sub>2</sub> + <i>b</i>") + "?" +
      '<div class="sv-opts" style="margin-top:.45rem">' + k.opts1.map(function (o) {
        var st = k.a1 != null ? (o === k.f ? " right" : o === k.a1 ? " wrong" : "") : "";
        return '<button type="button" class="sv-btn sv-opt' + st + '" data-a1="' + o + '"' + (k.a1 != null ? " disabled" : "") + ">" + fmt(o) + "</button>";
      }).join("") + (k.a1 != null ? "" : '<button type="button" class="sv-btn sv-ghost" data-hint="1">Hint</button>') + "</div>";
    if (k.h[1] && k.a1 == null) h += '<div class="sv-hint">Multiply each weight by the matching feature, add the two results, then add <i>b</i>. Watch the minus signs.</div>';
    if (k.a1 != null) h += '<div class="sv-fb ' + (k.a1 === k.f ? "ok" : "no") + '">' + m(fmt(k.w1) + "·" + fs(k.x1) + " + " + fmt(k.w2) + "·" + fs(k.x2) + " + " + fs(k.b) + " = " + fmt(k.w1 * k.x1) + " + " + fs(k.w2 * k.x2) + " + " + fs(k.b) + " = <b>" + fmt(k.f) + "</b>") + "</div>";
    h += "</div>";
    if (k.a1 != null) {
      h += '<div class="sv-q"><b>Question 2.</b> Which group does SVM predict, and is the point outside the street?<div class="sv-opts" style="margin-top:.45rem">';
      var o2 = [["+1, outside the street", 1, true], ["+1, inside the street", 1, false], ["−1, outside the street", -1, true], ["−1, inside the street", -1, false]];
      var good2 = o2.filter(function (o) { return o[1] === cls && o[2] === (Math.abs(k.f) >= 1); })[0][0];
      h += o2.map(function (o) {
        var st = k.a2 ? (o[0] === good2 ? " right" : o[0] === k.a2 ? " wrong" : "") : "";
        return '<button type="button" class="sv-btn sv-opt' + st + '" data-a2="' + o[0] + '"' + (k.a2 ? " disabled" : "") + ">" + o[0] + "</button>";
      }).join("") + (k.a2 ? "" : '<button type="button" class="sv-btn sv-ghost" data-hint="2">Hint</button>') + "</div>";
      if (k.h[2] && !k.a2) h += '<div class="sv-hint">Positive score: +1. Negative score: −1. If the score is between −1 and +1, the point is inside the street.</div>';
      if (k.a2) h += '<div class="sv-fb ' + (k.a2 === good2 ? "ok" : "no") + '">The score ' + fmt(k.f) + " is " + (k.f > 0 ? "positive" : "negative") + ", so the class is " + (cls > 0 ? "+1" : "−1") + ". " +
        (Math.abs(k.f) >= 1 ? "Its size is at least 1, so the point is outside the street." : "Its size is below 1, so the point is inside the street.") + "</div>";
      h += "</div>";
      qz.good2 = good2;
    }
    if (k.a2) {
      h += '<div class="sv-q"><b>Question 3.</b> How wide is this model\'s street? ' + m("margin = 2 / ‖<b>w</b>‖") + '<div class="sv-opts" style="margin-top:.45rem">' +
        k.opts3.map(function (o) {
          var st = k.a3 ? (o === k.mg ? " right" : o === k.a3 ? " wrong" : "") : "";
          return '<button type="button" class="sv-btn sv-opt' + st + '" data-a3="' + o + '"' + (k.a3 ? " disabled" : "") + ">" + o + "</button>";
        }).join("") + (k.a3 ? "" : '<button type="button" class="sv-btn sv-ghost" data-hint="3">Hint</button>') + "</div>";
      if (k.h[3] && !k.a3) h += '<div class="sv-hint">First find the length ‖w‖ = √(w₁² + w₂²). Then divide 2 by it.</div>';
      if (k.a3) h += '<div class="sv-fb ' + (k.a3 === k.mg ? "ok" : "no") + '">' + m("‖<b>w</b>‖ = √(" + fs(k.w1) + "² + " + fs(k.w2) + "²) = √" + (k.w1 * k.w1 + k.w2 * k.w2) + " ≈ " + fmt(Math.sqrt(k.w1 * k.w1 + k.w2 * k.w2)) + ", so margin = 2 / " + fmt(Math.sqrt(k.w1 * k.w1 + k.w2 * k.w2)) + " ≈ <b>" + k.mg + "</b>") + "</div>";
      h += "</div>";
    }
    $("#qz-body").innerHTML = h;
    $$("#qz-body [data-hint]").forEach(function (b) { b.addEventListener("click", function () { k.h[b.getAttribute("data-hint")] = true; renderQuiz(); }); });
    $$("#qz-body [data-a1]").forEach(function (b) { b.addEventListener("click", function () { if (k.a1 != null) return; k.a1 = +b.getAttribute("data-a1"); qz.total++; if (k.a1 === k.f) qz.right++; renderQuiz(); }); });
    $$("#qz-body [data-a2]").forEach(function (b) { b.addEventListener("click", function () { if (k.a2) return; k.a2 = b.getAttribute("data-a2"); qz.total++; if (k.a2 === qz.good2) qz.right++; renderQuiz(); }); });
    $$("#qz-body [data-a3]").forEach(function (b) { b.addEventListener("click", function () { if (k.a3) return; k.a3 = b.getAttribute("data-a3"); qz.total++; if (k.a3 === k.mg) qz.right++; renderQuiz(); }); });
  }

  // ================================================================ navigation
  var holder = $("#sv-pages"), cur = 0, visited = {};
  PAGES.forEach(function (p) {
    var sec = document.createElement("section");
    sec.className = "sv-page"; sec.id = "sv-" + p.id; sec.hidden = true; sec.setAttribute("aria-label", p.title);
    holder.appendChild(sec);
    p.el = sec;
    p.build(sec);
  });
  var prog = $("#sv-progress");
  prog.innerHTML = PARTS.map(function (pt) {
    var n = 0;
    return '<div class="sv-part" data-part="' + pt.id + '"><span class="sv-partlabel">' + pt.label + '</span><div class="sv-chaps">' +
      PAGES.map(function (p, i) {
        if (p.part !== pt.id) return "";
        n++;
        return '<button type="button" class="sv-chap" data-i="' + i + '" title="' + p.title.replace(/"/g, "&quot;") + '" aria-label="' + p.title.replace(/"/g, "&quot;") + '">' + n + "</button>";
      }).join("") + "</div></div>";
  }).join("");
  $$(".sv-chap").forEach(function (b) { b.addEventListener("click", function () { show(+b.getAttribute("data-i"), true); }); });
  $("#sv-prev").addEventListener("click", function () { show(cur - 1, true); });
  $("#sv-next").addEventListener("click", function () { show(cur + 1, true); });
  function show(i, scroll) {
    if (i < 0 || i >= PAGES.length) return;
    hidePop();
    cur = i; visited[i] = true;
    PAGES.forEach(function (p, j) { p.el.hidden = j !== i; });
    $$(".sv-chap").forEach(function (b) {
      var j = +b.getAttribute("data-i");
      if (j === i) b.setAttribute("aria-current", "page"); else b.removeAttribute("aria-current");
      b.classList.toggle("done", !!visited[j] && j !== i);
    });
    $$(".sv-part").forEach(function (p) { p.classList.toggle("on", p.getAttribute("data-part") === PAGES[i].part); });
    $("#sv-progress-fill").style.width = ((i + 1) / PAGES.length * 100) + "%";
    var prev = $("#sv-prev"), next = $("#sv-next");
    prev.hidden = i === 0; next.hidden = i === PAGES.length - 1;
    if (i > 0) prev.textContent = "← " + PAGES[i - 1].title;
    if (i < PAGES.length - 1) next.textContent = "Next: " + PAGES[i + 1].title + " →";
    if (PAGES[i].onShow) PAGES[i].onShow();
    try { history.replaceState(null, "", "#" + PAGES[i].id); } catch (e) { /* ignore */ }
    if (scroll) root.scrollIntoView({ behavior: "smooth", block: "start" });
  }
  document.addEventListener("keydown", function (e) {
    var tag = (e.target && e.target.tagName) || "";
    if (tag === "INPUT" || tag === "SELECT" || tag === "TEXTAREA") return;
    if (PAGES[cur].id !== "b2") return;
    if (e.key === "ArrowRight") goB2(1);
    if (e.key === "ArrowLeft") goB2(-1);
  });
  var themeBtn = $("#sv-theme");
  themeBtn.addEventListener("click", function () {
    var dark = root.getAttribute("data-theme") !== "dark";
    root.setAttribute("data-theme", dark ? "dark" : "light");
    themeBtn.textContent = dark ? "Light mode" : "Dark mode";
  });
  window.addEventListener("hashchange", function () {
    var id = (location.hash || "").slice(1);
    PAGES.forEach(function (p, i) { if (p.id === id && i !== cur) show(i, true); });
  });
  var start = 0, hh = (location.hash || "").slice(1);
  PAGES.forEach(function (p, i) { if (p.id === hh) start = i; });
  show(start, false);
})();
</script>
