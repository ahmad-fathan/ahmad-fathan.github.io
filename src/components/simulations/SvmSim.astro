    el.innerHTML =
      '<div class="sv-eyebrow">Part A · Theory 1 of 5</div><h2 class="sv-h2">Drawing a line between two groups</h2>' +
      '<p class="sv-lead">' + term("Classification", "classification") + " means deciding which group a new item belongs to. A Support Vector Machine (SVM) does this by drawing a line between the groups.</p>" +
      '<div class="sv-grid2"><div><p class="sv-text">Every point below is one item, described by two ' + term("features", "feature") + ". The " + BLUE + " points belong to one group and the " + ORANGE +
