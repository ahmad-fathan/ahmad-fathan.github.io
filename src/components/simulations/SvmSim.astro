  // ---------------------------------------------------------------- A5
  var X1D = [-3.6, -3.1, -2.7, -2.3, -1.5, -1.0, -0.5, 0.0, 0.4, 0.9, 1.4, 2.2, 2.6, 3.0, 3.5];
  function cls1D(x) { return Math.abs(x) < 1.8 ? -1 : 1; }
  var THR = (function () { // midpoint between the highest blue and the lowest orange value of x^2
    var hiB = Math.max.apply(null, X1D.filter(function (x) { return cls1D(x) < 0; }).map(function (x) { return x * x; }));
    var loO = Math.min.apply(null, X1D.filter(function (x) { return cls1D(x) > 0; }).map(function (x) { return x * x; }));
    return (hiB + loO) / 2;
  })();
  page("a5", "A", "When a straight line is not enough: kernels", function (el) {
