---
// Support Vector Machine interactive simulation, organized as a guided path:
// Part A (theory) -> Part B (worked examples) -> Part C (practice).
// All page content is generated by the inline script below. Every number on
// screen is computed in the browser from the data it holds: the widest street
// is found by a geometric search, the soft-margin and kernel examples are
// trained with a small dual coordinate-descent SVM solver.
---

<div class="svsim" data-theme="light" id="svsim">
  <div class="sv-top">
    <nav class="sv-progress" id="sv-progress" aria-label="Chapters"></nav>
    <button type="button" class="sv-btn sv-ghost sv-sm" id="sv-theme" aria-label="Toggle dark mode">Dark mode</button>
  </div>
  <div class="sv-bar-progress" aria-hidden="true"><span id="sv-progress-fill"></span></div>
  <div id="sv-pages"></div>
  <div class="sv-pagenav">
    <button type="button" class="sv-btn" id="sv-prev"></button>
    <button type="button" class="sv-btn sv-primary" id="sv-next"></button>
  </div>
  <div class="sv-pop" id="sv-pop" role="tooltip" hidden></div>
</div>

<style is:global>
  .svsim {
    --sv-bg: #ffffff;
    --sv-card: #ffffff;
    --sv-soft: #f8fafc;
    --sv-ink: #0f172a;
    --sv-muted: #5b6573;
    --sv-line: #e2e8f0;
    --sv-primary: #2563eb;
    --sv-primary-soft: #eff6ff;
    --sv-yes: #2563eb;
    --sv-yes-soft: #dbeafe;
    --sv-no: #d97706;
    --sv-no-soft: #fff7ed;
    --sv-hl: #fef9c3;
    --sv-bad: #dc2626;
    --sv-bad-soft: #fef2f2;
    --sv-good: #16a34a;
    --sv-good-soft: #f0fdf4;
    --sv-purple: #7c3aed;
    --sv-teal: #0d9488;
    position: relative;
    background: var(--sv-bg);
    color: var(--sv-ink);
    border-radius: 0.9rem;
    font-size: 1rem;
    line-height: 1.65;
  }
  .svsim[data-theme="dark"] {
    --sv-bg: #0b1220;
    --sv-card: #111a2e;
    --sv-soft: #16213a;
    --sv-ink: #e5e9f0;
    --sv-muted: #9aa6b8;
    --sv-line: #26324a;
    --sv-primary: #60a5fa;
    --sv-primary-soft: #172554;
    --sv-yes: #60a5fa;
    --sv-yes-soft: #172554;
    --sv-no: #fbbf24;
    --sv-no-soft: #2a2110;
    --sv-hl: #3a3410;
    --sv-bad: #f87171;
    --sv-bad-soft: #2a1414;
    --sv-good: #4ade80;
    --sv-good-soft: #10261a;
    --sv-purple: #a78bfa;
    --sv-teal: #2dd4bf;
    padding: 1rem;
  }
  .svsim * { box-sizing: border-box; }
  .svsim p { margin: 0 0 0.75rem; }
  .svsim { scroll-margin-top: 5.5rem; }
  .svsim ul.sv-text { list-style: disc; padding-left: 1.4rem; margin: 0 0 0.9rem; }
  .svsim ul.sv-text li { margin: 0.15rem 0; }
  .svsim ul.sv-text li::marker { color: var(--sv-primary); }

  /* ---- progress navigation ---- */
  .svsim .sv-top { display: flex; gap: 0.75rem; align-items: flex-start; justify-content: space-between; }
  .svsim .sv-progress { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; }
  .svsim .sv-part { display: flex; flex-direction: column; gap: 0.3rem; }
  .svsim .sv-partlabel { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sv-muted); }
  .svsim .sv-part.on .sv-partlabel { color: var(--sv-primary); }
  .svsim .sv-chaps { display: flex; gap: 0.3rem; }
  .svsim .sv-chap { width: 2rem; height: 2rem; border-radius: 999px; border: 1px solid var(--sv-line); background: var(--sv-card); color: var(--sv-muted); font-size: 0.8rem; font-weight: 700; cursor: pointer; }
  .svsim .sv-chap.done { border-color: var(--sv-primary); color: var(--sv-primary); }
  .svsim .sv-chap[aria-current="page"] { background: var(--sv-primary); border-color: var(--sv-primary); color: #fff; }
  .svsim[data-theme="dark"] .sv-chap[aria-current="page"] { color: #0b1220; }
  .svsim .sv-bar-progress { height: 4px; background: var(--sv-line); border-radius: 999px; margin: 0.9rem 0 1.4rem; overflow: hidden; }
  .svsim .sv-bar-progress span { display: block; height: 100%; background: var(--sv-primary); width: 0; transition: width 0.3s ease; }

  /* ---- page ---- */
  .svsim .sv-eyebrow { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sv-primary); margin-bottom: 0.2rem; }
  .svsim .sv-h2 { font-size: 1.55rem; font-weight: 750; letter-spacing: -0.015em; margin: 0 0 0.6rem; line-height: 1.25; }
  .svsim .sv-h3 { font-size: 1.05rem; font-weight: 700; margin: 0 0 0.5rem; }
  .svsim .sv-lead { font-size: 1.08rem; max-width: 46rem; }
  .svsim .sv-text { max-width: 46rem; }
  .svsim .sv-small { font-size: 0.86rem; color: var(--sv-muted); }
  .svsim .sv-mt { margin-top: 1rem; }
  .svsim .sv-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .svsim .sv-solver { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr); }
  .svsim .sv-card { background: var(--sv-card); border: 1px solid var(--sv-line); border-radius: 0.75rem; padding: 1rem 1.15rem; min-width: 0; }
  .svsim .sv-plain { border-left: 4px solid var(--sv-teal); background: var(--sv-soft); border-radius: 0.5rem; padding: 0.75rem 1rem; margin: 1rem 0; max-width: 46rem; }
  .svsim .sv-plain b.tag { display: block; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sv-teal); margin-bottom: 0.15rem; }
  .svsim .sv-pagenav { display: flex; justify-content: space-between; gap: 0.75rem; margin-top: 1.8rem; padding-top: 1.1rem; border-top: 1px solid var(--sv-line); }
  .svsim .sv-pagenav .sv-btn { max-width: 48%; }
  .svsim .sv-pagenav #sv-next { margin-left: auto; }

  /* ---- buttons & inputs ---- */
  .svsim .sv-btn { font: inherit; font-size: 0.92rem; font-weight: 600; padding: 0.5rem 0.95rem; border-radius: 0.5rem; border: 1px solid var(--sv-line); background: var(--sv-card); color: var(--sv-ink); cursor: pointer; line-height: 1.35; }
  .svsim .sv-btn:hover { background: var(--sv-soft); }
  .svsim .sv-btn:disabled { opacity: 0.45; cursor: default; }
  .svsim .sv-btn[hidden] { display: none; }
  .svsim .sv-primary { background: var(--sv-primary); border-color: var(--sv-primary); color: #fff; }
  .svsim[data-theme="dark"] .sv-primary { color: #0b1220; }
  .svsim .sv-primary:hover { background: var(--sv-primary); filter: brightness(0.93); }
  .svsim .sv-ghost { background: transparent; white-space: nowrap; }
  .svsim .sv-sm { font-size: 0.8rem; padding: 0.3rem 0.65rem; }
  .svsim .sv-row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .svsim select { font: inherit; font-size: 0.95rem; color: var(--sv-ink); background: var(--sv-soft); border: 1px solid var(--sv-line); border-radius: 0.45rem; padding: 0.3rem 0.5rem; margin-top: 0.15rem; }
  .svsim label.sv-sel { display: flex; flex-direction: column; font-size: 0.8rem; color: var(--sv-muted); font-weight: 600; }
  .svsim .sv-switch { display: inline-flex; gap: 0.4rem; align-items: center; font-size: 0.9rem; cursor: pointer; }
  .svsim .sv-switch input { accent-color: var(--sv-primary); width: 1rem; height: 1rem; }
  .svsim details.sv-more { margin-top: 1rem; border: 1px dashed var(--sv-line); border-radius: 0.6rem; padding: 0.6rem 0.9rem; }
  .svsim details.sv-more summary { cursor: pointer; font-weight: 600; color: var(--sv-primary); }
  .svsim details.sv-more[open] summary { margin-bottom: 0.6rem; }

  /* ---- glossary terms ---- */
  .svsim .sv-term { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: help; border-bottom: 2px dotted var(--sv-primary); font-weight: 600; }
  .svsim .sv-term:hover, .svsim .sv-term:focus-visible { color: var(--sv-primary); outline: none; }
  .svsim .sv-pop { position: absolute; z-index: 30; max-width: 20rem; background: var(--sv-ink); color: var(--sv-bg); border-radius: 0.6rem; padding: 0.65rem 0.85rem; font-size: 0.9rem; line-height: 1.5; box-shadow: 0 10px 30px rgba(0,0,0,0.18); }
  .svsim .sv-pop b { display: block; margin-bottom: 0.15rem; }

  /* ---- check yourself ---- */
  .svsim .sv-check { margin-top: 1.4rem; border: 1px solid var(--sv-line); border-radius: 0.75rem; padding: 0.9rem 1.1rem; background: var(--sv-soft); max-width: 46rem; }
  .svsim .sv-check .q { font-weight: 600; margin-bottom: 0.5rem; }
  .svsim .sv-check .q::before { content: "Check yourself: "; color: var(--sv-primary); font-weight: 700; }
  .svsim .sv-opts { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .svsim .sv-opt:disabled { opacity: 0.6; }
  .svsim .sv-opt.right, .svsim .sv-opt.right:disabled { opacity: 1; background: var(--sv-good-soft); border-color: var(--sv-good); }
  .svsim .sv-opt.wrong, .svsim .sv-opt.wrong:disabled { opacity: 1; background: var(--sv-bad-soft); border-color: var(--sv-bad); }
  .svsim .sv-fb { margin-top: 0.6rem; font-size: 0.93rem; }
  .svsim .sv-fb.ok::before { content: "✓ Correct. "; color: var(--sv-good); font-weight: 700; }
  .svsim .sv-fb.no::before { content: "✗ Not quite. "; color: var(--sv-bad); font-weight: 700; }

  /* ---- diagrams ---- */
  .svsim .sv-flow { display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.5rem; margin: 1rem 0; }
  .svsim .sv-node { flex: 1 1 9rem; border: 1.5px solid var(--sv-line); border-radius: 0.7rem; padding: 0.7rem 0.8rem; background: var(--sv-card); text-align: center; }
  .svsim .sv-node b { display: block; font-size: 0.98rem; }
  .svsim .sv-node > span { display: block; font-size: 0.85rem; color: var(--sv-muted); line-height: 1.45; margin-top: 0.15rem; }
  .svsim .sv-node.blue { border-color: var(--sv-yes); background: var(--sv-primary-soft); }
  .svsim .sv-node.amber { border-color: var(--sv-no); background: var(--sv-no-soft); }
  .svsim .sv-node.purple { border-color: var(--sv-purple); }
  .svsim .sv-node.teal { border-color: var(--sv-teal); }
  .svsim .sv-node .num { display: inline-flex; width: 1.6rem; height: 1.6rem; border-radius: 999px; align-items: center; justify-content: center; background: var(--sv-primary); color: #fff; font-weight: 700; font-size: 0.85rem; margin: 0 auto 0.3rem; }
  .svsim[data-theme="dark"] .sv-node .num { color: #0b1220; }
  .svsim .sv-arrow { align-self: center; color: var(--sv-muted); font-size: 1.3rem; font-weight: 700; }
  .svsim .sv-groups { display: flex; gap: 0.5rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .svsim .sv-groups span { border-top: 3px solid var(--sv-yes); padding-top: 0.25rem; color: var(--sv-yes); }
  .svsim .sv-groups span.pred { border-color: var(--sv-no); color: var(--sv-no); }
  .svsim .sv-tiles { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 0.35rem; max-width: 34rem; margin: 0.8rem 0; }
  .svsim .sv-tile { aspect-ratio: 1; border-radius: 0.4rem; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700; border: 1.5px solid var(--sv-line); }
  .svsim .sv-tile.rain { background: var(--sv-yes-soft); border-color: var(--sv-yes); color: var(--sv-yes); }
  .svsim .sv-tile.dry { background: var(--sv-soft); color: var(--sv-muted); }
  .svsim .c-post { color: var(--sv-purple); font-weight: 700; }
  .svsim .c-lik { color: var(--sv-teal); font-weight: 700; }
  .svsim .c-pri { color: var(--sv-yes); font-weight: 700; }
  .svsim .c-ev { color: var(--sv-no); font-weight: 700; }

  /* ---- emails ---- */
  .svsim .sv-mails { display: grid; grid-template-columns: repeat(auto-fill, minmax(4.6rem, 1fr)); gap: 0.6rem; margin: 0.9rem 0; }
  .svsim .sv-mail { position: relative; border-radius: 0.5rem; border: 1.5px solid; padding: 0.55rem 0.3rem 0.4rem; text-align: center; font-size: 0.72rem; font-weight: 700; transition: opacity 0.35s ease, transform 0.35s ease; }
  .svsim .sv-mail svg { display: block; margin: 0 auto 0.2rem; width: 1.6rem; height: 1.2rem; }
  .svsim .sv-mail.spam { border-color: var(--sv-no); background: var(--sv-no-soft); color: var(--sv-no); }
  .svsim .sv-mail.ham { border-color: var(--sv-yes); background: var(--sv-primary-soft); color: var(--sv-yes); }
  .svsim .sv-mail .free { position: absolute; top: -0.6rem; right: -0.35rem; background: var(--sv-ink); color: var(--sv-bg); border-radius: 999px; font-size: 0.62rem; padding: 0.05rem 0.4rem; }
  .svsim .sv-mail.out { opacity: 0.15; transform: scale(0.9); }
  .svsim .sv-legend { display: flex; flex-wrap: wrap; gap: 0.8rem; font-size: 0.85rem; color: var(--sv-muted); }
  .svsim .sv-legend i { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 0.2rem; vertical-align: -1px; margin-right: 0.3rem; border: 1.5px solid; }

  /* ---- math ---- */
  .svsim .sv-math { font-family: "STIX Two Math", "Cambria Math", "Latin Modern Math", "Times New Roman", serif; font-size: 1.08em; }
  .svsim .frac { display: inline-flex; flex-direction: column; vertical-align: middle; text-align: center; margin: 0 0.12em; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .svsim .frac > span:first-child { border-bottom: 1px solid currentColor; padding: 0 0.15em; }
  .svsim .frac > span:last-child { padding: 0 0.15em; }
  .svsim .sv-formula { text-align: center; padding: 0.8rem; background: var(--sv-soft); border-radius: 0.6rem; margin: 0.8rem 0; overflow-x: auto; font-size: 1.15rem; }
  .svsim .sv-labels { display: grid; gap: 0.35rem; max-width: 46rem; margin: 0.4rem 0 0.6rem; padding: 0; list-style: none; }
  .svsim .sv-labels li { display: grid; grid-template-columns: 9rem 1fr; gap: 0.6rem; font-size: 0.95rem; }
  .svsim .sv-calc { display: grid; gap: 0.5rem; }
  .svsim .sv-calcrow { padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--sv-line); overflow-x: auto; white-space: nowrap; }
  .svsim .sv-calcrow.yes { border-left: 4px solid var(--sv-yes); }
  .svsim .sv-calcrow.no { border-left: 4px solid var(--sv-no); }
  .svsim .sv-calcrow .lbl { display: block; font-size: 0.78rem; font-weight: 700; color: var(--sv-muted); white-space: normal; }

  /* ---- tables & bars ---- */
  .svsim .sv-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; font-variant-numeric: tabular-nums; }
  .svsim .sv-table th, .svsim .sv-table td { padding: 0.3rem 0.45rem; border-bottom: 1px solid var(--sv-line); text-align: center; transition: background 0.15s ease; }
  .svsim .sv-table th { font-weight: 700; background: var(--sv-soft); }
  .svsim .sv-table td:first-child, .svsim .sv-table th:first-child { text-align: left; }
  .svsim .sv-scroll { overflow-x: auto; }
  .svsim .sv-data td.lab-yes { color: var(--sv-yes); font-weight: 700; }
  .svsim .sv-data td.lab-no { color: var(--sv-no); font-weight: 700; }
  .svsim .sv-table td.hl { background: var(--sv-hl); font-weight: 700; }
  .svsim .sv-table .dimcol { opacity: 0.3; }
  .svsim .sv-table tr.scan td { box-shadow: inset 0 2px 0 var(--sv-primary), inset 0 -2px 0 var(--sv-primary); }
  .svsim .sv-table td.zero { background: var(--sv-bad-soft); color: var(--sv-bad); font-weight: 700; }
  .svsim .sv-table td.new { background: var(--sv-good-soft); font-weight: 700; }
  .svsim .sv-bars { display: grid; gap: 0.45rem; }
  .svsim .sv-bar { display: grid; grid-template-columns: 6.5rem 1fr 4.4rem; gap: 0.5rem; align-items: center; font-size: 0.9rem; }
  .svsim .sv-bar .track { height: 1.1rem; background: var(--sv-soft); border-radius: 999px; overflow: hidden; border: 1px solid var(--sv-line); }
  .svsim .sv-bar .fill { display: block; height: 100%; border-radius: 999px; transition: width 0.4s ease; }
  .svsim .sv-bar .val { text-align: right; font-variant-numeric: tabular-nums; font-weight: 700; }
  .svsim .sv-callout { padding: 0.65rem 0.85rem; border-radius: 0.5rem; background: var(--sv-primary-soft); font-size: 0.94rem; margin-top: 0.8rem; }
  .svsim .sv-callout.warn { background: var(--sv-bad-soft); border-left: 4px solid var(--sv-bad); }
  .svsim .sv-callout.ok { background: var(--sv-good-soft); border-left: 4px solid var(--sv-good); }
  .svsim .sv-verdict { font-size: 1.08rem; font-weight: 700; padding: 0.7rem 0.9rem; border-radius: 0.5rem; background: var(--sv-primary); color: #fff; margin-top: 0.8rem; }
  .svsim[data-theme="dark"] .sv-verdict { color: #0b1220; }
  .svsim .sv-pill { display: inline-block; padding: 0.05rem 0.55rem; border-radius: 999px; background: var(--sv-soft); border: 1px solid var(--sv-line); font-weight: 600; font-size: 0.9rem; margin: 0.1rem 0.1rem; }

  /* ---- solver ---- */
  .svsim .sv-stepchip { display: inline-block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sv-primary); background: var(--sv-primary-soft); border-radius: 999px; padding: 0.15rem 0.6rem; margin-bottom: 0.5rem; }
  .svsim .sv-stepcard { min-height: 26rem; }
  .svsim .sv-what { display: grid; grid-template-columns: 2.6rem 1fr; gap: 0.2rem 0.6rem; font-size: 0.95rem; margin-bottom: 0.8rem; padding-bottom: 0.7rem; border-bottom: 1px solid var(--sv-line); }
  .svsim .sv-what b { color: var(--sv-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; padding-top: 0.2rem; }
  .svsim .sv-controls { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-top: 1rem; }
  .svsim .sv-dots { display: flex; gap: 0.35rem; margin-left: auto; }
  .svsim .sv-dot { width: 1.9rem; height: 1.9rem; border-radius: 999px; border: 1px solid var(--sv-line); background: var(--sv-card); color: var(--sv-muted); font-size: 0.8rem; font-weight: 700; cursor: pointer; }
  .svsim .sv-dot[aria-current="step"] { background: var(--sv-primary); border-color: var(--sv-primary); color: #fff; }
  .svsim .sv-dot.done { color: var(--sv-primary); border-color: var(--sv-primary); }
  .svsim .sv-counter { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin: 0.7rem 0; }
  .svsim .sv-counter div { border-radius: 0.6rem; padding: 0.5rem; text-align: center; border: 1.5px solid; font-size: 0.85rem; font-weight: 600; }
  .svsim .sv-counter div b { display: block; font-size: 1.9rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .svsim .sv-counter .y { border-color: var(--sv-yes); background: var(--sv-primary-soft); color: var(--sv-yes); }
  .svsim .sv-counter .n { border-color: var(--sv-no); background: var(--sv-no-soft); color: var(--sv-no); }
  .svsim .sv-feats { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.6rem; }
  .svsim .sv-feat[aria-pressed="true"] { border-color: var(--sv-primary); color: var(--sv-primary); background: var(--sv-primary-soft); }
  .svsim .sv-feat.ok::after { content: " ✓"; color: var(--sv-good); }

  /* ---- sliders & svg ---- */
  .svsim .sv-sliders { display: grid; gap: 0.55rem; }
  .svsim .sv-slider { display: grid; grid-template-columns: 9.5rem 1fr 3rem; gap: 0.6rem; align-items: center; font-size: 0.9rem; }
  .svsim .sv-slider input[type="range"] { width: 100%; accent-color: var(--sv-primary); }
  .svsim .sv-slider output { text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }
  .svsim .sv-slider.no input[type="range"] { accent-color: var(--sv-no); }
  .svsim .sv-slider.no span:first-child { color: var(--sv-no); font-weight: 600; }
  .svsim .sv-slider.yes span:first-child { color: var(--sv-yes); font-weight: 600; }
  .svsim .sv-slidergroup { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--sv-muted); margin-top: 0.4rem; }
  .svsim svg text { fill: var(--sv-muted); font-size: 12px; }

  /* ---- quiz ---- */
  .svsim .sv-quizhead { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; align-items: center; margin-bottom: 0.4rem; }
  .svsim .sv-score { font-weight: 700; color: var(--sv-primary); }
  .svsim .sv-q { margin-top: 1rem; }
  .svsim .sv-hint { font-size: 0.92rem; margin-top: 0.5rem; padding: 0.5rem 0.7rem; border-radius: 0.45rem; background: var(--sv-hl); }

  @media (max-width: 860px) {
    .svsim .sv-grid2, .svsim .sv-solver { grid-template-columns: 1fr; }
    .svsim .sv-solver .sv-stepcard { order: -1; min-height: 0; }
    .svsim .sv-data { font-size: 0.78rem; }
    .svsim .sv-data th, .svsim .sv-data td { padding: 0.25rem 0.3rem; }
    .svsim .sv-dots { margin-left: 0; }
    .svsim .sv-slider { grid-template-columns: 7.5rem 1fr 2.6rem; }
    .svsim .sv-labels li { grid-template-columns: 6.5rem 1fr; }
    .svsim .sv-arrow { display: none; }
    .svsim .sv-top { flex-direction: column-reverse; }
    .svsim .sv-h2 { font-size: 1.3rem; }
    .svsim .sv-pagenav .sv-btn { font-size: 0.82rem; }
