      '<div class="sv-plot">' + plot({ pts: P1, lines: [{ n: LA.n, c: LA.c, color: "var(--sv-bad)", dash: "7 5" }, { n: LB.n, c: LB.c, color: "var(--sv-purple)", dash: "7 5" }, { n: BEST1.n, c: BEST1.c, color: "var(--sv-good)" }],
