  }

  // ================================================================ pages
  var PARTS = [{ id: "A", label: "A · Learn the idea" }, { id: "B", label: "B · See it work" }, { id: "C", label: "C · Try it yourself" }];
  var PAGES = [];
  function page(id, part, title, build, onShow) { PAGES.push({ id: id, part: part, title: title, build: build, onShow: onShow }); }

  // lines that separate the data but hug one group (for A1)
  function hugLine(dth, hug) {
    var th = Math.atan2(BEST1.n[1], BEST1.n[0]) + dth, n = [Math.cos(th), Math.sin(th)], c;
