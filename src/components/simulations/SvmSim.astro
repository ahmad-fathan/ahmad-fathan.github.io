        { t: "The street gets narrower to avoid mistakes", ok: true, why: "Every mistake costs a lot, so SVM squeezes the street to keep points out of it." },
        { t: "Nothing changes", ok: false, why: "C changes the balance between a wide street and few mistakes." },
