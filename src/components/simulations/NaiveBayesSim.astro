---
// Naive Bayes interactive simulation.
// All markup is generated by the inline script below from the data it holds,
// so every number on screen is computed, never typed by hand.
---

<div class="nbsim" data-theme="light" id="nbsim">
  <div class="nb-toolbar">
    <div class="nb-tabs" role="tablist" aria-label="Simulation sections">
      <button role="tab" class="nb-tab" data-tab="bayes" aria-selected="true">1. Bayes' theorem</button>
      <button role="tab" class="nb-tab" data-tab="solver" aria-selected="false">2. Step-by-step solver</button>
      <button role="tab" class="nb-tab" data-tab="gauss" aria-selected="false">3. Gaussian NB</button>
      <button role="tab" class="nb-tab" data-tab="quiz" aria-selected="false">4. Your turn</button>
    </div>
    <button type="button" class="nb-btn nb-ghost" id="nb-theme" aria-label="Toggle dark mode">◐ Dark</button>
  </div>

  <!-- ============ 1. BAYES PLAYGROUND ============ -->
  <section class="nb-panel" data-panel="bayes" role="tabpanel">
    <h2 class="nb-h2">Bayes' theorem with one feature: is this email spam?</h2>
    <p class="nb-lead">
      We have a set of labeled emails and look at a single feature: does the email contain the word
      <b>"free"</b>? A new email arrives and it does contain "free". Move the sliders and watch the
      posterior change.
    </p>
    <div class="nb-grid2">
      <div class="nb-card">
        <h3 class="nb-h3">Training data</h3>
        <div class="nb-sliders" id="bp-sliders"></div>
        <table class="nb-table nb-mt">
          <thead><tr><th>Class</th><th>Emails</th><th>Contain "free"</th></tr></thead>
          <tbody id="bp-table"></tbody>
        </table>
        <p class="nb-small nb-mt">Default values are the example from the slides: 4 spam, 6 not spam.</p>
      </div>
      <div class="nb-card">
        <h3 class="nb-h3">Bayes' theorem</h3>
        <div class="nb-formula" id="bp-general"></div>
        <div id="bp-calc"></div>
        <div id="bp-bars" class="nb-mt"></div>
        <div id="bp-note" class="nb-callout nb-mt"></div>
      </div>
    </div>
  </section>

  <!-- ============ 2. SOLVER ============ -->
  <section class="nb-panel" data-panel="solver" role="tabpanel" hidden>
    <h2 class="nb-h2">Solving the Play Golf problem in five steps</h2>
    <p class="nb-lead">
      Choose today's weather, then press <b>Next</b> (or the → key) to follow the five steps:
      count, prior, likelihood, score, decide.
    </p>

    <div class="nb-card nb-query">
      <div class="nb-query-row" id="sv-query"></div>
      <div class="nb-query-row">
        <label class="nb-switch"><input type="checkbox" id="sv-laplace" /> <span>Laplace smoothing (add 1)</span></label>
        <label class="nb-switch"><input type="checkbox" id="sv-guess" /> <span>Predict before the answer is shown</span></label>
        <span class="nb-presets">
          <button type="button" class="nb-btn nb-ghost nb-sm" data-preset="slides">Slide example</button>
          <button type="button" class="nb-btn nb-ghost nb-sm" data-preset="zero">Zero-probability case</button>
        </span>
      </div>
    </div>

    <div class="nb-grid2 nb-solver">
      <div class="nb-card">
        <h3 class="nb-h3">Training data (14 days)</h3>
        <div class="nb-scroll"><table class="nb-table nb-data" id="sv-data"></table></div>
        <p class="nb-small nb-mt" id="sv-data-note"></p>
      </div>
      <div class="nb-card nb-stepcard">
        <div class="nb-stepchip" id="sv-chip"></div>
        <h3 class="nb-h3" id="sv-title"></h3>
        <div id="sv-body" aria-live="polite"></div>
      </div>
    </div>

    <div class="nb-controls">
      <button type="button" class="nb-btn" id="sv-back">← Back</button>
      <button type="button" class="nb-btn nb-primary" id="sv-next">Next →</button>
      <button type="button" class="nb-btn" id="sv-play">▶ Play</button>
      <button type="button" class="nb-btn nb-ghost" id="sv-restart">Restart</button>
      <div class="nb-dots" id="sv-dots" aria-label="Steps"></div>
    </div>
  </section>

  <!-- ============ 3. GAUSSIAN ============ -->
  <section class="nb-panel" data-panel="gauss" role="tabpanel" hidden>
    <h2 class="nb-h2">Gaussian Naïve Bayes: one continuous feature</h2>
    <p class="nb-lead">
      For a continuous feature such as height, each class is modeled by a normal curve. The likelihood
      of a value is the height of the class curve at that value. Drag the slider for <i>x</i> and
      change each class's mean and standard deviation.
    </p>
    <div class="nb-grid2">
      <div class="nb-card">
        <svg id="ga-svg" viewBox="0 0 640 300" role="img" aria-label="Two normal curves with the new value marked"></svg>
        <div class="nb-sliders" id="ga-x"></div>
      </div>
      <div class="nb-card">
        <div class="nb-sliders" id="ga-sliders"></div>
        <div id="ga-calc" class="nb-mt"></div>
        <div id="ga-bars" class="nb-mt"></div>
      </div>
    </div>
  </section>

  <!-- ============ 4. QUIZ ============ -->
  <section class="nb-panel" data-panel="quiz" role="tabpanel" hidden>
    <h2 class="nb-h2">Your turn</h2>
    <p class="nb-lead">
      A random day is drawn. Answer the two questions using the Play Golf data, then check the full
      solution. The data table is shown in the <b>Step-by-step solver</b> tab.
    </p>
    <div class="nb-card">
      <div class="nb-quizhead">
        <div id="qz-query"></div>
        <div class="nb-score" id="qz-score"></div>
      </div>
      <div id="qz-body"></div>
      <div class="nb-controls">
        <button type="button" class="nb-btn nb-primary" id="qz-new">New question</button>
      </div>
    </div>
  </section>
</div>

<style is:global>
  .nbsim {
    --nb-bg: #ffffff;
    --nb-card: #ffffff;
    --nb-soft: #f8fafc;
    --nb-ink: #0f172a;
    --nb-muted: #5b6573;
    --nb-line: #e2e8f0;
    --nb-primary: #2563eb;
    --nb-primary-soft: #eff6ff;
    --nb-yes: #2563eb;
    --nb-no: #d97706;
    --nb-no-soft: #fff7ed;
    --nb-hl: #fef9c3;
    --nb-bad: #dc2626;
    --nb-bad-soft: #fef2f2;
    --nb-good: #16a34a;
    --nb-good-soft: #f0fdf4;
    background: var(--nb-bg);
    color: var(--nb-ink);
    border-radius: 0.9rem;
    padding: 0.25rem;
    font-size: 1rem;
    line-height: 1.6;
  }
  .nbsim[data-theme="dark"] {
    --nb-bg: #0b1220;
    --nb-card: #111a2e;
    --nb-soft: #16213a;
    --nb-ink: #e5e9f0;
    --nb-muted: #9aa6b8;
    --nb-line: #26324a;
    --nb-primary: #60a5fa;
    --nb-primary-soft: #172554;
    --nb-yes: #60a5fa;
    --nb-no: #fbbf24;
    --nb-no-soft: #2a2110;
    --nb-hl: #3a3410;
    --nb-bad: #f87171;
    --nb-bad-soft: #2a1414;
    --nb-good: #4ade80;
    --nb-good-soft: #10261a;
    padding: 1rem;
  }
  .nbsim * { box-sizing: border-box; }
  .nbsim .nb-toolbar { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; }
  .nbsim .nb-tabs { display: flex; flex-wrap: wrap; gap: 0.25rem; border-bottom: 1px solid var(--nb-line); }
  .nbsim .nb-tab { background: none; border: 0; border-bottom: 2px solid transparent; padding: 0.55rem 0.8rem; font-size: 0.92rem; font-weight: 600; color: var(--nb-muted); cursor: pointer; margin-bottom: -1px; }
  .nbsim .nb-tab:hover { color: var(--nb-ink); }
  .nbsim .nb-tab[aria-selected="true"] { color: var(--nb-primary); border-bottom-color: var(--nb-primary); }
  .nbsim .nb-h2 { font-size: 1.35rem; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 0.35rem; }
  .nbsim .nb-h3 { font-size: 1.05rem; font-weight: 700; margin: 0 0 0.6rem; }
  .nbsim .nb-lead { color: var(--nb-muted); margin: 0 0 1.1rem; max-width: 52rem; }
  .nbsim .nb-small { font-size: 0.85rem; color: var(--nb-muted); margin: 0; }
  .nbsim .nb-mt { margin-top: 0.9rem; }
  .nbsim .nb-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .nbsim .nb-solver { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); }
  @media (max-width: 860px) {
    .nbsim .nb-grid2, .nbsim .nb-solver { grid-template-columns: 1fr; }
    .nbsim .nb-solver .nb-stepcard { order: -1; min-height: 0; }
    .nbsim .nb-data { font-size: 0.78rem; }
    .nbsim .nb-data th, .nbsim .nb-data td { padding: 0.25rem 0.3rem; }
    .nbsim .nb-dots { margin-left: 0; }
    .nbsim .nb-slider { grid-template-columns: 7.5rem 1fr 2.6rem; }
  }
  .nbsim .nb-card { background: var(--nb-card); border: 1px solid var(--nb-line); border-radius: 0.75rem; padding: 1rem 1.1rem; min-width: 0; }
  .nbsim .nb-query { margin-bottom: 1rem; }
  .nbsim .nb-query-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.2rem; align-items: center; }
  .nbsim .nb-query-row + .nb-query-row { margin-top: 0.7rem; }
  .nbsim .nb-query-row label.nb-sel { display: flex; flex-direction: column; font-size: 0.8rem; color: var(--nb-muted); font-weight: 600; }
  .nbsim select { margin-top: 0.15rem; font: inherit; font-size: 0.95rem; color: var(--nb-ink); background: var(--nb-soft); border: 1px solid var(--nb-line); border-radius: 0.45rem; padding: 0.3rem 0.5rem; }
  .nbsim .nb-switch { display: inline-flex; gap: 0.4rem; align-items: center; font-size: 0.9rem; cursor: pointer; }
  .nbsim .nb-switch input { accent-color: var(--nb-primary); width: 1rem; height: 1rem; }
  .nbsim .nb-presets { display: inline-flex; gap: 0.4rem; margin-left: auto; }
  .nbsim .nb-btn { font: inherit; font-size: 0.9rem; font-weight: 600; padding: 0.45rem 0.9rem; border-radius: 0.5rem; border: 1px solid var(--nb-line); background: var(--nb-card); color: var(--nb-ink); cursor: pointer; }
  .nbsim .nb-btn:hover { background: var(--nb-soft); }
  .nbsim .nb-btn:disabled { opacity: 0.45; cursor: default; }
  .nbsim .nb-primary { background: var(--nb-primary); border-color: var(--nb-primary); color: #fff; }
  .nbsim[data-theme="dark"] .nb-primary { color: #0b1220; }
  .nbsim .nb-primary:hover { background: var(--nb-primary); filter: brightness(0.93); }
  .nbsim .nb-ghost { background: transparent; }
  .nbsim .nb-sm { font-size: 0.8rem; padding: 0.3rem 0.6rem; }
  .nbsim .nb-controls { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-top: 1rem; }
  .nbsim .nb-dots { display: flex; gap: 0.35rem; margin-left: auto; }
  .nbsim .nb-dot { width: 1.9rem; height: 1.9rem; border-radius: 999px; border: 1px solid var(--nb-line); background: var(--nb-card); color: var(--nb-muted); font-size: 0.8rem; font-weight: 700; cursor: pointer; }
  .nbsim .nb-dot[aria-current="step"] { background: var(--nb-primary); border-color: var(--nb-primary); color: #fff; }
  .nbsim .nb-dot.done { color: var(--nb-primary); border-color: var(--nb-primary); }
  .nbsim .nb-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; font-variant-numeric: tabular-nums; }
  .nbsim .nb-table th, .nbsim .nb-table td { padding: 0.3rem 0.45rem; border-bottom: 1px solid var(--nb-line); text-align: center; }
  .nbsim .nb-table th { font-weight: 700; background: var(--nb-soft); }
  .nbsim .nb-table td:first-child, .nbsim .nb-table th:first-child { text-align: left; }
  .nbsim .nb-scroll { overflow-x: auto; }
  .nbsim .nb-data td.lab-yes { color: var(--nb-yes); font-weight: 700; }
  .nbsim .nb-data td.lab-no { color: var(--nb-no); font-weight: 700; }
  .nbsim .nb-table td.hl { background: var(--nb-hl); font-weight: 700; }
  .nbsim .nb-table tr.dim td { opacity: 0.35; }
  .nbsim .nb-table td.zero { background: var(--nb-bad-soft); color: var(--nb-bad); font-weight: 700; }
  .nbsim .nb-stepchip { display: inline-block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--nb-primary); background: var(--nb-primary-soft); border-radius: 999px; padding: 0.15rem 0.6rem; margin-bottom: 0.5rem; }
  .nbsim .nb-stepcard { min-height: 22rem; }
  .nbsim .nb-math { font-family: "STIX Two Math", "Cambria Math", "Latin Modern Math", "Times New Roman", serif; font-size: 1.08em; }
  .nbsim .nb-math i, .nbsim i.v { font-style: italic; }
  .nbsim .frac { display: inline-flex; flex-direction: column; vertical-align: middle; text-align: center; margin: 0 0.12em; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .nbsim .frac > span:first-child { border-bottom: 1px solid currentColor; padding: 0 0.15em; }
  .nbsim .frac > span:last-child { padding: 0 0.15em; }
  .nbsim .nb-formula { text-align: center; padding: 0.6rem; background: var(--nb-soft); border-radius: 0.5rem; margin-bottom: 0.8rem; overflow-x: auto; }
  .nbsim .nb-calc { display: grid; gap: 0.5rem; }
  .nbsim .nb-calcrow { padding: 0.55rem 0.7rem; border-radius: 0.5rem; border: 1px solid var(--nb-line); overflow-x: auto; white-space: nowrap; }
  .nbsim .nb-calcrow.yes { border-left: 4px solid var(--nb-yes); }
  .nbsim .nb-calcrow.no { border-left: 4px solid var(--nb-no); }
  .nbsim .nb-calcrow .lbl { display: block; font-size: 0.78rem; font-weight: 700; color: var(--nb-muted); white-space: normal; }
  .nbsim .nb-bars { display: grid; gap: 0.45rem; }
  .nbsim .nb-bar { display: grid; grid-template-columns: 6.5rem 1fr 4.2rem; gap: 0.5rem; align-items: center; font-size: 0.9rem; }
  .nbsim .nb-bar .track { height: 1.1rem; background: var(--nb-soft); border-radius: 999px; overflow: hidden; border: 1px solid var(--nb-line); }
  .nbsim .nb-bar .fill { height: 100%; border-radius: 999px; transition: width 0.35s ease; }
  .nbsim .nb-bar .val { text-align: right; font-variant-numeric: tabular-nums; font-weight: 700; }
  .nbsim .nb-callout { padding: 0.65rem 0.85rem; border-radius: 0.5rem; background: var(--nb-primary-soft); font-size: 0.92rem; }
  .nbsim .nb-callout.warn { background: var(--nb-bad-soft); color: var(--nb-ink); border-left: 4px solid var(--nb-bad); }
  .nbsim .nb-callout.ok { background: var(--nb-good-soft); border-left: 4px solid var(--nb-good); }
  .nbsim .nb-callout.amber { background: var(--nb-no-soft); border-left: 4px solid var(--nb-no); }
  .nbsim .nb-verdict { font-size: 1.1rem; font-weight: 700; padding: 0.7rem 0.9rem; border-radius: 0.5rem; background: var(--nb-primary); color: #fff; margin-top: 0.8rem; }
  .nbsim[data-theme="dark"] .nb-verdict { color: #0b1220; }
  .nbsim .nb-steps { margin: 0.4rem 0 0; padding-left: 1.3rem; }
  .nbsim .nb-steps li { margin: 0.2rem 0; }
  .nbsim .nb-ftabs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }
  @media (max-width: 520px) { .nbsim .nb-ftabs { grid-template-columns: 1fr; } }
  .nbsim .nb-ftabs .nb-table { font-size: 0.82rem; }
  .nbsim .nb-sliders { display: grid; gap: 0.55rem; }
  .nbsim .nb-slider { display: grid; grid-template-columns: 9.5rem 1fr 3rem; gap: 0.6rem; align-items: center; font-size: 0.9rem; }
  .nbsim .nb-slider input[type="range"] { width: 100%; accent-color: var(--nb-primary); }
  .nbsim .nb-slider output { text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }
  .nbsim .nb-slider.no input[type="range"] { accent-color: var(--nb-no); }
  .nbsim .nb-slider.no span:first-child { color: var(--nb-no); font-weight: 600; }
  .nbsim .nb-slider.yes span:first-child { color: var(--nb-yes); font-weight: 600; }
  .nbsim .nb-slidergroup { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--nb-muted); margin-top: 0.4rem; }
  .nbsim svg text { fill: var(--nb-muted); font-size: 12px; }
  .nbsim .nb-quizhead { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; align-items: center; margin-bottom: 0.8rem; }
  .nbsim .nb-score { font-weight: 700; color: var(--nb-primary); }
  .nbsim .nb-q { margin-top: 0.9rem; }
  .nbsim .nb-opts { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.45rem; }
  .nbsim .nb-opt { min-width: 4.5rem; }
  .nbsim .nb-opt:disabled { opacity: 0.6; }
  .nbsim .nb-opt.right:disabled, .nbsim .nb-opt.wrong:disabled { opacity: 1; }
  .nbsim .nb-opt.right { background: var(--nb-good-soft); border-color: var(--nb-good); color: var(--nb-ink); }
  .nbsim .nb-opt.wrong { background: var(--nb-bad-soft); border-color: var(--nb-bad); text-decoration: line-through; color: var(--nb-ink); }
  .nbsim .nb-hint { font-size: 0.88rem; margin-top: 0.4rem; }
  .nbsim .nb-pill { display: inline-block; padding: 0.05rem 0.55rem; border-radius: 999px; background: var(--nb-soft); border: 1px solid var(--nb-line); font-weight: 600; font-size: 0.9rem; margin: 0.1rem 0.1rem; }
</style>

<script is:inline>
(function () {
  "use strict";
  var root = document.getElementById("nbsim");
  if (!root) return;
  var $ = function (sel) { return root.querySelector(sel); };
  var $$ = function (sel) { return Array.prototype.slice.call(root.querySelectorAll(sel)); };

  // ---------------------------------------------------------------- helpers
  function frac(n, d) { return '<span class="frac"><span>' + n + "</span><span>" + d + "</span></span>"; }
  function fmt(x, k) {
    if (!isFinite(x)) return "–";
    if (x === 0) return "0";
    k = k || 4;
    var t = Math.abs(x) >= 1 ? x.toFixed(2) : x.toPrecision(k);
    return t.indexOf(".") >= 0 ? t.replace(/0+$/, "").replace(/\.$/, "") : t;
  }
  function pct(x) { return (x * 100).toFixed(1) + "%"; }
  function bar(label, value, color, shown) {
    var w = Math.max(0, Math.min(1, value)) * 100;
    return '<div class="nb-bar"><span>' + label + '</span><span class="track"><span class="fill" style="display:block;width:' +
      w + "%;background:" + color + '"></span></span><span class="val">' + (shown != null ? shown : fmt(value, 3)) + "</span></div>";
  }
  function m(s) { return '<span class="nb-math">' + s + "</span>"; }
  var Y = '<span style="color:var(--nb-yes);font-weight:700">Yes</span>';
  var N = '<span style="color:var(--nb-no);font-weight:700">No</span>';
  function cls(c) { return c === "Yes" ? Y : N; }

  // ---------------------------------------------------------------- tabs
  var current = "bayes";
  $$(".nb-tab").forEach(function (t) {
    t.addEventListener("click", function () { showTab(t.getAttribute("data-tab")); });
  });
  function showTab(name) {
    current = name;
    $$(".nb-tab").forEach(function (t) { t.setAttribute("aria-selected", String(t.getAttribute("data-tab") === name)); });
    $$(".nb-panel").forEach(function (p) { p.hidden = p.getAttribute("data-panel") !== name; });
    if (name !== "solver") stopPlay();
    if (name === "gauss") drawGauss();
  }
  var themeBtn = $("#nb-theme");
  themeBtn.addEventListener("click", function () {
    var dark = root.getAttribute("data-theme") !== "dark";
    root.setAttribute("data-theme", dark ? "dark" : "light");
    themeBtn.textContent = dark ? "◐ Light" : "◐ Dark";
    drawGauss();
  });

  function slider(container, id, label, min, max, step, value, onInput, cls) {
    var wrap = document.createElement("label");
    wrap.className = "nb-slider" + (cls ? " " + cls : "");
    wrap.innerHTML = "<span>" + label + '</span><input type="range" id="' + id + '" min="' + min + '" max="' + max +
      '" step="' + step + '" value="' + value + '"><output>' + value + "</output>";
    container.appendChild(wrap);
    var input = wrap.querySelector("input"), out = wrap.querySelector("output");
    input.addEventListener("input", function () { out.textContent = input.value; onInput(); });
    return { input: input, out: out, set: function (v) { input.value = v; out.textContent = v; } };
  }

  // ================================================================ 1. BAYES
  var bp = {};
  (function initBayes() {
    var c = $("#bp-sliders");
    bp.s = slider(c, "bp-s", "Spam emails", 1, 20, 1, 4, updBayes, "yes");
    bp.sf = slider(c, "bp-sf", 'Spam with "free"', 0, 20, 1, 3, updBayes, "yes");
    bp.n = slider(c, "bp-n", "Not-spam emails", 1, 20, 1, 6, updBayes, "no");
    bp.nf = slider(c, "bp-nf", 'Not spam with "free"', 0, 20, 1, 1, updBayes, "no");
    $("#bp-general").innerHTML = m("<i>P</i>(Spam | free) = " + frac("<i>P</i>(free | Spam) · <i>P</i>(Spam)", "<i>P</i>(free)")) +
      '<div class="nb-small" style="margin-top:.4rem">posterior = likelihood × prior ÷ evidence</div>';
    updBayes();
  })();
  function updBayes() {
    var S = +bp.s.input.value, N0 = +bp.n.input.value;
    bp.sf.input.max = S; bp.nf.input.max = N0;
    if (+bp.sf.input.value > S) bp.sf.set(S);
    if (+bp.nf.input.value > N0) bp.nf.set(N0);
    var SF = +bp.sf.input.value, NF = +bp.nf.input.value, T = S + N0, TF = SF + NF;
    $("#bp-table").innerHTML =
      "<tr><td>" + Y.replace("Yes", "Spam") + "</td><td>" + S + "</td><td>" + SF + "</td></tr>" +
      "<tr><td>" + N.replace("No", "Not spam") + "</td><td>" + N0 + "</td><td>" + NF + "</td></tr>" +
      "<tr><td><b>Total</b></td><td><b>" + T + "</b></td><td><b>" + TF + "</b></td></tr>";
    if (TF === 0) {
      $("#bp-calc").innerHTML = "";
      $("#bp-bars").innerHTML = "";
      $("#bp-note").className = "nb-callout warn nb-mt";
      $("#bp-note").innerHTML = 'No training email contains "free", so the evidence ' + m("<i>P</i>(free) = 0") +
        " and Bayes' theorem cannot be computed. This is the zero-probability problem you will meet again in the solver.";
      return;
    }
    var numS = (SF / S) * (S / T), numN = (NF / N0) * (N0 / T), ev = TF / T;
    var pS = numS / ev, pN = numN / ev;
    $("#bp-calc").innerHTML = '<div class="nb-calc">' +
      '<div class="nb-calcrow yes"><span class="lbl">Spam</span>' + m("<i>P</i>(Spam | free) = " +
        frac(frac(SF, S) + " × " + frac(S, T), frac(TF, T)) + " = " + frac(fmt(numS, 3), fmt(ev, 3)) + " = <b>" + fmt(pS, 3) + "</b>") + "</div>" +
      '<div class="nb-calcrow no"><span class="lbl">Not spam</span>' + m("<i>P</i>(Not spam | free) = " +
        frac(frac(NF, N0) + " × " + frac(N0, T), frac(TF, T)) + " = " + frac(fmt(numN, 3), fmt(ev, 3)) + " = <b>" + fmt(pN, 3) + "</b>") + "</div></div>";
    $("#bp-bars").innerHTML = '<div class="nb-bars">' + bar("Spam", pS, "var(--nb-yes)") + bar("Not spam", pN, "var(--nb-no)") + "</div>";
    var win = pS > pN ? "Spam" : pS < pN ? "Not spam" : "a tie";
    var note = $("#bp-note");
    note.className = "nb-callout nb-mt";
    note.innerHTML = "<b>Decision:</b> the new email is classified as <b>" + win + "</b>. " +
      "Both classes are divided by the same evidence " + frac(TF, T) +
      ", so comparing the numerators (" + fmt(numS, 3) + " vs " + fmt(numN, 3) + ") already gives the winner. Naïve Bayes uses this shortcut.";
  }

  // ================================================================ 2. SOLVER
  var FEATS = [
    { key: "Outlook", values: ["Sunny", "Overcast", "Rainy"] },
    { key: "Temperature", values: ["Hot", "Mild", "Cool"] },
    { key: "Humidity", values: ["High", "Normal"] },
    { key: "Wind", values: ["False", "True"] },
  ];
  var DATA = [
    ["Rainy", "Hot", "High", "False", "Yes"], ["Rainy", "Hot", "High", "True", "No"],
    ["Overcast", "Hot", "High", "False", "Yes"], ["Sunny", "Mild", "High", "False", "No"],
    ["Sunny", "Cool", "Normal", "False", "Yes"], ["Sunny", "Cool", "Normal", "True", "No"],
    ["Overcast", "Cool", "Normal", "True", "Yes"], ["Rainy", "Mild", "High", "False", "No"],
    ["Rainy", "Cool", "Normal", "False", "Yes"], ["Sunny", "Mild", "Normal", "False", "Yes"],
    ["Rainy", "Mild", "Normal", "True", "Yes"], ["Overcast", "Mild", "High", "True", "Yes"],
    ["Overcast", "Hot", "Normal", "False", "Yes"], ["Sunny", "Mild", "High", "True", "No"],
  ];
  var CLASSES = ["Yes", "No"];
  function classSize(c) { return DATA.filter(function (r) { return r[4] === c; }).length; }
  function count(fi, v, c) { return DATA.filter(function (r) { return r[fi] === v && r[4] === c; }).length; }
  // Solve a query: returns all intermediate numbers.
  function solve(q, laplace) {
    var res = { q: q, laplace: laplace, prior: {}, lik: {}, score: {}, post: {} };
    CLASSES.forEach(function (c) {
      var nc = classSize(c);
      res.prior[c] = { n: nc, d: DATA.length, v: nc / DATA.length };
      res.lik[c] = FEATS.map(function (f, i) {
        var k = f.values.length, cnt = count(i, q[i], c);
        var num = cnt + (laplace ? 1 : 0), den = nc + (laplace ? k : 0);
        return { cnt: cnt, num: num, den: den, k: k, v: num / den };
      });
      res.score[c] = res.lik[c].reduce(function (a, l) { return a * l.v; }, res.prior[c].v);
    });
    var tot = res.score.Yes + res.score.No;
    CLASSES.forEach(function (c) { res.post[c] = tot > 0 ? res.score[c] / tot : NaN; });
    res.pred = tot === 0 ? null : res.score.Yes >= res.score.No ? "Yes" : "No";
    return res;
  }

  var sv = { q: ["Sunny", "Hot", "Normal", "False"], step: 0, guess: null, timer: null };
  var STEP_NAMES = ["Plan", "Count", "Prior", "Likelihood", "Score", "Decide"];
  (function initSolver() {
    var row = $("#sv-query");
    row.innerHTML = '<span style="font-weight:700;margin-right:.3rem">Today:</span>';
    FEATS.forEach(function (f, i) {
      var lab = document.createElement("label");
      lab.className = "nb-sel";
      lab.innerHTML = f.key + '<select data-fi="' + i + '">' + f.values.map(function (v) {
        return '<option value="' + v + '"' + (v === sv.q[i] ? " selected" : "") + ">" + v + "</option>";
      }).join("") + "</select>";
      row.appendChild(lab);
    });
    $$("#sv-query select").forEach(function (s) {
      s.addEventListener("change", function () { sv.q[+s.getAttribute("data-fi")] = s.value; sv.guess = null; renderSolver(); });
    });
    $("#sv-laplace").addEventListener("change", function () { sv.guess = null; renderSolver(); });
    $("#sv-guess").addEventListener("change", function () { sv.guess = null; renderSolver(); });
    $$("[data-preset]").forEach(function (b) {
      b.addEventListener("click", function () {
        var p = b.getAttribute("data-preset");
        sv.q = p === "zero" ? ["Overcast", "Cool", "High", "True"] : ["Sunny", "Hot", "Normal", "False"];
        $("#sv-laplace").checked = false;
        $$("#sv-query select").forEach(function (s, i) { s.value = sv.q[i]; });
        sv.step = p === "zero" ? 4 : 0; sv.guess = null; renderSolver();
      });
    });
    var dots = $("#sv-dots");
    STEP_NAMES.forEach(function (n, i) {
      var d = document.createElement("button");
      d.type = "button"; d.className = "nb-dot"; d.textContent = i === 0 ? "P" : String(i);
      d.title = i === 0 ? "Plan" : "Step " + i + ": " + n;
      d.addEventListener("click", function () { stopPlay(); sv.step = i; renderSolver(); });
      dots.appendChild(d);
    });
    $("#sv-back").addEventListener("click", function () { stopPlay(); go(-1); });
    $("#sv-next").addEventListener("click", function () { stopPlay(); go(1); });
    $("#sv-restart").addEventListener("click", function () { stopPlay(); sv.step = 0; sv.guess = null; renderSolver(); });
    $("#sv-play").addEventListener("click", function () {
      if (sv.timer) { stopPlay(); return; }
      if (sv.step >= 5) sv.step = 0;
      $("#sv-play").textContent = "❚❚ Pause";
      sv.timer = setInterval(function () { if (sv.step >= 5) { stopPlay(); return; } go(1); }, 3000);
    });
    document.addEventListener("keydown", function (e) {
      if (current !== "solver") return;
      var tag = (e.target && e.target.tagName) || "";
      if (tag === "INPUT" || tag === "SELECT" || tag === "TEXTAREA") return;
      if (e.key === "ArrowRight") { stopPlay(); go(1); }
      if (e.key === "ArrowLeft") { stopPlay(); go(-1); }
    });
    renderSolver();
  })();
  function stopPlay() { if (sv.timer) { clearInterval(sv.timer); sv.timer = null; } var p = $("#sv-play"); if (p) p.textContent = "▶ Play"; }
  function go(d) { sv.step = Math.max(0, Math.min(5, sv.step + d)); renderSolver(); }

  function renderData(step) {
    var html = "<thead><tr><th>#</th>" + FEATS.map(function (f) { return "<th>" + f.key + "</th>"; }).join("") + "<th>Play</th></tr></thead><tbody>";
    DATA.forEach(function (r, ri) {
      html += "<tr><td>" + (ri + 1) + "</td>";
      r.slice(0, 4).forEach(function (v, i) {
        var hl = (step === 1 || step === 3) && v === sv.q[i];
        html += "<td" + (hl ? ' class="hl"' : "") + ">" + v + "</td>";
      });
      html += '<td class="lab-' + (r[4] === "Yes" ? "yes" : "no") + '">' + r[4] + "</td></tr>";
    });
    $("#sv-data").innerHTML = html + "</tbody>";
    $("#sv-data-note").innerHTML = step === 1 || step === 3
      ? "Highlighted cells match today's values. Count them separately for the Yes rows and the No rows."
      : "9 days are " + Y + " and 5 days are " + N + ".";
  }

  function renderSolver() {
    var lap = $("#sv-laplace").checked, guessMode = $("#sv-guess").checked;
    var r = solve(sv.q, lap), s = sv.step;
    renderData(s);
    $$("#sv-dots .nb-dot").forEach(function (d, i) {
      if (i === s) d.setAttribute("aria-current", "step"); else d.removeAttribute("aria-current");
      d.classList.toggle("done", i < s);
    });
    $("#sv-back").disabled = s === 0;
    $("#sv-next").disabled = s === 5;
    $("#sv-chip").textContent = s === 0 ? "Plan" : (s <= 2 ? "Training · " : "Prediction · ") + "Step " + s + " of 5";
    var title = ["What is the plan?", "Count: build frequency tables", "Prior: proportion of each class",
      "Likelihood: read the probabilities", "Score: prior × likelihoods", "Decide: pick the highest score"][s];
    $("#sv-title").textContent = title;
    var qStr = sv.q.map(function (v, i) { return '<span class="nb-pill">' + FEATS[i].key + " = " + v + "</span>"; }).join(" ");
    var body = "";

    if (s === 0) {
      body = "<p>New day to classify:</p><p>" + qStr + "</p>" +
        "<p>We compute a score for " + Y + " and for " + N + " with the decision rule</p>" +
        '<div class="nb-formula">' + m("<i>ŷ</i> = arg max<sub><i>y</i></sub> <i>P</i>(<i>y</i>) · ∏ <i>P</i>(<i>x<sub>i</sub></i> | <i>y</i>)") + "</div>" +
        '<p>and follow five steps:</p><ol class="nb-steps"><li><b>Count</b> how often each value appears with each class.</li>' +
        "<li><b>Prior</b>: the proportion of each class.</li><li><b>Likelihood</b>: read the probability of today's values.</li>" +
        "<li><b>Score</b>: multiply prior by the likelihoods.</li><li><b>Decide</b>: pick the highest score.</li></ol>" +
        (lap ? '<div class="nb-callout ok nb-mt">Laplace smoothing is <b>on</b>: every count gets +1, and the denominator gets + <i>k</i> (the number of values of that feature).</div>' : "");
    }

    if (s === 1) {
      body = "<p>For each feature, count the rows where the value appears together with each class. Today's values are highlighted.</p>" +
        '<div class="nb-ftabs">' + FEATS.map(function (f, i) {
          return '<table class="nb-table"><thead><tr><th>' + f.key + "</th><th>Yes</th><th>No</th></tr></thead><tbody>" +
            f.values.map(function (v) {
              var on = v === sv.q[i], cy = count(i, v, "Yes"), cn = count(i, v, "No");
              var z = function (c) { return on && c === 0 && !lap ? ' class="zero"' : on ? ' class="hl"' : ""; };
              return "<tr><td" + (on ? ' class="hl"' : "") + ">" + v + "</td><td" + z(cy) + ">" + cy + "</td><td" + z(cn) + ">" + cn + "</td></tr>";
            }).join("") + "</tbody></table>";
        }).join("") + "</div>" +
        '<p class="nb-small nb-mt">Each Yes column adds up to 9 and each No column adds up to 5.</p>' +
        (FEATS.some(function (f, i) { return count(i, sv.q[i], "No") === 0 || count(i, sv.q[i], "Yes") === 0; }) && !lap
          ? '<div class="nb-callout warn nb-mt">One of today\'s values never appears with a class (count 0). Watch what happens in Step 4.</div>' : "");
    }

    if (s === 2) {
      body = "<p>The prior is the proportion of each class among the 14 training days, before looking at today's weather.</p>" +
        '<div class="nb-calc">' +
        '<div class="nb-calcrow yes">' + m("<i>P</i>(Yes) = " + frac(9, 14) + " ≈ " + fmt(9 / 14, 3)) + "</div>" +
        '<div class="nb-calcrow no">' + m("<i>P</i>(No) = " + frac(5, 14) + " ≈ " + fmt(5 / 14, 3)) + "</div></div>" +
        '<div class="nb-bars nb-mt">' + bar("Yes", 9 / 14, "var(--nb-yes)") + bar("No", 5 / 14, "var(--nb-no)") + "</div>" +
        '<p class="nb-mt">Yes is already more likely. Today\'s features will now update this belief.</p>';
    }

    if (s === 3) {
      body = "<p>Divide each count by the class size" + (lap ? ", after adding 1 to the count and <i>k</i> to the class size (Laplace smoothing)" : " (9 for Yes, 5 for No)") + ".</p>" +
        '<table class="nb-table"><thead><tr><th>Feature = value</th><th>' + m("<i>P</i>(· | Yes)") + "</th><th>" + m("<i>P</i>(· | No)") + "</th></tr></thead><tbody>" +
        FEATS.map(function (f, i) {
          var cell = function (c) {
            var l = r.lik[c][i];
            var shown = lap ? frac(l.cnt + " + 1", (c === "Yes" ? 9 : 5) + " + " + l.k) + " = " + frac(l.num, l.den) : frac(l.num, l.den);
            return "<td" + (l.v === 0 ? ' class="zero"' : "") + ">" + m(shown) + "</td>";
          };
          return "<tr><td>" + f.key + " = " + sv.q[i] + "</td>" + cell("Yes") + cell("No") + "</tr>";
        }).join("") + "</tbody></table>" +
        '<p class="nb-small nb-mt">These numbers are read from the Step 1 counts; there is no new calculation.</p>';
    }

    if (s === 4) {
      body = "<p>Multiply the prior by all four likelihoods, once for each class.</p><div class=\"nb-calc\">" +
        CLASSES.map(function (c) {
          var terms = [frac(r.prior[c].n, r.prior[c].d)].concat(r.lik[c].map(function (l) { return frac(l.num, l.den); }));
          return '<div class="nb-calcrow ' + c.toLowerCase() + '"><span class="lbl">Score(' + c + ")</span>" +
            m(terms.join(" × ") + " ≈ <b>" + fmt(r.score[c], 4) + "</b>") + "</div>";
        }).join("") + "</div>";
      var zeroC = CLASSES.filter(function (c) { return r.score[c] === 0; });
      if (zeroC.length) {
        body += '<div class="nb-callout warn nb-mt"><b>Zero-probability problem.</b> One factor for ' + zeroC.map(cls).join(" and ") +
          " is 0, so the whole product is 0, no matter how strongly the other features support it. " +
          "The zero only comes from limited data. Turn on <b>Laplace smoothing</b> above to fix it.</div>";
      } else {
        var ratio = r.score.Yes > r.score.No ? r.score.Yes / r.score.No : r.score.No / r.score.Yes;
        body += '<p class="nb-mt">The ' + (r.score.Yes >= r.score.No ? Y : N) + " score is about " + fmt(ratio, 2) +
          " times larger. These are relative scores, not probabilities, because the denominator of Bayes' theorem was dropped.</p>";
      }
    }

    if (s === 5) {
      if (guessMode && !sv.guess) {
        body = "<p>Before the answer is shown: which class will Naïve Bayes predict for</p><p>" + qStr + "</p>" +
          '<div class="nb-opts"><button type="button" class="nb-btn nb-opt" data-g="Yes">Yes</button>' +
          '<button type="button" class="nb-btn nb-opt" data-g="No">No</button></div>';
      } else {
        var tot = r.score.Yes + r.score.No;
        if (tot === 0) {
          body = '<div class="nb-callout warn">Both scores are 0, so no decision is possible. Turn on Laplace smoothing.</div>';
        } else {
          body = "<p>Divide each score by the sum of both scores to turn them into probabilities that add up to 1.</p><div class=\"nb-calc\">" +
            CLASSES.map(function (c) {
              return '<div class="nb-calcrow ' + c.toLowerCase() + '">' + m("<i>P</i>(" + c + " | <i>X</i>) = " +
                frac(fmt(r.score[c], 4), fmt(r.score.Yes, 4) + " + " + fmt(r.score.No, 4)) + " ≈ <b>" + fmt(r.post[c], 3) + "</b>") + "</div>";
            }).join("") + "</div>" +
            '<div class="nb-bars nb-mt">' + bar("Yes", r.post.Yes, "var(--nb-yes)", pct(r.post.Yes)) + bar("No", r.post.No, "var(--nb-no)", pct(r.post.No)) + "</div>" +
            '<div class="nb-verdict">Prediction: Play Golf = ' + r.pred + " (" + pct(r.post[r.pred]) + " confidence)</div>";
          if (sv.guess) {
            body += sv.guess === r.pred
              ? '<div class="nb-callout ok nb-mt">Your prediction was correct.</div>'
              : '<div class="nb-callout warn nb-mt">You predicted ' + sv.guess + ". Compare the two scores in Step 4 to see why " + r.pred + " wins.</div>";
          }
          if (r.score.No === 0 || r.score.Yes === 0) {
            body += '<div class="nb-callout amber nb-mt">One class has probability exactly 0 only because a value was never seen with it. Try Laplace smoothing.</div>';
          }
        }
      }
    }
    $("#sv-body").innerHTML = body;
    $$("#sv-body [data-g]").forEach(function (b) {
      b.addEventListener("click", function () { sv.guess = b.getAttribute("data-g"); renderSolver(); });
    });
  }

  // ================================================================ 3. GAUSSIAN
  var ga = {};
  (function initGauss() {
    ga.x = slider($("#ga-x"), "ga-x", "New value <i>x</i> (cm)", 145, 200, 1, 167, drawGauss);
    var c = $("#ga-sliders");
    var g1 = document.createElement("div"); g1.className = "nb-slidergroup"; g1.textContent = "Class A"; c.appendChild(g1);
    ga.ma = slider(c, "ga-ma", "Mean <i>μ</i><sub>A</sub>", 150, 195, 1, 163, drawGauss, "yes");
    ga.sa = slider(c, "ga-sa", "Std. dev. <i>σ</i><sub>A</sub>", 2, 12, 0.5, 6, drawGauss, "yes");
    var g2 = document.createElement("div"); g2.className = "nb-slidergroup"; g2.textContent = "Class B"; c.appendChild(g2);
    ga.mb = slider(c, "ga-mb", "Mean <i>μ</i><sub>B</sub>", 150, 195, 1, 178, drawGauss, "no");
    ga.sb = slider(c, "ga-sb", "Std. dev. <i>σ</i><sub>B</sub>", 2, 12, 0.5, 5, drawGauss, "no");
    var g3 = document.createElement("div"); g3.className = "nb-slidergroup"; g3.textContent = "Prior"; c.appendChild(g3);
    ga.pa = slider(c, "ga-pa", "<i>P</i>(A)", 0.1, 0.9, 0.05, 0.5, drawGauss);
    drawGauss();
  })();
  function pdf(x, mu, s) { return Math.exp(-((x - mu) * (x - mu)) / (2 * s * s)) / Math.sqrt(2 * Math.PI * s * s); }
  function drawGauss() {
    if (!ga.x) return;
    var x = +ga.x.input.value, ma = +ga.ma.input.value, sa = +ga.sa.input.value, mb = +ga.mb.input.value, sb = +ga.sb.input.value, pa = +ga.pa.input.value;
    var W = 640, H = 300, L = 46, R = 16, T = 14, B = 40, x0 = 145, x1 = 200;
    var ymax = Math.max(pdf(ma, ma, sa), pdf(mb, mb, sb)) * 1.12;
    var sx = function (v) { return L + (v - x0) / (x1 - x0) * (W - L - R); };
    var sy = function (v) { return H - B - v / ymax * (H - T - B); };
    var path = function (mu, s) {
      var d = "";
      for (var v = x0; v <= x1 + 1e-9; v += 0.25) d += (d ? "L" : "M") + sx(v).toFixed(1) + "," + sy(pdf(v, mu, s)).toFixed(1);
      return d;
    };
    var cs = getComputedStyle(root);
    var cy = cs.getPropertyValue("--nb-yes").trim(), cn = cs.getPropertyValue("--nb-no").trim(), cl = cs.getPropertyValue("--nb-line").trim(), ci = cs.getPropertyValue("--nb-ink").trim();
    var ticks = "";
    for (var t = 150; t <= 200; t += 10) ticks += '<line x1="' + sx(t) + '" x2="' + sx(t) + '" y1="' + (H - B) + '" y2="' + (H - B + 5) + '" stroke="' + cl + '"/><text x="' + sx(t) + '" y="' + (H - B + 18) + '" text-anchor="middle">' + t + "</text>";
    var la = pdf(x, ma, sa), lb = pdf(x, mb, sb);
    $("#ga-svg").innerHTML =
      '<line x1="' + L + '" x2="' + (W - R) + '" y1="' + (H - B) + '" y2="' + (H - B) + '" stroke="' + cl + '"/>' + ticks +
      '<text x="' + ((L + W - R) / 2) + '" y="' + (H - 6) + '" text-anchor="middle">Height (cm)</text>' +
      '<path d="' + path(ma, sa) + '" fill="none" stroke="' + cy + '" stroke-width="3"/>' +
      '<path d="' + path(mb, sb) + '" fill="none" stroke="' + cn + '" stroke-width="3"/>' +
      '<line x1="' + sx(x) + '" x2="' + sx(x) + '" y1="' + (H - B) + '" y2="' + T + '" stroke="' + ci + '" stroke-dasharray="4 4" opacity=".6"/>' +
      '<circle cx="' + sx(x) + '" cy="' + sy(la) + '" r="6" fill="' + cy + '"/>' +
      '<circle cx="' + sx(x) + '" cy="' + sy(lb) + '" r="6" fill="' + cn + '"/>' +
      '<text x="' + (L + 8) + '" y="' + (T + 12) + '" style="fill:' + cy + ';font-weight:700">Class A</text>' +
      '<text x="' + (L + 8) + '" y="' + (T + 30) + '" style="fill:' + cn + ';font-weight:700">Class B</text>' +
      '<text x="' + (sx(x) + 6) + '" y="' + (H - B - 6) + '">x = ' + x + "</text>";
    var sA = pa * la, sB = (1 - pa) * lb, tot = sA + sB;
    var pA = tot > 0 ? sA / tot : 0.5, pB = 1 - pA;
    $("#ga-calc").innerHTML =
      '<div class="nb-formula">' + m("<i>P</i>(<i>x</i> | <i>y</i>) = " + frac("1", "√(2π<i>σ</i><sub><i>y</i></sub>²)") +
        " exp(−" + frac("(<i>x</i> − <i>μ</i><sub><i>y</i></sub>)²", "2<i>σ</i><sub><i>y</i></sub>²") + ")") + "</div>" +
      '<div class="nb-calc"><div class="nb-calcrow yes"><span class="lbl">Class A</span>' +
        m("<i>P</i>(<i>x</i> | A) = " + fmt(la, 4) + ", score = " + fmt(pa, 2) + " × " + fmt(la, 4) + " = <b>" + fmt(sA, 4) + "</b>") + "</div>" +
      '<div class="nb-calcrow no"><span class="lbl">Class B</span>' +
        m("<i>P</i>(<i>x</i> | B) = " + fmt(lb, 4) + ", score = " + fmt(1 - pa, 2) + " × " + fmt(lb, 4) + " = <b>" + fmt(sB, 4) + "</b>") + "</div></div>";
    $("#ga-bars").innerHTML = '<div class="nb-bars">' + bar("P(A | x)", pA, "var(--nb-yes)", pct(pA)) + bar("P(B | x)", pB, "var(--nb-no)", pct(pB)) + "</div>" +
      '<div class="nb-verdict">Prediction: Class ' + (pA >= pB ? "A" : "B") + "</div>" +
      '<p class="nb-small nb-mt">Training only needs the mean and standard deviation of each class. Try moving <i>x</i> to where the two curves cross.</p>';
  }

  // ================================================================ 4. QUIZ
  var qz = { right: 0, total: 0, cur: null };
  function rnd(a) { return a[Math.floor(Math.random() * a.length)]; }
  function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
  function newQuestion() {
    var q = FEATS.map(function (f) { return rnd(f.values); });
    var lap = Math.random() < 0.4;
    var fi = Math.floor(Math.random() * 4), c = rnd(CLASSES);
    var r = solve(q, lap), l = r.lik[c][fi], nc = classSize(c), other = 14 - nc;
    var correct = l.num + "/" + l.den;
    var pool = [correct, l.cnt + "/14", (l.cnt) + "/" + other, lap ? l.cnt + "/" + nc : (l.cnt + 1) + "/" + (nc + l.k), (l.cnt + 1) + "/" + nc, l.cnt + "/" + (nc + l.k)];
    var opts = [];
    pool.forEach(function (o) { if (opts.indexOf(o) < 0 && opts.length < 4) opts.push(o); });
    qz.cur = { q: q, lap: lap, fi: fi, c: c, r: r, correct: correct, opts: shuffle(opts), a1: null, a2: null };
    renderQuiz();
  }
  function renderQuiz() {
    var k = qz.cur, r = k.r;
    $("#qz-query").innerHTML = "<b>New day:</b> " + k.q.map(function (v, i) { return '<span class="nb-pill">' + FEATS[i].key + " = " + v + "</span>"; }).join(" ") +
      '<div class="nb-small" style="margin-top:.3rem">Laplace smoothing: <b>' + (k.lap ? "on" : "off") + "</b></div>";
    $("#qz-score").textContent = "Score: " + qz.right + " / " + qz.total;
    var f = FEATS[k.fi];
    var h = '<div class="nb-q"><b>Question 1.</b> What is ' + m("<i>P</i>(" + f.key + " = " + k.q[k.fi] + " | " + k.c + ")") + "?" +
      '<div class="nb-opts">' + k.opts.map(function (o) {
        var p = o.split("/"), st = "";
        if (k.a1) st = o === k.correct ? " right" : o === k.a1 ? " wrong" : "";
        return '<button type="button" class="nb-btn nb-opt' + st + '" data-a1="' + o + '"' + (k.a1 ? " disabled" : "") + ">" + m(frac(p[0], p[1])) + "</button>";
      }).join("") + "</div>";
    if (k.a1) {
      var l = r.lik[k.c][k.fi];
      h += '<div class="nb-hint">' + (k.a1 === k.correct ? "Correct. " : "Not quite. ") + f.key + " = " + k.q[k.fi] + " appears " + l.cnt + " times among the " +
        classSize(k.c) + " " + k.c + " days" + (k.lap ? "; with smoothing add 1 to the count and " + l.k + " (number of " + f.key + " values) to the denominator." : ", so divide by " + classSize(k.c) + ".") + "</div>";
    }
    h += "</div>";
    if (k.a1) {
      h += '<div class="nb-q"><b>Question 2.</b> Which class does Naïve Bayes predict for this day?' +
        '<div class="nb-opts">' + ["Yes", "No"].map(function (o) {
          var st = "";
          if (k.a2) st = o === r.pred ? " right" : o === k.a2 ? " wrong" : "";
          return '<button type="button" class="nb-btn nb-opt' + st + '" data-a2="' + o + '"' + (k.a2 ? " disabled" : "") + ">" + o + "</button>";
        }).join("") + "</div></div>";
    }
    if (k.a2) {
      h += '<div class="nb-q"><b>Full solution</b><div class="nb-calc" style="margin-top:.4rem">' + CLASSES.map(function (c) {
        var terms = [frac(r.prior[c].n, r.prior[c].d)].concat(r.lik[c].map(function (l) { return frac(l.num, l.den); }));
        return '<div class="nb-calcrow ' + c.toLowerCase() + '"><span class="lbl">Score(' + c + ")</span>" + m(terms.join(" × ") + " ≈ <b>" + fmt(r.score[c], 4) + "</b>") + "</div>";
      }).join("") + "</div>";
      if (r.pred) {
        h += '<div class="nb-bars nb-mt">' + bar("Yes", r.post.Yes, "var(--nb-yes)", pct(r.post.Yes)) + bar("No", r.post.No, "var(--nb-no)", pct(r.post.No)) + "</div>";
      }
      if (!k.lap && (r.score.Yes === 0 || r.score.No === 0)) {
        h += '<div class="nb-callout warn nb-mt">A score is exactly 0 because one value never appeared with that class. Laplace smoothing would avoid this.</div>';
      }
      h += "</div>";
    }
    $("#qz-body").innerHTML = h;
    $$("#qz-body [data-a1]").forEach(function (b) {
      b.addEventListener("click", function () { if (k.a1) return; k.a1 = b.getAttribute("data-a1"); qz.total++; if (k.a1 === k.correct) qz.right++; renderQuiz(); });
    });
    $$("#qz-body [data-a2]").forEach(function (b) {
      b.addEventListener("click", function () { if (k.a2) return; k.a2 = b.getAttribute("data-a2"); qz.total++; if (k.a2 === r.pred) qz.right++; renderQuiz(); });
    });
  }
  $("#qz-new").addEventListener("click", newQuestion);
  newQuestion();
})();
</script>
