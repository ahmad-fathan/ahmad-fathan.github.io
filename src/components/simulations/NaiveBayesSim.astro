---
// Naive Bayes interactive simulation, organized as a guided path:
// Part A (theory) -> Part B (worked examples) -> Part C (practice).
// All page content is generated by the inline script below, and every number
// on screen is computed from the data it holds, never typed by hand.
---

<div class="nbsim" data-theme="light" id="nbsim">
  <div class="nb-top">
    <nav class="nb-progress" id="nb-progress" aria-label="Chapters"></nav>
    <button type="button" class="nb-btn nb-ghost nb-sm" id="nb-theme" aria-label="Toggle dark mode">Dark mode</button>
  </div>
  <div class="nb-bar-progress" aria-hidden="true"><span id="nb-progress-fill"></span></div>
  <div id="nb-pages"></div>
  <div class="nb-pagenav">
    <button type="button" class="nb-btn" id="nb-prev"></button>
    <button type="button" class="nb-btn nb-primary" id="nb-next"></button>
  </div>
  <div class="nb-pop" id="nb-pop" role="tooltip" hidden></div>
</div>

<style is:global>
  .nbsim {
    --nb-bg: #ffffff;
    --nb-card: #ffffff;
    --nb-soft: #f8fafc;
    --nb-ink: #0f172a;
    --nb-muted: #5b6573;
    --nb-line: #e2e8f0;
    --nb-primary: #2563eb;
    --nb-primary-soft: #eff6ff;
    --nb-yes: #2563eb;
    --nb-yes-soft: #dbeafe;
    --nb-no: #d97706;
    --nb-no-soft: #fff7ed;
    --nb-hl: #fef9c3;
    --nb-bad: #dc2626;
    --nb-bad-soft: #fef2f2;
    --nb-good: #16a34a;
    --nb-good-soft: #f0fdf4;
    --nb-purple: #7c3aed;
    --nb-teal: #0d9488;
    position: relative;
    background: var(--nb-bg);
    color: var(--nb-ink);
    border-radius: 0.9rem;
    font-size: 1rem;
    line-height: 1.65;
  }
  .nbsim[data-theme="dark"] {
    --nb-bg: #0b1220;
    --nb-card: #111a2e;
    --nb-soft: #16213a;
    --nb-ink: #e5e9f0;
    --nb-muted: #9aa6b8;
    --nb-line: #26324a;
    --nb-primary: #60a5fa;
    --nb-primary-soft: #172554;
    --nb-yes: #60a5fa;
    --nb-yes-soft: #172554;
    --nb-no: #fbbf24;
    --nb-no-soft: #2a2110;
    --nb-hl: #3a3410;
    --nb-bad: #f87171;
    --nb-bad-soft: #2a1414;
    --nb-good: #4ade80;
    --nb-good-soft: #10261a;
    --nb-purple: #a78bfa;
    --nb-teal: #2dd4bf;
    padding: 1rem;
  }
  .nbsim * { box-sizing: border-box; }
  .nbsim p { margin: 0 0 0.75rem; }
  .nbsim { scroll-margin-top: 5.5rem; }
  .nbsim ul.nb-text { list-style: disc; padding-left: 1.4rem; margin: 0 0 0.9rem; }
  .nbsim ul.nb-text li { margin: 0.15rem 0; }
  .nbsim ul.nb-text li::marker { color: var(--nb-primary); }

  /* ---- progress navigation ---- */
  .nbsim .nb-top { display: flex; gap: 0.75rem; align-items: flex-start; justify-content: space-between; }
  .nbsim .nb-progress { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; }
  .nbsim .nb-part { display: flex; flex-direction: column; gap: 0.3rem; }
  .nbsim .nb-partlabel { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--nb-muted); }
  .nbsim .nb-part.on .nb-partlabel { color: var(--nb-primary); }
  .nbsim .nb-chaps { display: flex; gap: 0.3rem; }
  .nbsim .nb-chap { width: 2rem; height: 2rem; border-radius: 999px; border: 1px solid var(--nb-line); background: var(--nb-card); color: var(--nb-muted); font-size: 0.8rem; font-weight: 700; cursor: pointer; }
  .nbsim .nb-chap.done { border-color: var(--nb-primary); color: var(--nb-primary); }
  .nbsim .nb-chap[aria-current="page"] { background: var(--nb-primary); border-color: var(--nb-primary); color: #fff; }
  .nbsim[data-theme="dark"] .nb-chap[aria-current="page"] { color: #0b1220; }
  .nbsim .nb-bar-progress { height: 4px; background: var(--nb-line); border-radius: 999px; margin: 0.9rem 0 1.4rem; overflow: hidden; }
  .nbsim .nb-bar-progress span { display: block; height: 100%; background: var(--nb-primary); width: 0; transition: width 0.3s ease; }

  /* ---- page ---- */
  .nbsim .nb-eyebrow { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--nb-primary); margin-bottom: 0.2rem; }
  .nbsim .nb-h2 { font-size: 1.55rem; font-weight: 750; letter-spacing: -0.015em; margin: 0 0 0.6rem; line-height: 1.25; }
  .nbsim .nb-h3 { font-size: 1.05rem; font-weight: 700; margin: 0 0 0.5rem; }
  .nbsim .nb-lead { font-size: 1.08rem; max-width: 46rem; }
  .nbsim .nb-text { max-width: 46rem; }
  .nbsim .nb-small { font-size: 0.86rem; color: var(--nb-muted); }
  .nbsim .nb-mt { margin-top: 1rem; }
  .nbsim .nb-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .nbsim .nb-solver { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr); }
  .nbsim .nb-card { background: var(--nb-card); border: 1px solid var(--nb-line); border-radius: 0.75rem; padding: 1rem 1.15rem; min-width: 0; }
  .nbsim .nb-plain { border-left: 4px solid var(--nb-teal); background: var(--nb-soft); border-radius: 0.5rem; padding: 0.75rem 1rem; margin: 1rem 0; max-width: 46rem; }
  .nbsim .nb-plain b.tag { display: block; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--nb-teal); margin-bottom: 0.15rem; }
  .nbsim .nb-pagenav { display: flex; justify-content: space-between; gap: 0.75rem; margin-top: 1.8rem; padding-top: 1.1rem; border-top: 1px solid var(--nb-line); }
  .nbsim .nb-pagenav .nb-btn { max-width: 48%; }
  .nbsim .nb-pagenav #nb-next { margin-left: auto; }

  /* ---- buttons & inputs ---- */
  .nbsim .nb-btn { font: inherit; font-size: 0.92rem; font-weight: 600; padding: 0.5rem 0.95rem; border-radius: 0.5rem; border: 1px solid var(--nb-line); background: var(--nb-card); color: var(--nb-ink); cursor: pointer; line-height: 1.35; }
  .nbsim .nb-btn:hover { background: var(--nb-soft); }
  .nbsim .nb-btn:disabled { opacity: 0.45; cursor: default; }
  .nbsim .nb-btn[hidden] { display: none; }
  .nbsim .nb-primary { background: var(--nb-primary); border-color: var(--nb-primary); color: #fff; }
  .nbsim[data-theme="dark"] .nb-primary { color: #0b1220; }
  .nbsim .nb-primary:hover { background: var(--nb-primary); filter: brightness(0.93); }
  .nbsim .nb-ghost { background: transparent; white-space: nowrap; }
  .nbsim .nb-sm { font-size: 0.8rem; padding: 0.3rem 0.65rem; }
  .nbsim .nb-row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .nbsim select { font: inherit; font-size: 0.95rem; color: var(--nb-ink); background: var(--nb-soft); border: 1px solid var(--nb-line); border-radius: 0.45rem; padding: 0.3rem 0.5rem; margin-top: 0.15rem; }
  .nbsim label.nb-sel { display: flex; flex-direction: column; font-size: 0.8rem; color: var(--nb-muted); font-weight: 600; }
  .nbsim .nb-switch { display: inline-flex; gap: 0.4rem; align-items: center; font-size: 0.9rem; cursor: pointer; }
  .nbsim .nb-switch input { accent-color: var(--nb-primary); width: 1rem; height: 1rem; }
  .nbsim details.nb-more { margin-top: 1rem; border: 1px dashed var(--nb-line); border-radius: 0.6rem; padding: 0.6rem 0.9rem; }
  .nbsim details.nb-more summary { cursor: pointer; font-weight: 600; color: var(--nb-primary); }
  .nbsim details.nb-more[open] summary { margin-bottom: 0.6rem; }

  /* ---- glossary terms ---- */
  .nbsim .nb-term { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: help; border-bottom: 2px dotted var(--nb-primary); font-weight: 600; }
  .nbsim .nb-term:hover, .nbsim .nb-term:focus-visible { color: var(--nb-primary); outline: none; }
  .nbsim .nb-pop { position: absolute; z-index: 30; max-width: 20rem; background: var(--nb-ink); color: var(--nb-bg); border-radius: 0.6rem; padding: 0.65rem 0.85rem; font-size: 0.9rem; line-height: 1.5; box-shadow: 0 10px 30px rgba(0,0,0,0.18); }
  .nbsim .nb-pop b { display: block; margin-bottom: 0.15rem; }

  /* ---- check yourself ---- */
  .nbsim .nb-check { margin-top: 1.4rem; border: 1px solid var(--nb-line); border-radius: 0.75rem; padding: 0.9rem 1.1rem; background: var(--nb-soft); max-width: 46rem; }
  .nbsim .nb-check .q { font-weight: 600; margin-bottom: 0.5rem; }
  .nbsim .nb-check .q::before { content: "Check yourself: "; color: var(--nb-primary); font-weight: 700; }
  .nbsim .nb-opts { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .nbsim .nb-opt:disabled { opacity: 0.6; }
  .nbsim .nb-opt.right, .nbsim .nb-opt.right:disabled { opacity: 1; background: var(--nb-good-soft); border-color: var(--nb-good); }
  .nbsim .nb-opt.wrong, .nbsim .nb-opt.wrong:disabled { opacity: 1; background: var(--nb-bad-soft); border-color: var(--nb-bad); }
  .nbsim .nb-fb { margin-top: 0.6rem; font-size: 0.93rem; }
  .nbsim .nb-fb.ok::before { content: "✓ Correct. "; color: var(--nb-good); font-weight: 700; }
  .nbsim .nb-fb.no::before { content: "✗ Not quite. "; color: var(--nb-bad); font-weight: 700; }

  /* ---- diagrams ---- */
  .nbsim .nb-flow { display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.5rem; margin: 1rem 0; }
  .nbsim .nb-node { flex: 1 1 9rem; border: 1.5px solid var(--nb-line); border-radius: 0.7rem; padding: 0.7rem 0.8rem; background: var(--nb-card); text-align: center; }
  .nbsim .nb-node b { display: block; font-size: 0.98rem; }
  .nbsim .nb-node > span { display: block; font-size: 0.85rem; color: var(--nb-muted); line-height: 1.45; margin-top: 0.15rem; }
  .nbsim .nb-node.blue { border-color: var(--nb-yes); background: var(--nb-primary-soft); }
  .nbsim .nb-node.amber { border-color: var(--nb-no); background: var(--nb-no-soft); }
  .nbsim .nb-node.purple { border-color: var(--nb-purple); }
  .nbsim .nb-node.teal { border-color: var(--nb-teal); }
  .nbsim .nb-node .num { display: inline-flex; width: 1.6rem; height: 1.6rem; border-radius: 999px; align-items: center; justify-content: center; background: var(--nb-primary); color: #fff; font-weight: 700; font-size: 0.85rem; margin: 0 auto 0.3rem; }
  .nbsim[data-theme="dark"] .nb-node .num { color: #0b1220; }
  .nbsim .nb-arrow { align-self: center; color: var(--nb-muted); font-size: 1.3rem; font-weight: 700; }
  .nbsim .nb-groups { display: flex; gap: 0.5rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .nbsim .nb-groups span { border-top: 3px solid var(--nb-yes); padding-top: 0.25rem; color: var(--nb-yes); }
  .nbsim .nb-groups span.pred { border-color: var(--nb-no); color: var(--nb-no); }
  .nbsim .nb-tiles { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 0.35rem; max-width: 34rem; margin: 0.8rem 0; }
  .nbsim .nb-tile { aspect-ratio: 1; border-radius: 0.4rem; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700; border: 1.5px solid var(--nb-line); }
  .nbsim .nb-tile.rain { background: var(--nb-yes-soft); border-color: var(--nb-yes); color: var(--nb-yes); }
  .nbsim .nb-tile.dry { background: var(--nb-soft); color: var(--nb-muted); }
  .nbsim .c-post { color: var(--nb-purple); font-weight: 700; }
  .nbsim .c-lik { color: var(--nb-teal); font-weight: 700; }
  .nbsim .c-pri { color: var(--nb-yes); font-weight: 700; }
  .nbsim .c-ev { color: var(--nb-no); font-weight: 700; }

  /* ---- emails ---- */
  .nbsim .nb-mails { display: grid; grid-template-columns: repeat(auto-fill, minmax(4.6rem, 1fr)); gap: 0.6rem; margin: 0.9rem 0; }
  .nbsim .nb-mail { position: relative; border-radius: 0.5rem; border: 1.5px solid; padding: 0.55rem 0.3rem 0.4rem; text-align: center; font-size: 0.72rem; font-weight: 700; transition: opacity 0.35s ease, transform 0.35s ease; }
  .nbsim .nb-mail svg { display: block; margin: 0 auto 0.2rem; width: 1.6rem; height: 1.2rem; }
  .nbsim .nb-mail.spam { border-color: var(--nb-no); background: var(--nb-no-soft); color: var(--nb-no); }
  .nbsim .nb-mail.ham { border-color: var(--nb-yes); background: var(--nb-primary-soft); color: var(--nb-yes); }
  .nbsim .nb-mail .free { position: absolute; top: -0.6rem; right: -0.35rem; background: var(--nb-ink); color: var(--nb-bg); border-radius: 999px; font-size: 0.62rem; padding: 0.05rem 0.4rem; }
  .nbsim .nb-mail.out { opacity: 0.15; transform: scale(0.9); }
  .nbsim .nb-legend { display: flex; flex-wrap: wrap; gap: 0.8rem; font-size: 0.85rem; color: var(--nb-muted); }
  .nbsim .nb-legend i { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 0.2rem; vertical-align: -1px; margin-right: 0.3rem; border: 1.5px solid; }

  /* ---- math ---- */
  .nbsim .nb-math { font-family: "STIX Two Math", "Cambria Math", "Latin Modern Math", "Times New Roman", serif; font-size: 1.08em; }
  .nbsim .frac { display: inline-flex; flex-direction: column; vertical-align: middle; text-align: center; margin: 0 0.12em; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .nbsim .frac > span:first-child { border-bottom: 1px solid currentColor; padding: 0 0.15em; }
  .nbsim .frac > span:last-child { padding: 0 0.15em; }
  .nbsim .nb-formula { text-align: center; padding: 0.8rem; background: var(--nb-soft); border-radius: 0.6rem; margin: 0.8rem 0; overflow-x: auto; font-size: 1.15rem; }
  .nbsim .nb-labels { display: grid; gap: 0.35rem; max-width: 46rem; margin: 0.4rem 0 0.6rem; padding: 0; list-style: none; }
  .nbsim .nb-labels li { display: grid; grid-template-columns: 9rem 1fr; gap: 0.6rem; font-size: 0.95rem; }
  .nbsim .nb-calc { display: grid; gap: 0.5rem; }
  .nbsim .nb-calcrow { padding: 0.55rem 0.75rem; border-radius: 0.5rem; border: 1px solid var(--nb-line); overflow-x: auto; white-space: nowrap; }
  .nbsim .nb-calcrow.yes { border-left: 4px solid var(--nb-yes); }
  .nbsim .nb-calcrow.no { border-left: 4px solid var(--nb-no); }
  .nbsim .nb-calcrow .lbl { display: block; font-size: 0.78rem; font-weight: 700; color: var(--nb-muted); white-space: normal; }

  /* ---- tables & bars ---- */
  .nbsim .nb-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; font-variant-numeric: tabular-nums; }
  .nbsim .nb-table th, .nbsim .nb-table td { padding: 0.3rem 0.45rem; border-bottom: 1px solid var(--nb-line); text-align: center; transition: background 0.15s ease; }
  .nbsim .nb-table th { font-weight: 700; background: var(--nb-soft); }
  .nbsim .nb-table td:first-child, .nbsim .nb-table th:first-child { text-align: left; }
  .nbsim .nb-scroll { overflow-x: auto; }
  .nbsim .nb-data td.lab-yes { color: var(--nb-yes); font-weight: 700; }
  .nbsim .nb-data td.lab-no { color: var(--nb-no); font-weight: 700; }
  .nbsim .nb-table td.hl { background: var(--nb-hl); font-weight: 700; }
  .nbsim .nb-table .dimcol { opacity: 0.3; }
  .nbsim .nb-table tr.scan td { box-shadow: inset 0 2px 0 var(--nb-primary), inset 0 -2px 0 var(--nb-primary); }
  .nbsim .nb-table td.zero { background: var(--nb-bad-soft); color: var(--nb-bad); font-weight: 700; }
  .nbsim .nb-table td.new { background: var(--nb-good-soft); font-weight: 700; }
  .nbsim .nb-bars { display: grid; gap: 0.45rem; }
  .nbsim .nb-bar { display: grid; grid-template-columns: 6.5rem 1fr 4.4rem; gap: 0.5rem; align-items: center; font-size: 0.9rem; }
  .nbsim .nb-bar .track { height: 1.1rem; background: var(--nb-soft); border-radius: 999px; overflow: hidden; border: 1px solid var(--nb-line); }
  .nbsim .nb-bar .fill { display: block; height: 100%; border-radius: 999px; transition: width 0.4s ease; }
  .nbsim .nb-bar .val { text-align: right; font-variant-numeric: tabular-nums; font-weight: 700; }
  .nbsim .nb-callout { padding: 0.65rem 0.85rem; border-radius: 0.5rem; background: var(--nb-primary-soft); font-size: 0.94rem; margin-top: 0.8rem; }
  .nbsim .nb-callout.warn { background: var(--nb-bad-soft); border-left: 4px solid var(--nb-bad); }
  .nbsim .nb-callout.ok { background: var(--nb-good-soft); border-left: 4px solid var(--nb-good); }
  .nbsim .nb-verdict { font-size: 1.08rem; font-weight: 700; padding: 0.7rem 0.9rem; border-radius: 0.5rem; background: var(--nb-primary); color: #fff; margin-top: 0.8rem; }
  .nbsim[data-theme="dark"] .nb-verdict { color: #0b1220; }
  .nbsim .nb-pill { display: inline-block; padding: 0.05rem 0.55rem; border-radius: 999px; background: var(--nb-soft); border: 1px solid var(--nb-line); font-weight: 600; font-size: 0.9rem; margin: 0.1rem 0.1rem; }

  /* ---- solver ---- */
  .nbsim .nb-stepchip { display: inline-block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--nb-primary); background: var(--nb-primary-soft); border-radius: 999px; padding: 0.15rem 0.6rem; margin-bottom: 0.5rem; }
  .nbsim .nb-stepcard { min-height: 26rem; }
  .nbsim .nb-what { display: grid; grid-template-columns: 2.6rem 1fr; gap: 0.2rem 0.6rem; font-size: 0.95rem; margin-bottom: 0.8rem; padding-bottom: 0.7rem; border-bottom: 1px solid var(--nb-line); }
  .nbsim .nb-what b { color: var(--nb-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; padding-top: 0.2rem; }
  .nbsim .nb-controls { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-top: 1rem; }
  .nbsim .nb-dots { display: flex; gap: 0.35rem; margin-left: auto; }
  .nbsim .nb-dot { width: 1.9rem; height: 1.9rem; border-radius: 999px; border: 1px solid var(--nb-line); background: var(--nb-card); color: var(--nb-muted); font-size: 0.8rem; font-weight: 700; cursor: pointer; }
  .nbsim .nb-dot[aria-current="step"] { background: var(--nb-primary); border-color: var(--nb-primary); color: #fff; }
  .nbsim .nb-dot.done { color: var(--nb-primary); border-color: var(--nb-primary); }
  .nbsim .nb-counter { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin: 0.7rem 0; }
  .nbsim .nb-counter div { border-radius: 0.6rem; padding: 0.5rem; text-align: center; border: 1.5px solid; font-size: 0.85rem; font-weight: 600; }
  .nbsim .nb-counter div b { display: block; font-size: 1.9rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .nbsim .nb-counter .y { border-color: var(--nb-yes); background: var(--nb-primary-soft); color: var(--nb-yes); }
  .nbsim .nb-counter .n { border-color: var(--nb-no); background: var(--nb-no-soft); color: var(--nb-no); }
  .nbsim .nb-feats { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.6rem; }
  .nbsim .nb-feat[aria-pressed="true"] { border-color: var(--nb-primary); color: var(--nb-primary); background: var(--nb-primary-soft); }
  .nbsim .nb-feat.ok::after { content: " ✓"; color: var(--nb-good); }

  /* ---- sliders & svg ---- */
  .nbsim .nb-sliders { display: grid; gap: 0.55rem; }
  .nbsim .nb-slider { display: grid; grid-template-columns: 9.5rem 1fr 3rem; gap: 0.6rem; align-items: center; font-size: 0.9rem; }
  .nbsim .nb-slider input[type="range"] { width: 100%; accent-color: var(--nb-primary); }
  .nbsim .nb-slider output { text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }
  .nbsim .nb-slider.no input[type="range"] { accent-color: var(--nb-no); }
  .nbsim .nb-slider.no span:first-child { color: var(--nb-no); font-weight: 600; }
  .nbsim .nb-slider.yes span:first-child { color: var(--nb-yes); font-weight: 600; }
  .nbsim .nb-slidergroup { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--nb-muted); margin-top: 0.4rem; }
  .nbsim svg text { fill: var(--nb-muted); font-size: 12px; }

  /* ---- quiz ---- */
  .nbsim .nb-quizhead { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; align-items: center; margin-bottom: 0.4rem; }
  .nbsim .nb-score { font-weight: 700; color: var(--nb-primary); }
  .nbsim .nb-q { margin-top: 1rem; }
  .nbsim .nb-hint { font-size: 0.92rem; margin-top: 0.5rem; padding: 0.5rem 0.7rem; border-radius: 0.45rem; background: var(--nb-hl); }

  @media (max-width: 860px) {
    .nbsim .nb-grid2, .nbsim .nb-solver { grid-template-columns: 1fr; }
    .nbsim .nb-solver .nb-stepcard { order: -1; min-height: 0; }
    .nbsim .nb-data { font-size: 0.78rem; }
    .nbsim .nb-data th, .nbsim .nb-data td { padding: 0.25rem 0.3rem; }
    .nbsim .nb-dots { margin-left: 0; }
    .nbsim .nb-slider { grid-template-columns: 7.5rem 1fr 2.6rem; }
    .nbsim .nb-labels li { grid-template-columns: 6.5rem 1fr; }
    .nbsim .nb-arrow { display: none; }
    .nbsim .nb-top { flex-direction: column-reverse; }
    .nbsim .nb-h2 { font-size: 1.3rem; }
    .nbsim .nb-pagenav .nb-btn { font-size: 0.82rem; }
  }
</style>

<script is:inline>
(function () {
  "use strict";
  var root = document.getElementById("nbsim");
  if (!root) return;
  var $ = function (sel, el) { return (el || root).querySelector(sel); };
  var $$ = function (sel, el) { return Array.prototype.slice.call((el || root).querySelectorAll(sel)); };

  // ================================================================ helpers
  function frac(n, d) { return '<span class="frac"><span>' + n + "</span><span>" + d + "</span></span>"; }
  function m(s) { return '<span class="nb-math">' + s + "</span>"; }
  function fmt(x, k) {
    if (!isFinite(x)) return "–";
    if (x === 0) return "0";
    var t = Math.abs(x) >= 1 ? x.toFixed(2) : x.toPrecision(k || 4);
    return t.indexOf(".") >= 0 ? t.replace(/0+$/, "").replace(/\.$/, "") : t;
  }
  function pct(x) { return (x * 100).toFixed(1) + "%"; }
  function bar(label, value, color, shown) {
    var w = Math.max(0, Math.min(1, value)) * 100;
    return '<div class="nb-bar"><span>' + label + '</span><span class="track"><span class="fill" style="width:' + w +
      "%;background:" + color + '"></span></span><span class="val">' + (shown != null ? shown : fmt(value, 3)) + "</span></div>";
  }
  var Y = '<span style="color:var(--nb-yes);font-weight:700">Yes</span>';
  var N = '<span style="color:var(--nb-no);font-weight:700">No</span>';
  function cls(c) { return c === "Yes" ? Y : N; }
  function plain(html) { return '<div class="nb-plain"><b class="tag">In plain words</b>' + html + "</div>"; }
  function pill(t) { return '<span class="nb-pill">' + t + "</span>"; }
  function slider(container, id, label, min, max, step, value, onInput, kind) {
    var wrap = document.createElement("label");
    wrap.className = "nb-slider" + (kind ? " " + kind : "");
    wrap.innerHTML = "<span>" + label + '</span><input type="range" id="' + id + '" min="' + min + '" max="' + max +
      '" step="' + step + '" value="' + value + '"><output>' + value + "</output>";
    container.appendChild(wrap);
    var input = wrap.querySelector("input"), out = wrap.querySelector("output");
    input.addEventListener("input", function () { out.textContent = input.value; onInput(); });
    return { input: input, set: function (v) { input.value = v; out.textContent = v; }, get: function () { return +input.value; } };
  }

  // ================================================================ glossary
  var GLOSS = {
    classification: ["Classification", "Putting a new item into one of a few groups, for example spam or not spam."],
    "class": ["Class", "One of the groups we can choose from. In the golf example the classes are Yes and No."],
    feature: ["Feature (clue)", "A piece of information about an item that helps us decide its class, such as Outlook or Wind."],
    training: ["Training data", "Examples whose class we already know. The model learns from them by counting."],
    probability: ["Probability", "A number from 0 to 1 that says how likely something is. 0 means impossible, 1 means certain."],
    conditional: ["Conditional probability", "The chance of something when we already know something else. P(rain | cloudy) is read \"the probability of rain, given that it is cloudy\"."],
    prior: ["Prior", "What we believe about a class before looking at the clues. Usually the share of that class in the training data."],
    likelihood: ["Likelihood", "How well a clue fits a class: how often that clue appears among the examples of that class."],
    evidence: ["Evidence", "How common the clue is overall. It is the same for every class, so it does not change which class wins."],
    posterior: ["Posterior", "What we believe about a class after seeing the clues. This is the answer we want."],
    score: ["Score", "Prior multiplied by all the likelihoods. The class with the highest score wins."],
    normalize: ["Normalize", "Divide each score by the total of all scores, so that the results add up to 1 and can be read as probabilities."],
    laplace: ["Laplace smoothing", "Add 1 to every count, so that no probability is ever exactly 0."],
    naive: ["Naive assumption", "Treat each clue as if it does not affect the others, once the class is known. This lets us count clues one at a time."],
  };
  function term(word, key) { return '<button type="button" class="nb-term" data-term="' + key + '">' + word + "</button>"; }
  var pop = $("#nb-pop");
  var popOwner = null;
  function hidePop() { pop.hidden = true; popOwner = null; }
  root.addEventListener("click", function (e) {
    var t = e.target.closest ? e.target.closest(".nb-term") : null;
    if (t && root.contains(t)) {
      e.preventDefault();
      if (popOwner === t) { hidePop(); return; }
      var g = GLOSS[t.getAttribute("data-term")];
      pop.innerHTML = "<b>" + g[0] + "</b>" + g[1];
      pop.hidden = false;
      var r = t.getBoundingClientRect(), rr = root.getBoundingClientRect();
      var left = Math.min(r.left - rr.left, rr.width - pop.offsetWidth - 8);
      pop.style.left = Math.max(8, left) + "px";
      pop.style.top = (r.bottom - rr.top + 8) + "px";
      popOwner = t;
      return;
    }
    if (!pop.hidden && !pop.contains(e.target)) hidePop();
  });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") hidePop(); });

  // ================================================================ check-yourself
  var checkSeq = 0;
  function check(question, options) {
    var id = "nbchk" + (++checkSeq);
    setTimeout(function () {
      var box = document.getElementById(id);
      if (!box) return;
      $$(".nb-opt", box).forEach(function (b, i) {
        b.addEventListener("click", function () {
          var o = options[i];
          $$(".nb-opt", box).forEach(function (x) { x.classList.remove("wrong"); });
          b.classList.add(o.ok ? "right" : "wrong");
          var fb = $(".nb-fb", box);
          fb.className = "nb-fb " + (o.ok ? "ok" : "no");
          fb.innerHTML = o.why + (o.ok ? "" : " Try again.");
          if (o.ok) $$(".nb-opt", box).forEach(function (x) { x.disabled = true; });
        });
      });
    }, 0);
    return '<div class="nb-check" id="' + id + '"><div class="q">' + question + '</div><div class="nb-opts">' +
      options.map(function (o) { return '<button type="button" class="nb-btn nb-opt">' + o.t + "</button>"; }).join("") +
      '</div><div class="nb-fb"></div></div>';
  }

  // ================================================================ data & core solver
  var FEATS = [
    { key: "Outlook", values: ["Sunny", "Overcast", "Rainy"] },
    { key: "Temperature", values: ["Hot", "Mild", "Cool"] },
    { key: "Humidity", values: ["High", "Normal"] },
    { key: "Wind", values: ["False", "True"] },
  ];
  var DATA = [
    ["Rainy", "Hot", "High", "False", "Yes"], ["Rainy", "Hot", "High", "True", "No"],
    ["Overcast", "Hot", "High", "False", "Yes"], ["Sunny", "Mild", "High", "False", "No"],
    ["Sunny", "Cool", "Normal", "False", "Yes"], ["Sunny", "Cool", "Normal", "True", "No"],
    ["Overcast", "Cool", "Normal", "True", "Yes"], ["Rainy", "Mild", "High", "False", "No"],
    ["Rainy", "Cool", "Normal", "False", "Yes"], ["Sunny", "Mild", "Normal", "False", "Yes"],
    ["Rainy", "Mild", "Normal", "True", "Yes"], ["Overcast", "Mild", "High", "True", "Yes"],
    ["Overcast", "Hot", "Normal", "False", "Yes"], ["Sunny", "Mild", "High", "True", "No"],
  ];
  var CLASSES = ["Yes", "No"];
  function classSize(c) { return DATA.filter(function (r) { return r[4] === c; }).length; }
  function count(fi, v, c) { return DATA.filter(function (r) { return r[fi] === v && r[4] === c; }).length; }
  function solve(q, laplace) {
    var res = { q: q, laplace: laplace, prior: {}, lik: {}, score: {}, post: {} };
    CLASSES.forEach(function (c) {
      var nc = classSize(c);
      res.prior[c] = { n: nc, d: DATA.length, v: nc / DATA.length };
      res.lik[c] = FEATS.map(function (f, i) {
        var k = f.values.length, cnt = count(i, q[i], c);
        var num = cnt + (laplace ? 1 : 0), den = nc + (laplace ? k : 0);
        return { cnt: cnt, num: num, den: den, k: k, v: num / den };
      });
      res.score[c] = res.lik[c].reduce(function (a, l) { return a * l.v; }, res.prior[c].v);
    });
    var tot = res.score.Yes + res.score.No;
    CLASSES.forEach(function (c) { res.post[c] = tot > 0 ? res.score[c] / tot : NaN; });
    res.pred = tot === 0 ? null : res.score.Yes >= res.score.No ? "Yes" : "No";
    return res;
  }
  function scoreRows(r) {
    return '<div class="nb-calc">' + CLASSES.map(function (c) {
      var terms = [frac(r.prior[c].n, r.prior[c].d)].concat(r.lik[c].map(function (l) { return frac(l.num, l.den); }));
      return '<div class="nb-calcrow ' + c.toLowerCase() + '"><span class="lbl">Score(' + c + ") = prior × four likelihoods</span>" +
        m(terms.join(" × ") + " ≈ <b>" + fmt(r.score[c], 4) + "</b>") + "</div>";
    }).join("") + "</div>";
  }
  function postBars(r) {
    return '<div class="nb-bars nb-mt">' + bar("Yes", r.post.Yes, "var(--nb-yes)", pct(r.post.Yes)) + bar("No", r.post.No, "var(--nb-no)", pct(r.post.No)) + "</div>";
  }

  // ================================================================ pages
  var PARTS = [
    { id: "A", label: "A · Learn the idea" },
    { id: "B", label: "B · See it work" },
    { id: "C", label: "C · Try it yourself" },
  ];
  var PAGES = [];
  function page(id, part, title, build, onShow) { PAGES.push({ id: id, part: part, title: title, build: build, onShow: onShow }); }

  // ---------------------------------------------------------------- A1
  page("a1", "A", "What is classification?", function (el) {
    el.innerHTML =
      '<div class="nb-eyebrow">Part A · Theory 1 of 5</div><h2 class="nb-h2">What is classification?</h2>' +
      '<p class="nb-lead">' + term("Classification", "classification") + " means putting a new item into one of a few groups. " +
      "Each group is called a " + term("class", "class") + ".</p>" +
      '<p class="nb-text">You see this every day:</p>' +
      '<ul class="nb-text"><li>Your email app puts a new message into <b>Spam</b> or <b>Inbox</b>.</li>' +
      "<li>A shop reads a product review and marks it <b>positive</b> or <b>negative</b>.</li>" +
      "<li>A golf club looks at the weather and asks: will people <b>play golf</b> today, <b>Yes</b> or <b>No</b>?</li></ul>" +
      '<p class="nb-text">A computer learns to do this from ' + term("training data", "training") +
      ": old examples where we already know the right class. Each example is described by " + term("features", "feature") +
      ". You can think of features as clues.</p>" +
      '<div class="nb-flow">' +
      '<div class="nb-node"><b>Old examples</b><span>emails already marked Spam or Inbox</span></div><div class="nb-arrow">→</div>' +
      '<div class="nb-node blue"><b>Learn</b><span>find which clues usually go with which class</span></div><div class="nb-arrow">→</div>' +
      '<div class="nb-node"><b>New email</b><span>clue: it contains the word "free"</span></div><div class="nb-arrow">→</div>' +
      '<div class="nb-node amber"><b>Spam or Inbox?</b><span>the class we predict</span></div></div>' +
      plain("Look at old examples, learn which clues go with which group, then use the clues of a new item to guess its group. " +
        "Naïve Bayes is one simple way to make that guess, using probabilities.") +
      check("Which of these is a classification task?", [
        { t: "Predicting tomorrow's temperature in °C", ok: false, why: "The answer is a number on a scale, not a group. That task is called regression." },
        { t: "Deciding whether a photo shows a cat or a dog", ok: true, why: "There are two groups (cat and dog), and we pick one. That is classification." },
        { t: "Computing the average of exam scores", ok: false, why: "This is a calculation. Nothing is put into a group." },
      ]);
  });

  // ---------------------------------------------------------------- A2
  page("a2", "A", "Thinking in probabilities", function (el) {
    var tiles = "";
    for (var i = 0; i < 10; i++) tiles += '<div class="nb-tile ' + (i < 7 ? "rain" : "dry") + '">' + (i < 7 ? "rain" : "dry") + "</div>";
    el.innerHTML =
      '<div class="nb-eyebrow">Part A · Theory 2 of 5</div><h2 class="nb-h2">Thinking in probabilities</h2>' +
      '<p class="nb-lead">We are almost never 100% sure about a class. So instead of saying "it is spam", we say "it is <i>probably</i> spam", and we put a number on it.</p>' +
      '<p class="nb-text">A ' + term("probability", "probability") + " is a number from 0 to 1. Zero means impossible, 1 means certain, and 0.5 means a fifty-fifty chance.</p>" +
      '<h3 class="nb-h3 nb-mt">Example: clouds and rain</h3>' +
      '<p class="nb-text">Last month there were 10 cloudy days. It rained on 7 of them:</p>' +
      '<div class="nb-tiles">' + tiles + "</div>" +
      '<p class="nb-text">So when the sky is cloudy, the chance of rain is ' + m(frac(7, 10) + " = 0.7") +
      ". This is a " + term("conditional probability", "conditional") + ": the chance of rain <i>when we already know</i> that it is cloudy. We write it like this:</p>" +
      '<div class="nb-formula">' + m("<i>P</i>(rain | cloudy) = 0.7") + "</div>" +
      '<p class="nb-text">Read the vertical bar "|" as <b>"given that"</b>. The line reads: the probability of rain, given that it is cloudy, is 0.7.</p>' +
      plain("To find a conditional probability from data, first keep only the cases that match what you know (cloudy days). Then count how many of those have the outcome (rain).") +
      check('What does <span class="nb-math"><i>P</i>(spam | free)</span> mean?', [
        { t: "The chance an email contains \"free\", given that it is spam", ok: false, why: "That would be P(free | spam). The part after the bar is what we already know." },
        { t: "The chance an email is spam, given that it contains \"free\"", ok: true, why: "We already know the email contains \"free\", and we ask how likely it is spam." },
        { t: "The chance an email is spam and contains \"free\"", ok: false, why: "The bar means \"given that\", not \"and\"." },
      ]);
  });

  // ---------------------------------------------------------------- A3
  page("a3", "A", "Bayes' theorem in plain words", function (el) {
    el.innerHTML =
      '<div class="nb-eyebrow">Part A · Theory 3 of 5</div><h2 class="nb-h2">Bayes\' theorem in plain words</h2>' +
      '<p class="nb-lead">Bayes\' theorem is a rule for <b>updating what we believe</b> when we see a new clue.</p>' +
      plain("<b>What we believe now = what we believed before, updated by how well the clue fits.</b>") +
      '<div class="nb-flow">' +
      '<div class="nb-node blue"><b>Before</b><span>' + term("Prior", "prior") + ": how common is spam in general?</span></div><div class=\"nb-arrow\">→</div>" +
      '<div class="nb-node teal"><b>Clue</b><span>' + term("Likelihood", "likelihood") + ': how often does spam contain "free"?</span></div><div class="nb-arrow">→</div>' +
      '<div class="nb-node purple"><b>After</b><span>' + term("Posterior", "posterior") + ': how likely is this email spam, now that we saw "free"?</span></div></div>' +
      '<h3 class="nb-h3 nb-mt">The formula</h3><p class="nb-text">Here is the same idea written with symbols. The colors match the boxes above.</p>' +
      '<div class="nb-formula">' + m('<span class="c-post"><i>P</i>(spam | free)</span> = ' +
        frac('<span class="c-lik"><i>P</i>(free | spam)</span> × <span class="c-pri"><i>P</i>(spam)</span>', '<span class="c-ev"><i>P</i>(free)</span>')) + "</div>" +
      '<ul class="nb-labels">' +
      '<li><span class="c-post">Posterior</span><span>What we want: the chance of spam after seeing "free".</span></li>' +
      '<li><span class="c-lik">Likelihood</span><span>Among spam emails, how often does "free" appear?</span></li>' +
      '<li><span class="c-pri">Prior</span><span>Before reading the email: what share of all emails is spam?</span></li>' +
      '<li><span class="c-ev">Evidence</span><span>How common is "free" in all emails? (' + term("evidence", "evidence") + ")</span></li></ul>" +
      '<p class="nb-text">One useful trick: the <span class="c-ev">evidence</span> is the same number for every class. If we only want to know <i>which</i> class wins, we can skip it and just compare <span class="c-lik">likelihood</span> × <span class="c-pri">prior</span>.</p>' +
      '<p class="nb-small">You will compute this with real numbers in Example 1.</p>' +
      check("Which part means \"what we believed before seeing the clue\"?", [
        { t: "Posterior", ok: false, why: "The posterior is what we believe after seeing the clue." },
        { t: "Prior", ok: true, why: "\"Prior\" means before. It is our starting belief." },
        { t: "Likelihood", ok: false, why: "The likelihood says how well the clue fits a class." },
      ]);
  });

  // ---------------------------------------------------------------- A4
  page("a4", "A", "Why \"naive\"?", function (el) {
    var q = ["Sunny", "Hot", "Normal", "False"], r = solve(q, false);
    var exact = DATA.filter(function (row) { return row[0] === q[0] && row[1] === q[1] && row[2] === q[2] && row[3] === q[3]; }).length;
    el.innerHTML =
      '<div class="nb-eyebrow">Part A · Theory 4 of 5</div><h2 class="nb-h2">Why is it called "naive"?</h2>' +
      '<p class="nb-lead">Real problems have many clues at once. For the golf question we look at four: Outlook, Temperature, Humidity, and Wind.</p>' +
      '<h3 class="nb-h3">The problem: too many combinations</h3>' +
      '<p class="nb-text">Say today is ' + q.map(function (v, i) { return pill(FEATS[i].key + " = " + v); }).join(" ") +
      '. The direct way is to find past days with <b>exactly</b> this weather. Our data has only 14 days, and the number of days with exactly this weather is <b>' + exact +
      "</b>. There are 3 × 3 × 2 × 2 = 36 possible weather combinations, so most of them never appear in a small dataset. We cannot count them.</p>" +
      '<h3 class="nb-h3 nb-mt">The naive idea: one clue at a time</h3>' +
      '<p class="nb-text">Naïve Bayes makes one simplifying guess, the ' + term("naive assumption", "naive") +
      ": once we know the class, each clue is treated as if it has nothing to do with the others. Then we can count each clue on its own and multiply the results. For the class Yes:</p>" +
      '<div class="nb-flow">' + FEATS.map(function (f, i) {
        var l = r.lik.Yes[i];
        return '<div class="nb-node teal"><b>' + f.key + " = " + q[i] + "</b><span>" + m("<i>P</i>(" + q[i] + " | Yes) = " + frac(l.num, l.den)) + "</span></div>" +
          (i < 3 ? '<div class="nb-arrow">×</div>' : "");
      }).join("") + "</div>" +
      '<div class="nb-formula">' + m("<i>P</i>(all clues | class) = <i>P</i>(clue<sub>1</sub> | class) × <i>P</i>(clue<sub>2</sub> | class) × … × <i>P</i>(clue<sub><i>n</i></sub> | class)") + "</div>" +
      '<p class="nb-text">It is called "naive" because in real life clues are often linked. Hot days, for example, are often humid. Naïve Bayes ignores this, yet it still works well surprisingly often, especially for text.</p>' +
      plain("Instead of looking for days that match every clue at once, look at each clue separately, then multiply.") +
      check("What does the naive assumption say?", [
        { t: "All classes are equally likely", ok: false, why: "That would be about the prior, not about the clues." },
        { t: "Once the class is known, each clue is independent of the others", ok: true, why: "That is why we can count clues one at a time and multiply." },
        { t: "Clues with a count of zero are removed", ok: false, why: "Zero counts are handled by Laplace smoothing, which you will see in Example 3." },
      ]);
  });

  // ---------------------------------------------------------------- A5
  page("a5", "A", "The five-step recipe", function (el) {
    var steps = [["Count", "For each clue, count how often each value appears with each class."],
      ["Prior", "Find the share of each class among all examples."],
      ["Likelihood", "Turn the counts for today's values into fractions."],
      ["Score", "Multiply the prior by all the likelihoods, for each class."],
      ["Decide", "Pick the class with the highest score."]];
    el.innerHTML =
      '<div class="nb-eyebrow">Part A · Theory 5 of 5</div><h2 class="nb-h2">The five-step recipe</h2>' +
      '<p class="nb-lead">Every Naïve Bayes problem is solved with the same five steps. You will use them in Example 2.</p>' +
      '<div class="nb-flow">' + steps.map(function (s, i) {
        return '<div class="nb-node ' + (i < 2 ? "blue" : "amber") + '"><span class="num">' + (i + 1) + "</span><b>" + s[0] + "</b><span>" + s[1] + "</span></div>" + (i < 4 ? '<div class="nb-arrow">→</div>' : "");
      }).join("") + "</div>" +
      '<div class="nb-groups"><span style="flex:2">Training: learn from the data</span><span class="pred" style="flex:3">Prediction: answer for a new case</span></div>' +
      '<h3 class="nb-h3" style="margin-top:1.5rem">The decision rule</h3>' +
      '<p class="nb-text">Steps 4 and 5 together are written as one rule. In words: <b>for each class, multiply its prior by the likelihood of every clue, and pick the class with the biggest result.</b></p>' +
      '<div class="nb-formula">' + m("<i>ŷ</i> = arg max<sub>class</sub> &nbsp;<i>P</i>(class) × <i>P</i>(clue<sub>1</sub> | class) × … × <i>P</i>(clue<sub><i>n</i></sub> | class)") + "</div>" +
      '<ul class="nb-labels"><li><span class="nb-math"><i>ŷ</i></span><span>the predicted class (read "y-hat")</span></li>' +
      "<li><span>arg max</span><span>\"the class that gives the biggest value\"</span></li>" +
      "<li><span>the result</span><span>a " + term("score", "score") + ", not yet a real probability, because we skipped the evidence</span></li></ul>" +
      plain("Training is just counting. There is no long optimization, which is why Naïve Bayes is very fast.") +
      check("In which step do we multiply numbers together?", [
        { t: "Step 1: Count", ok: false, why: "In Step 1 we only count." },
        { t: "Step 3: Likelihood", ok: false, why: "In Step 3 we turn counts into fractions." },
        { t: "Step 4: Score", ok: true, why: "The score is prior × all the likelihoods." },
      ]);
  });

  // ---------------------------------------------------------------- B1 spam
  var sp = {};
  var MAIL = '<svg viewBox="0 0 24 18" aria-hidden="true"><rect x="1" y="1" width="22" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M2 3l10 7 10-7" fill="none" stroke="currentColor" stroke-width="2"/></svg>';
  page("b1", "B", "Example 1: Is this email spam?", function (el) {
    el.innerHTML =
      '<div class="nb-eyebrow">Part B · Example 1 of 4</div><h2 class="nb-h2">Example 1: Is this email spam?</h2>' +
      '<p class="nb-lead">We have 10 old emails. Each one is <b style="color:var(--nb-no)">Spam</b> or <b style="color:var(--nb-yes)">Not spam</b>, and some contain the word <b>"free"</b>. ' +
      'A new email arrives, and it contains "free". Is it spam?</p>' +
      '<div class="nb-legend"><span><i style="border-color:var(--nb-no);background:var(--nb-no-soft)"></i>Spam</span>' +
      '<span><i style="border-color:var(--nb-yes);background:var(--nb-primary-soft)"></i>Not spam</span><span>black <b>free</b> tag = the email contains "free"</span></div>' +
      '<div class="nb-mails" id="sp-mails"></div>' +
      '<div class="nb-row"><button type="button" class="nb-btn nb-primary" id="sp-filter">Keep only emails with "free"</button></div>' +
      '<div id="sp-explain" class="nb-mt"></div>' +
      '<details class="nb-more"><summary>Change the data (optional)</summary><div class="nb-sliders" id="sp-sliders"></div></details>';
    var c = $("#sp-sliders", el);
    sp.s = slider(c, "sp-s", "Spam emails", 1, 20, 1, 4, updSpam, "no");
    sp.sf = slider(c, "sp-sf", 'Spam with "free"', 0, 20, 1, 3, updSpam, "no");
    sp.n = slider(c, "sp-n", "Not-spam emails", 1, 20, 1, 6, updSpam, "yes");
    sp.nf = slider(c, "sp-nf", 'Not spam with "free"', 0, 20, 1, 1, updSpam, "yes");
    sp.filtered = false;
    $("#sp-filter", el).addEventListener("click", function () { sp.filtered = !sp.filtered; updSpam(); });
    updSpam();
  });
  function updSpam() {
    var S = sp.s.get(), N0 = sp.n.get();
    sp.sf.input.max = S; sp.nf.input.max = N0;
    if (sp.sf.get() > S) sp.sf.set(S);
    if (sp.nf.get() > N0) sp.nf.set(N0);
    var SF = sp.sf.get(), NF = sp.nf.get(), T = S + N0, TF = SF + NF;
    var mails = "", i, j;
    for (i = 0; i < S; i++) mails += '<div class="nb-mail spam' + (sp.filtered && i >= SF ? " out" : "") + '">' + MAIL + "Spam" + (i < SF ? '<span class="free">free</span>' : "") + "</div>";
    for (j = 0; j < N0; j++) mails += '<div class="nb-mail ham' + (sp.filtered && j >= NF ? " out" : "") + '">' + MAIL + "Not spam" + (j < NF ? '<span class="free">free</span>' : "") + "</div>";
    $("#sp-mails").innerHTML = mails;
    $("#sp-filter").textContent = sp.filtered ? "Show all emails again" : 'Keep only emails with "free"';
    var ex = $("#sp-explain");
    if (!sp.filtered) {
      ex.innerHTML = '<p class="nb-text">We already know the new email contains "free". So the only old emails that matter are the ones that also contain "free". Press the button to keep only those.</p>';
      return;
    }
    if (TF === 0) {
      ex.innerHTML = '<div class="nb-callout warn">No old email contains "free", so there is nothing to compare with and the probability cannot be computed. You will meet this zero problem again in Example 3.</div>';
      return;
    }
    var numS = (SF / S) * (S / T), numN = (NF / N0) * (N0 / T), ev = TF / T, pS = numS / ev, pN = numN / ev;
    ex.innerHTML =
      '<h3 class="nb-h3">Way 1: just count</h3>' +
      '<p class="nb-text">Among the <b>' + TF + '</b> emails with "free", <b>' + SF + "</b> are spam. So</p>" +
      '<div class="nb-formula">' + m("<i>P</i>(spam | free) = " + frac(SF, TF) + " = <b>" + fmt(SF / TF, 3) + "</b>") + "</div>" +
      '<h3 class="nb-h3 nb-mt">Way 2: Bayes\' theorem gives the same answer</h3>' +
      '<p class="nb-text">From all ' + T + " emails, the " + term("prior", "prior") + " is " + m("<i>P</i>(spam) = " + frac(S, T)) + ", the " + term("likelihood", "likelihood") + " is " +
      m("<i>P</i>(free | spam) = " + frac(SF, S)) + ", and the " + term("evidence", "evidence") + " is " + m("<i>P</i>(free) = " + frac(TF, T)) + ".</p>" +
      '<div class="nb-calc">' +
      '<div class="nb-calcrow no"><span class="lbl">Spam</span>' + m("<i>P</i>(spam | free) = " + frac(frac(SF, S) + " × " + frac(S, T), frac(TF, T)) + " = " + frac(fmt(numS, 3), fmt(ev, 3)) + " = <b>" + fmt(pS, 3) + "</b>") + "</div>" +
      '<div class="nb-calcrow yes"><span class="lbl">Not spam</span>' + m("<i>P</i>(not spam | free) = " + frac(frac(NF, N0) + " × " + frac(N0, T), frac(TF, T)) + " = " + frac(fmt(numN, 3), fmt(ev, 3)) + " = <b>" + fmt(pN, 3) + "</b>") + "</div></div>" +
      '<div class="nb-bars nb-mt">' + bar("Spam", pS, "var(--nb-no)", pct(pS)) + bar("Not spam", pN, "var(--nb-yes)", pct(pN)) + "</div>" +
      '<div class="nb-verdict">The new email is classified as ' + (pS > pN ? "Spam" : pS < pN ? "Not spam" : "a tie (equal chance)") + "</div>" +
      plain("Both ways agree, because Bayes' theorem is just a careful way of counting. Both classes are divided by the same evidence (" + fmt(ev, 3) +
        "), so comparing the top parts, " + fmt(numS, 3) + " and " + fmt(numN, 3) + ", already tells us the winner. Naïve Bayes uses this shortcut.");
  }

  // ---------------------------------------------------------------- B2 golf solver
  var sv = { q: ["Sunny", "Hot", "Normal", "False"], step: 0, guess: null, timer: null, cf: 0, done: [false, false, false, false], scan: -1, anim: null, tally: { Yes: 0, No: 0 } };
  var STEPS = [
    { chip: "Start", title: "The question", what: "Choose today's weather above, or keep the example from class.", why: "Naïve Bayes will compare a score for Yes with a score for No." },
    { chip: "Step 1 of 5 · Training", title: "Count", what: "For each clue, go through the 14 days. Count how many Yes days and how many No days have today's value.", why: "These counts are everything the model learns." },
    { chip: "Step 2 of 5 · Training", title: "Prior", what: "Find what share of all 14 days are Yes and what share are No.", why: "This is our belief before looking at today's weather." },
    { chip: "Step 3 of 5 · Prediction", title: "Likelihood", what: "Turn each count into a fraction: divide by the number of days in that class (9 Yes days, 5 No days).", why: "The fraction says how typical today's value is for each class." },
    { chip: "Step 4 of 5 · Prediction", title: "Score", what: "For each class, multiply the prior by the four fractions.", why: "This combines all clues into one number per class (the naive idea)." },
    { chip: "Step 5 of 5 · Prediction", title: "Decide", what: "Pick the class with the bigger score. To get a percentage, divide each score by the total.", why: "The biggest score is the most likely class." },
  ];
  page("b2", "B", "Example 2: Will we play golf?", function (el) {
    el.innerHTML =
      '<div class="nb-eyebrow">Part B · Example 2 of 4</div><h2 class="nb-h2">Example 2: Will we play golf?</h2>' +
      '<p class="nb-lead">Now there are four clues at once. We use the five-step recipe. Press <b>Next step</b> (or the → key) to move forward.</p>' +
      '<div class="nb-card" style="margin-bottom:1rem"><div class="nb-row" id="sv-query" style="gap:.6rem 1.1rem"></div>' +
      '<div class="nb-row" style="margin-top:.7rem;gap:.6rem 1.2rem"><label class="nb-switch"><input type="checkbox" id="sv-guess"> <span>Let me predict before the answer is shown</span></label>' +
      '<button type="button" class="nb-btn nb-ghost nb-sm" id="sv-reset-q">Use the example from class</button></div></div>' +
      '<div class="nb-grid2 nb-solver"><div class="nb-card"><h3 class="nb-h3">Training data (14 days)</h3>' +
      '<div class="nb-scroll"><table class="nb-table nb-data" id="sv-data"></table></div><p class="nb-small nb-mt" id="sv-data-note"></p></div>' +
      '<div class="nb-card nb-stepcard"><div class="nb-stepchip" id="sv-chip"></div><h3 class="nb-h3" id="sv-title"></h3>' +
      '<div class="nb-what" id="sv-what"></div><div id="sv-body" aria-live="polite"></div></div></div>' +
      '<div class="nb-controls"><button type="button" class="nb-btn" id="sv-back">← Back</button>' +
      '<button type="button" class="nb-btn nb-primary" id="sv-next">Next step →</button>' +
      '<button type="button" class="nb-btn" id="sv-play">▶ Play all</button>' +
      '<button type="button" class="nb-btn nb-ghost" id="sv-restart">Start over</button><div class="nb-dots" id="sv-dots" aria-label="Steps"></div></div>';
    var row = $("#sv-query", el);
    row.innerHTML = '<span style="font-weight:700">Today:</span>';
    FEATS.forEach(function (f, i) {
      var lab = document.createElement("label");
      lab.className = "nb-sel";
      lab.innerHTML = f.key + '<select data-fi="' + i + '">' + f.values.map(function (v) {
        return '<option value="' + v + '"' + (v === sv.q[i] ? " selected" : "") + ">" + v + "</option>";
      }).join("") + "</select>";
      row.appendChild(lab);
    });
    $$("#sv-query select", el).forEach(function (s) {
      s.addEventListener("change", function () { sv.q[+s.getAttribute("data-fi")] = s.value; resetCount(); sv.guess = null; renderSolver(); });
    });
    $("#sv-reset-q", el).addEventListener("click", function () {
      sv.q = ["Sunny", "Hot", "Normal", "False"];
      $$("#sv-query select").forEach(function (s, i) { s.value = sv.q[i]; });
      resetCount(); sv.step = 0; sv.guess = null; renderSolver();
    });
    $("#sv-guess", el).addEventListener("change", function () { sv.guess = null; renderSolver(); });
    var dots = $("#sv-dots", el);
    STEPS.forEach(function (s, i) {
      var d = document.createElement("button");
      d.type = "button"; d.className = "nb-dot"; d.textContent = i === 0 ? "?" : String(i);
      d.title = i === 0 ? "The question" : "Step " + i + ": " + s.title;
      d.addEventListener("click", function () { stopPlay(); stopAnim(); sv.step = i; if (i >= 2) sv.done = [true, true, true, true]; renderSolver(); });
      dots.appendChild(d);
    });
    $("#sv-back", el).addEventListener("click", function () { stopPlay(); go(-1); });
    $("#sv-next", el).addEventListener("click", function () { stopPlay(); go(1); });
    $("#sv-restart", el).addEventListener("click", function () { stopPlay(); resetCount(); sv.step = 0; sv.guess = null; renderSolver(); });
    $("#sv-play", el).addEventListener("click", function () {
      if (sv.timer) { stopPlay(); return; }
      if (sv.step >= 5) sv.step = 0;
      $("#sv-play").textContent = "❚❚ Pause";
      sv.timer = setInterval(function () { if (sv.step >= 5) { stopPlay(); return; } go(1); }, 3500);
    });
    renderSolver();
  });
  function resetCount() { stopAnim(); sv.cf = 0; sv.done = [false, false, false, false]; sv.scan = -1; sv.tally = { Yes: 0, No: 0 }; }
  function stopPlay() { if (sv.timer) { clearInterval(sv.timer); sv.timer = null; } var p = $("#sv-play"); if (p) p.textContent = "▶ Play all"; }
  function stopAnim() { if (sv.anim) { clearInterval(sv.anim); sv.anim = null; } }
  function go(d) { stopAnim(); sv.step = Math.max(0, Math.min(5, sv.step + d)); if (sv.step >= 2) sv.done = [true, true, true, true]; renderSolver(); }
  function finishFeature(fi) {
    stopAnim();
    sv.cf = fi; sv.scan = -1; sv.done[fi] = true;
    sv.tally = { Yes: count(fi, sv.q[fi], "Yes"), No: count(fi, sv.q[fi], "No") };
    renderSolver();
  }
  function selectFeature(fi) {
    if (sv.done[fi]) { finishFeature(fi); return; }
    stopAnim(); sv.cf = fi; sv.scan = -1; sv.tally = { Yes: 0, No: 0 }; renderSolver();
  }
  function animateFeature(fi) {
    stopAnim();
    sv.cf = fi; sv.done[fi] = false; sv.scan = -1; sv.tally = { Yes: 0, No: 0 };
    sv.anim = setInterval(function () {
      sv.scan++;
      if (sv.scan >= DATA.length) { finishFeature(fi); return; }
      var r = DATA[sv.scan];
      if (r[fi] === sv.q[fi]) sv.tally[r[4]]++;
      renderSolver();
    }, 280);
    renderSolver();
  }

  function renderData() {
    var s = sv.step, counting = s === 1, fi = sv.cf;
    var html = "<thead><tr><th>#</th>" + FEATS.map(function (f, i) {
      return "<th" + (counting && i !== fi ? ' class="dimcol"' : "") + ">" + f.key + "</th>";
    }).join("") + "<th>Play</th></tr></thead><tbody>";
    DATA.forEach(function (r, ri) {
      var scanned = counting && (sv.done[fi] || ri <= sv.scan);
      html += "<tr" + (counting && ri === sv.scan ? ' class="scan"' : "") + "><td>" + (ri + 1) + "</td>";
      r.slice(0, 4).forEach(function (v, i) {
        var c = "";
        if (counting) {
          if (i !== fi) c = "dimcol";
          else if (scanned && v === sv.q[i]) c = "hl";
        } else if (s === 3 && v === sv.q[i]) c = "hl";
        html += "<td" + (c ? ' class="' + c + '"' : "") + ">" + v + "</td>";
      });
      html += '<td class="lab-' + (r[4] === "Yes" ? "yes" : "no") + '">' + r[4] + "</td></tr>";
    });
    $("#sv-data").innerHTML = html + "</tbody>";
    $("#sv-data-note").innerHTML = counting
      ? "Only the " + FEATS[fi].key + " column matters right now. Yellow cells match today's value (" + sv.q[fi] + ")."
      : s === 3 ? "Yellow cells match today's values." : "9 days are " + Y + " and 5 days are " + N + ".";
  }

  function renderSolver() {
    var guessMode = $("#sv-guess").checked;
    var r = solve(sv.q, false), s = sv.step, st = STEPS[s];
    renderData();
    $$("#sv-dots .nb-dot").forEach(function (d, i) {
      if (i === s) d.setAttribute("aria-current", "step"); else d.removeAttribute("aria-current");
      d.classList.toggle("done", i < s);
    });
    $("#sv-back").disabled = s === 0;
    $("#sv-next").disabled = s === 5;
    $("#sv-chip").textContent = st.chip;
    $("#sv-title").textContent = st.title;
    $("#sv-what").innerHTML = "<b>Do</b><span>" + st.what + "</span><b>Why</b><span>" + st.why + "</span>";
    var qStr = sv.q.map(function (v, i) { return pill(FEATS[i].key + " = " + v); }).join(" ");
    var body = "";

    if (s === 0) {
      body = "<p>New day to classify:</p><p>" + qStr + "</p><p>We will answer with the five steps:</p>" +
        '<div class="nb-flow" style="margin:.4rem 0">' + ["Count", "Prior", "Likelihood", "Score", "Decide"].map(function (t, i) {
          return '<div class="nb-node ' + (i < 2 ? "blue" : "amber") + '" style="flex-basis:5rem;padding:.4rem"><b style="font-size:.85rem">' + (i + 1) + ". " + t + "</b></div>";
        }).join("") + "</div>" +
        '<p class="nb-small">Tip: change the weather above to solve a different day. Press <b>Next step</b> to begin.</p>';
    }

    if (s === 1) {
      var fi = sv.cf, f = FEATS[fi], running = !!sv.anim;
      body = '<div class="nb-feats">' + FEATS.map(function (g, i) {
        return '<button type="button" class="nb-btn nb-sm nb-feat' + (sv.done[i] ? " ok" : "") + '" aria-pressed="' + (i === fi) + '" data-cf="' + i + '">' + (i + 1) + ". " + g.key + "</button>";
      }).join("") + "</div>" +
        "<p>Clue " + (fi + 1) + " of 4: counting <b>" + f.key + " = " + sv.q[fi] + "</b>" + (running ? " … checking day " + (sv.scan + 1) + " of 14" : "") + "</p>" +
        '<div class="nb-counter"><div class="y">Yes days<b>' + sv.tally.Yes + '</b></div><div class="n">No days<b>' + sv.tally.No + "</b></div></div>";
      if (!sv.done[fi]) {
        body += '<div class="nb-row"><button type="button" class="nb-btn nb-primary" id="sv-count"' + (running ? " disabled" : "") + ">▶ Count day by day</button>" +
          '<button type="button" class="nb-btn" id="sv-skip">Show the result</button></div>';
      } else {
        body += "<p>Result: " + f.key + " = " + sv.q[fi] + " appears on <b>" + count(fi, sv.q[fi], "Yes") + "</b> Yes days and <b>" + count(fi, sv.q[fi], "No") + "</b> No days.</p>";
        var next = sv.done.indexOf(false);
        body += next >= 0
          ? '<div class="nb-row"><button type="button" class="nb-btn nb-primary" data-cf="' + next + '">Count the next clue: ' + FEATS[next].key + " →</button></div>"
          : '<div class="nb-callout ok">All four clues are counted. Press <b>Next step</b>.</div>';
      }
      if (sv.done.some(Boolean)) {
        body += '<table class="nb-table nb-mt"><thead><tr><th>Today\'s clue</th><th>Yes days</th><th>No days</th></tr></thead><tbody>' +
          FEATS.map(function (g, i) {
            if (!sv.done[i]) return "";
            var cy = count(i, sv.q[i], "Yes"), cn = count(i, sv.q[i], "No");
            return "<tr><td>" + g.key + " = " + sv.q[i] + "</td><td" + (cy === 0 ? ' class="zero"' : "") + ">" + cy + "</td><td" + (cn === 0 ? ' class="zero"' : "") + ">" + cn + "</td></tr>";
          }).join("") + "</tbody></table>";
      }
      if (sv.done.every(Boolean) && FEATS.some(function (g, i) { return count(i, sv.q[i], "Yes") === 0 || count(i, sv.q[i], "No") === 0; })) {
        body += '<div class="nb-callout warn">One count is 0. Watch what happens in Step 4, and see Example 3 for the fix.</div>';
      }
    }

    if (s === 2) {
      body = "<p>Of the 14 days, 9 were Yes and 5 were No:</p>" +
        '<div class="nb-calc"><div class="nb-calcrow yes">' + m("<i>P</i>(Yes) = " + frac(9, 14) + " ≈ " + fmt(9 / 14, 3)) + "</div>" +
        '<div class="nb-calcrow no">' + m("<i>P</i>(No) = " + frac(5, 14) + " ≈ " + fmt(5 / 14, 3)) + "</div></div>" +
        '<div class="nb-bars nb-mt">' + bar("Yes", 9 / 14, "var(--nb-yes)") + bar("No", 5 / 14, "var(--nb-no)") + "</div>" +
        '<p class="nb-mt">Before looking at the weather, Yes is already more likely. The clues will now update this belief.</p>';
    }

    if (s === 3) {
      body = '<table class="nb-table"><thead><tr><th>Today\'s clue</th><th>' + m("<i>P</i>(clue | Yes)") + "</th><th>" + m("<i>P</i>(clue | No)") + "</th></tr></thead><tbody>" +
        FEATS.map(function (g, i) {
          var cell = function (c) { var l = r.lik[c][i]; return "<td" + (l.v === 0 ? ' class="zero"' : "") + ">" + m(frac(l.num, l.den)) + "</td>"; };
          return "<tr><td>" + g.key + " = " + sv.q[i] + "</td>" + cell("Yes") + cell("No") + "</tr>";
        }).join("") + "</tbody></table>" +
        '<p class="nb-small nb-mt">Example: ' + FEATS[0].key + " = " + sv.q[0] + " appears on " + r.lik.Yes[0].cnt + " of the 9 Yes days, so its likelihood for Yes is " +
        r.lik.Yes[0].cnt + "/9.</p>";
    }

    if (s === 4) {
      body = scoreRows(r);
      var zeroC = CLASSES.filter(function (c) { return r.score[c] === 0; });
      if (zeroC.length) {
        body += '<div class="nb-callout warn"><b>A score is 0.</b> One fraction for ' + zeroC.map(cls).join(" and ") +
          " is 0, so the whole product becomes 0, even if the other clues fit well. Example 3 shows how to fix this.</div>";
      } else {
        var big = r.score.Yes >= r.score.No ? "Yes" : "No";
        var ratio = r.score[big] / r.score[big === "Yes" ? "No" : "Yes"];
        body += '<p class="nb-mt">The ' + cls(big) + " score is about " + fmt(ratio, 2) + " times bigger. These are scores, not percentages yet.</p>";
      }
    }

    if (s === 5) {
      if (guessMode && !sv.guess) {
        body = "<p>Your turn first: which class will Naïve Bayes predict for " + qStr + "?</p>" +
          '<div class="nb-opts"><button type="button" class="nb-btn nb-opt" data-g="Yes">Yes</button><button type="button" class="nb-btn nb-opt" data-g="No">No</button></div>';
      } else if (!r.pred) {
        body = '<div class="nb-callout warn">Both scores are 0, so no decision is possible. See Example 3.</div>';
      } else {
        body = '<div class="nb-calc">' + CLASSES.map(function (c) {
          return '<div class="nb-calcrow ' + c.toLowerCase() + '">' + m("<i>P</i>(" + c + " | today) = " +
            frac(fmt(r.score[c], 4), fmt(r.score.Yes, 4) + " + " + fmt(r.score.No, 4)) + " ≈ <b>" + fmt(r.post[c], 3) + "</b>") + "</div>";
        }).join("") + "</div>" + postBars(r) +
          '<div class="nb-verdict">Prediction: Play Golf = ' + r.pred + " (" + pct(r.post[r.pred]) + " sure)</div>" +
          '<p class="nb-small nb-mt">Dividing by the total is called ' + term("normalizing", "normalize") + ". It does not change the winner; it only turns the scores into percentages.</p>";
        if (sv.guess) {
          body += sv.guess === r.pred ? '<div class="nb-callout ok">You predicted ' + sv.guess + ". Correct!</div>"
            : '<div class="nb-callout warn">You predicted ' + sv.guess + ". Look at Step 4: the " + r.pred + " score is bigger.</div>";
        }
      }
    }
    $("#sv-body").innerHTML = body;
    $$("#sv-body [data-cf]").forEach(function (b) { b.addEventListener("click", function () { selectFeature(+b.getAttribute("data-cf")); }); });
    var cb = $("#sv-count"); if (cb) cb.addEventListener("click", function () { animateFeature(sv.cf); });
    var sk = $("#sv-skip"); if (sk) sk.addEventListener("click", function () { finishFeature(sv.cf); });
    $$("#sv-body [data-g]").forEach(function (b) { b.addEventListener("click", function () { sv.guess = b.getAttribute("data-g"); renderSolver(); }); });
  }

  // ---------------------------------------------------------------- B3 laplace
  var lp = { on: false };
  var LQ = ["Overcast", "Cool", "High", "True"];
  page("b3", "B", "Example 3: When a count is zero", function (el) {
    el.innerHTML =
      '<div class="nb-eyebrow">Part B · Example 3 of 4</div><h2 class="nb-h2">Example 3: When a count is zero</h2>' +
      '<p class="nb-lead">New day: ' + LQ.map(function (v, i) { return pill(FEATS[i].key + " = " + v); }).join(" ") + "</p>" +
      '<div id="lp-body"></div>';
    renderLaplace();
  });
  function renderLaplace() {
    var a = solve(LQ, false), b = solve(LQ, true);
    var h = '<h3 class="nb-h3">The problem</h3>' +
      '<p class="nb-text">In our 14 days, Overcast appeared 4 times, and <b>every time</b> the answer was Yes. So for No the count is 0:</p>' +
      '<div class="nb-formula">' + m("<i>P</i>(Overcast | No) = " + frac(0, 5) + " = 0") + "</div>" +
      '<p class="nb-text">Naïve Bayes multiplies, so one zero makes the whole No score zero:</p>' +
      '<div class="nb-calc"><div class="nb-calcrow no"><span class="lbl">Score(No) without the fix</span>' +
      m([frac(5, 14)].concat(a.lik.No.map(function (l) { return l.v === 0 ? '<span style="color:var(--nb-bad);font-weight:700">' + frac(l.num, l.den) + "</span>" : frac(l.num, l.den); })).join(" × ") + " = <b>0</b>") + "</div></div>" +
      '<div class="nb-callout warn">The model now says Yes is ' + pct(a.post.Yes) + " certain. That is not reasonable: overcast days without golf surely happen. We just did not see one in 14 days.</div>" +
      '<h3 class="nb-h3" style="margin-top:1.5rem">The fix: Laplace smoothing</h3>' +
      plain("Pretend that every value was seen <b>one extra time</b> in every class. Then nothing is ever exactly zero. This is called " + term("Laplace smoothing", "laplace") + ".") +
      '<div class="nb-formula">' + m("<i>P</i>(value | class) = " + frac("count + 1", "days in class + <i>k</i>")) + "</div>" +
      '<ul class="nb-labels"><li><span>count</span><span>how many days of this class have this value</span></li>' +
      "<li><span>+ 1</span><span>the one extra imaginary time</span></li>" +
      '<li><span class="nb-math"><i>k</i></span><span>how many different values the clue has (Outlook has 3, Humidity has 2), so the fractions still add up to 1</span></li></ul>' +
      '<div class="nb-row nb-mt"><button type="button" class="nb-btn nb-primary" id="lp-toggle">' + (lp.on ? "Hide the smoothed values" : "Apply Laplace smoothing") + "</button></div>";
    if (lp.on) {
      h += '<div class="nb-scroll nb-mt"><table class="nb-table"><thead><tr><th>Clue</th><th>Yes before</th><th>Yes after</th><th>No before</th><th>No after</th></tr></thead><tbody>' +
        FEATS.map(function (f, i) {
          var ay = a.lik.Yes[i], by = b.lik.Yes[i], an = a.lik.No[i], bn = b.lik.No[i];
          return "<tr><td>" + f.key + " = " + LQ[i] + "</td><td>" + m(frac(ay.num, ay.den)) + '</td><td class="new">' + m(frac(by.cnt + " + 1", "9 + " + by.k) + " = " + frac(by.num, by.den)) +
            "</td><td" + (an.v === 0 ? ' class="zero"' : "") + ">" + m(frac(an.num, an.den)) + '</td><td class="new">' + m(frac(bn.cnt + " + 1", "5 + " + bn.k) + " = " + frac(bn.num, bn.den)) + "</td></tr>";
        }).join("") + "</tbody></table></div>" +
        '<h3 class="nb-h3 nb-mt">New scores</h3>' + scoreRows(b) + postBars(b) +
        '<div class="nb-verdict">Prediction: ' + b.pred + " (" + pct(b.post[b.pred]) + " sure, instead of " + pct(a.post.Yes) + ")</div>" +
        '<p class="nb-text nb-mt">The answer is still Yes, but now No gets a fair, small chance instead of zero.</p>' +
        check("With smoothing, what is <span class=\"nb-math\"><i>P</i>(Overcast | No)</span>?", [
          { t: m(frac(0, 5)), ok: false, why: "That is the value before smoothing." },
          { t: m(frac(1, 8)), ok: true, why: "(0 + 1) / (5 + 3): one extra time on top, and Outlook has 3 values at the bottom." },
          { t: m(frac(1, 6)), ok: false, why: "At the bottom, add k = 3 (the number of Outlook values) to the 5 No days, not 1." },
        ]);
    }
    $("#lp-body").innerHTML = h;
    $("#lp-toggle").addEventListener("click", function () { lp.on = !lp.on; renderLaplace(); });
  }

  // ---------------------------------------------------------------- B4 gaussian
  var ga = {};
  page("b4", "B", "Example 4: Numbers as clues", function (el) {
    el.innerHTML =
      '<div class="nb-eyebrow">Part B · Example 4 of 4</div><h2 class="nb-h2">Example 4: Numbers as clues (Gaussian Naïve Bayes)</h2>' +
      '<p class="nb-lead">Some clues are numbers, such as height in cm. We cannot count "how many people are exactly 167.0 cm tall", because almost nobody has exactly the same height.</p>' +
      plain("Each class gets a bell-shaped curve that shows which values are typical for it. <b>The higher the curve at a value, the better that value fits the class.</b> That height is used as the likelihood.") +
      '<div class="nb-grid2"><div class="nb-card"><svg id="ga-svg" viewBox="0 0 640 300" role="img" aria-label="Two bell curves with the new value marked"></svg>' +
      '<div class="nb-sliders" id="ga-x"></div><p class="nb-small" style="margin-top:.5rem">Drag the slider to move the new value along the line.</p></div>' +
      '<div class="nb-card"><div id="ga-calc"></div>' +
      '<details class="nb-more"><summary>Change the curves (advanced)</summary><div class="nb-sliders" id="ga-sliders"></div></details>' +
      '<details class="nb-more"><summary>Show the formula</summary><div class="nb-formula">' +
      m("<i>P</i>(<i>x</i> | class) = " + frac("1", "√(2π<i>σ</i>²)") + " exp(−" + frac("(<i>x</i> − <i>μ</i>)²", "2<i>σ</i>²") + ")") + "</div>" +
      '<ul class="nb-labels"><li><span class="nb-math"><i>x</i></span><span>the new value, for example a height</span></li>' +
      '<li><span class="nb-math"><i>μ</i> (mu)</span><span>the average of the class: where the curve peaks</span></li>' +
      '<li><span class="nb-math"><i>σ</i> (sigma)</span><span>the standard deviation: how wide the curve is</span></li></ul>' +
      '<p class="nb-small">Training only needs the average and the standard deviation of each class.</p></details></div></div>';
    ga.x = slider($("#ga-x", el), "ga-x", "New height <i>x</i> (cm)", 145, 200, 1, 167, drawGauss);
    var c = $("#ga-sliders", el);
    var add = function (t) { var g = document.createElement("div"); g.className = "nb-slidergroup"; g.textContent = t; c.appendChild(g); };
    add("Class A");
    ga.ma = slider(c, "ga-ma", "Average <i>μ</i><sub>A</sub>", 150, 195, 1, 163, drawGauss, "yes");
    ga.sa = slider(c, "ga-sa", "Spread <i>σ</i><sub>A</sub>", 2, 12, 0.5, 6, drawGauss, "yes");
    add("Class B");
    ga.mb = slider(c, "ga-mb", "Average <i>μ</i><sub>B</sub>", 150, 195, 1, 178, drawGauss, "no");
    ga.sb = slider(c, "ga-sb", "Spread <i>σ</i><sub>B</sub>", 2, 12, 0.5, 5, drawGauss, "no");
    add("Prior");
    ga.pa = slider(c, "ga-pa", "<i>P</i>(A)", 0.1, 0.9, 0.05, 0.5, drawGauss);
    drawGauss();
  }, function () { drawGauss(); });
  function pdf(x, mu, s) { return Math.exp(-((x - mu) * (x - mu)) / (2 * s * s)) / Math.sqrt(2 * Math.PI * s * s); }
  function drawGauss() {
    if (!ga.x) return;
    var x = ga.x.get(), ma = ga.ma.get(), sa = ga.sa.get(), mb = ga.mb.get(), sb = ga.sb.get(), pa = ga.pa.get();
    var W = 640, H = 300, L = 46, R = 16, T = 14, B = 40, x0 = 145, x1 = 200;
    var ymax = Math.max(pdf(ma, ma, sa), pdf(mb, mb, sb)) * 1.12;
    var sx = function (v) { return L + (v - x0) / (x1 - x0) * (W - L - R); };
    var sy = function (v) { return H - B - v / ymax * (H - T - B); };
    var path = function (mu, s) { var d = ""; for (var v = x0; v <= x1 + 1e-9; v += 0.25) d += (d ? "L" : "M") + sx(v).toFixed(1) + "," + sy(pdf(v, mu, s)).toFixed(1); return d; };
    var cs = getComputedStyle(root);
    var cy = cs.getPropertyValue("--nb-yes").trim(), cn = cs.getPropertyValue("--nb-no").trim(), cl = cs.getPropertyValue("--nb-line").trim(), ci = cs.getPropertyValue("--nb-ink").trim();
    var ticks = "";
    for (var t = 150; t <= 200; t += 10) ticks += '<line x1="' + sx(t) + '" x2="' + sx(t) + '" y1="' + (H - B) + '" y2="' + (H - B + 5) + '" stroke="' + cl + '"/><text x="' + sx(t) + '" y="' + (H - B + 18) + '" text-anchor="middle">' + t + "</text>";
    var la = pdf(x, ma, sa), lb = pdf(x, mb, sb);
    $("#ga-svg").innerHTML =
      '<line x1="' + L + '" x2="' + (W - R) + '" y1="' + (H - B) + '" y2="' + (H - B) + '" stroke="' + cl + '"/>' + ticks +
      '<text x="' + ((L + W - R) / 2) + '" y="' + (H - 6) + '" text-anchor="middle">Height (cm)</text>' +
      '<path d="' + path(ma, sa) + '" fill="none" stroke="' + cy + '" stroke-width="3"/><path d="' + path(mb, sb) + '" fill="none" stroke="' + cn + '" stroke-width="3"/>' +
      '<line x1="' + sx(x) + '" x2="' + sx(x) + '" y1="' + (H - B) + '" y2="' + T + '" stroke="' + ci + '" stroke-dasharray="4 4" opacity=".5"/>' +
      '<line x1="' + (sx(x) - 3) + '" x2="' + (sx(x) - 3) + '" y1="' + (H - B) + '" y2="' + sy(la) + '" stroke="' + cy + '" stroke-width="5" opacity=".35"/>' +
      '<line x1="' + (sx(x) + 3) + '" x2="' + (sx(x) + 3) + '" y1="' + (H - B) + '" y2="' + sy(lb) + '" stroke="' + cn + '" stroke-width="5" opacity=".35"/>' +
      '<circle cx="' + sx(x) + '" cy="' + sy(la) + '" r="6" fill="' + cy + '"/><circle cx="' + sx(x) + '" cy="' + sy(lb) + '" r="6" fill="' + cn + '"/>' +
      '<text x="' + (L + 8) + '" y="' + (T + 12) + '" style="fill:' + cy + ';font-weight:700">Class A</text>' +
      '<text x="' + (L + 8) + '" y="' + (T + 30) + '" style="fill:' + cn + ';font-weight:700">Class B</text>' +
      '<text x="' + (sx(x) + 10) + '" y="' + (H - B - 6) + '">x = ' + x + "</text>";
    var sA = pa * la, sB = (1 - pa) * lb, tot = sA + sB, pA = tot > 0 ? sA / tot : 0.5, pB = 1 - pA;
    $("#ga-calc").innerHTML =
      '<h3 class="nb-h3">At x = ' + x + " cm</h3>" +
      '<div class="nb-calc"><div class="nb-calcrow yes"><span class="lbl">Class A: height of the blue curve</span>' + m("likelihood ≈ " + fmt(la, 3) + ", score = " + fmt(pa, 2) + " × " + fmt(la, 3) + " ≈ <b>" + fmt(sA, 3) + "</b>") + "</div>" +
      '<div class="nb-calcrow no"><span class="lbl">Class B: height of the orange curve</span>' + m("likelihood ≈ " + fmt(lb, 3) + ", score = " + fmt(1 - pa, 2) + " × " + fmt(lb, 3) + " ≈ <b>" + fmt(sB, 3) + "</b>") + "</div></div>" +
      '<div class="nb-bars nb-mt">' + bar("Class A", pA, "var(--nb-yes)", pct(pA)) + bar("Class B", pB, "var(--nb-no)", pct(pB)) + "</div>" +
      '<div class="nb-verdict">Prediction: Class ' + (pA >= pB ? "A" : "B") + "</div>" +
      '<p class="nb-small nb-mt">Try this: move <i>x</i> to where the two curves cross. There, the two classes are almost equally likely.</p>';
  }

  // ---------------------------------------------------------------- C1 quiz
  var qz = { right: 0, total: 0, cur: null };
  page("c1", "C", "Practice", function (el) {
    el.innerHTML =
      '<div class="nb-eyebrow">Part C · Practice</div><h2 class="nb-h2">Try it yourself</h2>' +
      '<p class="nb-lead">A random day is picked. Use the golf data to answer two questions. If you get stuck, press <b>Hint</b>.</p>' +
      '<details class="nb-more"><summary>Show the golf data</summary><div class="nb-scroll"><table class="nb-table nb-data" id="qz-data"></table></div></details>' +
      '<div class="nb-card nb-mt"><div class="nb-quizhead"><div id="qz-query"></div><div class="nb-score" id="qz-score"></div></div><div id="qz-body"></div>' +
      '<div class="nb-controls"><button type="button" class="nb-btn nb-primary" id="qz-new">New day</button></div></div>';
    $("#qz-data", el).innerHTML = "<thead><tr><th>#</th>" + FEATS.map(function (f) { return "<th>" + f.key + "</th>"; }).join("") + "<th>Play</th></tr></thead><tbody>" +
      DATA.map(function (r, i) { return "<tr><td>" + (i + 1) + "</td>" + r.slice(0, 4).map(function (v) { return "<td>" + v + "</td>"; }).join("") + '<td class="lab-' + r[4].toLowerCase() + '">' + r[4] + "</td></tr>"; }).join("") + "</tbody>";
    $("#qz-new", el).addEventListener("click", newQuestion);
    newQuestion();
  });
  function rnd(a) { return a[Math.floor(Math.random() * a.length)]; }
  function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
  function newQuestion() {
    var q = FEATS.map(function (f) { return rnd(f.values); });
    var fi = Math.floor(Math.random() * 4), c = rnd(CLASSES);
    var r = solve(q, false), l = r.lik[c][fi], nc = classSize(c), other = 14 - nc;
    var correct = l.num + "/" + l.den, opts = [];
    [correct, l.cnt + "/14", l.cnt + "/" + other, (l.cnt + 1) + "/" + (nc + l.k), (l.cnt + 1) + "/" + nc].forEach(function (o) { if (opts.indexOf(o) < 0 && opts.length < 4) opts.push(o); });
    qz.cur = { q: q, fi: fi, c: c, r: r, correct: correct, opts: shuffle(opts), a1: null, a2: null, h1: false, h2: false };
    renderQuiz();
  }
  function renderQuiz() {
    var k = qz.cur, r = k.r, f = FEATS[k.fi], nc = classSize(k.c), l = r.lik[k.c][k.fi];
    $("#qz-query").innerHTML = "<b>New day:</b> " + k.q.map(function (v, i) { return pill(FEATS[i].key + " = " + v); }).join(" ");
    $("#qz-score").textContent = "Score: " + qz.right + " / " + qz.total;
    var h = '<div class="nb-q"><b>Question 1.</b> What is ' + m("<i>P</i>(" + f.key + " = " + k.q[k.fi] + " | " + k.c + ")") + "?" +
      '<div class="nb-opts" style="margin-top:.45rem">' + k.opts.map(function (o) {
        var p = o.split("/"), st = "";
        if (k.a1) st = o === k.correct ? " right" : o === k.a1 ? " wrong" : "";
        return '<button type="button" class="nb-btn nb-opt' + st + '" data-a1="' + o + '"' + (k.a1 ? " disabled" : "") + ">" + m(frac(p[0], p[1])) + "</button>";
      }).join("") + (k.a1 ? "" : '<button type="button" class="nb-btn nb-ghost" data-hint="1">Hint</button>') + "</div>";
    if (k.h1 && !k.a1) h += '<div class="nb-hint">Look only at the ' + nc + " " + k.c + " days. How many of them have " + f.key + " = " + k.q[k.fi] + "? That number goes on top, and " + nc + " goes at the bottom.</div>";
    if (k.a1) h += '<div class="nb-fb ' + (k.a1 === k.correct ? "ok" : "no") + '">' + f.key + " = " + k.q[k.fi] + " appears on " + l.cnt + " of the " + nc + " " + k.c + " days, so the answer is " + l.cnt + "/" + nc + ".</div>";
    h += "</div>";
    if (k.a1) {
      h += '<div class="nb-q"><b>Question 2.</b> Which class does Naïve Bayes predict for this day?<div class="nb-opts" style="margin-top:.45rem">' +
        ["Yes", "No"].map(function (o) {
          var st = ""; if (k.a2) st = o === r.pred ? " right" : o === k.a2 ? " wrong" : "";
          return '<button type="button" class="nb-btn nb-opt' + st + '" data-a2="' + o + '"' + (k.a2 ? " disabled" : "") + ">" + o + "</button>";
        }).join("") + (k.a2 ? "" : '<button type="button" class="nb-btn nb-ghost" data-hint="2">Hint</button>') + "</div>";
      if (k.h2 && !k.a2) h += '<div class="nb-hint">Compute Score(Yes) = 9/14 × the four Yes fractions, and Score(No) = 5/14 × the four No fractions. The bigger score wins.</div>';
      h += "</div>";
    }
    if (k.a2) {
      h += '<div class="nb-q"><div class="nb-fb ' + (k.a2 === r.pred ? "ok" : "no") + '">The prediction is ' + r.pred + ". Here is the full solution:</div>" +
        '<div style="margin-top:.5rem">' + scoreRows(r) + "</div>" + (r.pred ? postBars(r) : "") +
        (r.score.Yes === 0 || r.score.No === 0 ? '<div class="nb-callout warn">One score is exactly 0 because a value never appeared with that class. Laplace smoothing (Example 3) would fix this.</div>' : "") + "</div>";
    }
    $("#qz-body").innerHTML = h;
    $$("#qz-body [data-hint]").forEach(function (b) { b.addEventListener("click", function () { if (b.getAttribute("data-hint") === "1") k.h1 = true; else k.h2 = true; renderQuiz(); }); });
    $$("#qz-body [data-a1]").forEach(function (b) { b.addEventListener("click", function () { if (k.a1) return; k.a1 = b.getAttribute("data-a1"); qz.total++; if (k.a1 === k.correct) qz.right++; renderQuiz(); }); });
    $$("#qz-body [data-a2]").forEach(function (b) { b.addEventListener("click", function () { if (k.a2) return; k.a2 = b.getAttribute("data-a2"); qz.total++; if (k.a2 === r.pred) qz.right++; renderQuiz(); }); });
  }

  // ================================================================ navigation
  var holder = $("#nb-pages"), cur = 0, visited = {};
  PAGES.forEach(function (p) {
    var sec = document.createElement("section");
    sec.className = "nb-page"; sec.id = "nb-" + p.id; sec.hidden = true; sec.setAttribute("aria-label", p.title);
    holder.appendChild(sec);
    p.el = sec;
    p.build(sec);
  });
  var prog = $("#nb-progress");
  prog.innerHTML = PARTS.map(function (pt) {
    var n = 0;
    return '<div class="nb-part" data-part="' + pt.id + '"><span class="nb-partlabel">' + pt.label + '</span><div class="nb-chaps">' +
      PAGES.map(function (p, i) {
        if (p.part !== pt.id) return "";
        n++;
        return '<button type="button" class="nb-chap" data-i="' + i + '" title="' + p.title.replace(/"/g, "&quot;") + '" aria-label="' + p.title.replace(/"/g, "&quot;") + '">' + n + "</button>";
      }).join("") + "</div></div>";
  }).join("");
  $$(".nb-chap").forEach(function (b) { b.addEventListener("click", function () { show(+b.getAttribute("data-i"), true); }); });
  $("#nb-prev").addEventListener("click", function () { show(cur - 1, true); });
  $("#nb-next").addEventListener("click", function () { show(cur + 1, true); });
  function show(i, scroll) {
    if (i < 0 || i >= PAGES.length) return;
    hidePop(); stopPlay(); stopAnim();
    cur = i; visited[i] = true;
    PAGES.forEach(function (p, j) { p.el.hidden = j !== i; });
    $$(".nb-chap").forEach(function (b) {
      var j = +b.getAttribute("data-i");
      if (j === i) b.setAttribute("aria-current", "page"); else b.removeAttribute("aria-current");
      b.classList.toggle("done", !!visited[j] && j !== i);
    });
    $$(".nb-part").forEach(function (p) { p.classList.toggle("on", p.getAttribute("data-part") === PAGES[i].part); });
    $("#nb-progress-fill").style.width = ((i + 1) / PAGES.length * 100) + "%";
    var prev = $("#nb-prev"), next = $("#nb-next");
    prev.hidden = i === 0; next.hidden = i === PAGES.length - 1;
    if (i > 0) prev.textContent = "← " + PAGES[i - 1].title;
    if (i < PAGES.length - 1) next.textContent = "Next: " + PAGES[i + 1].title + " →";
    if (PAGES[i].onShow) PAGES[i].onShow();
    try { history.replaceState(null, "", "#" + PAGES[i].id); } catch (e) { /* ignore */ }
    if (scroll) root.scrollIntoView({ behavior: "smooth", block: "start" });
  }
  document.addEventListener("keydown", function (e) {
    var tag = (e.target && e.target.tagName) || "";
    if (tag === "INPUT" || tag === "SELECT" || tag === "TEXTAREA") return;
    if (PAGES[cur].id !== "b2") return;
    if (e.key === "ArrowRight") { stopPlay(); go(1); }
    if (e.key === "ArrowLeft") { stopPlay(); go(-1); }
  });

  var themeBtn = $("#nb-theme");
  themeBtn.addEventListener("click", function () {
    var dark = root.getAttribute("data-theme") !== "dark";
    root.setAttribute("data-theme", dark ? "dark" : "light");
    themeBtn.textContent = dark ? "Light mode" : "Dark mode";
    drawGauss();
  });

  window.addEventListener("hashchange", function () {
    var id = (location.hash || "").slice(1);
    PAGES.forEach(function (p, i) { if (p.id === id && i !== cur) show(i, true); });
  });

  var start = 0, hh = (location.hash || "").slice(1);
  PAGES.forEach(function (p, i) { if (p.id === hh) start = i; });
  show(start, false);
})();
</script>
