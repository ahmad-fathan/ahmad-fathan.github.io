---
interface Props {
  title: string;
  subtitle?: string;
  linkHref?: string;
  linkLabel?: string;
}
const { title, subtitle, linkHref, linkLabel } = Astro.props;
---

<div class="mb-8 flex items-end justify-between gap-4">
  <div>
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>
    {subtitle && <p class="mt-2 text-muted">{subtitle}</p>}
  </div>
  {linkHref && linkLabel && (
    <a href={linkHref} class="shrink-0 text-sm font-semibold text-primary hover:text-primary-dark">{linkLabel} →</a>
  )}
</div>
