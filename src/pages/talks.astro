---
import Layout from "../components/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { profiles } from "../config/site";
import { getCollection } from "astro:content";

const events = (await getCollection("speaking")).sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)
);
const byYear = [...new Set(events.map((e) => e.data.year))].sort((a, b) => b - a);
const inviteSubject = encodeURIComponent("Speaking / workshop invitation for Ahmad Fathan Hidayatullah");
---

<Layout
  path="/talks"
  title="Talks — Ahmad Fathan Hidayatullah"
  description="Invited talks, seminars, workshops, and trainings by Ahmad Fathan Hidayatullah on AI, natural language processing, and data science."
>
  <PageHeader
    eyebrow="Talks"
    title="Talks, Seminars & Workshops"
    lede="Invited talks, seminars, workshops, and trainings on artificial intelligence, natural language processing, and data science — newest first."
  />

  <div class="container-site py-14 space-y-14">
    {byYear.map((year) => (
      <section>
        <h2 class="flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-faint">
          <span>{year}</span>
          <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
        </h2>
        <ul class="mt-4 list-none space-y-3">
          {events
            .filter((e) => e.data.year === year)
            .map((e) => (
              <li class="rounded-xl border border-line bg-paper p-5">
                <p class="font-semibold leading-snug tracking-tight">{e.data.talk ?? e.data.event_name}</p>
                <p class="mt-1.5 text-sm text-muted">
                  {e.data.event_name}
                  {e.data.organizer ? ` · ${e.data.organizer}` : ""}
                  {e.data.location ? ` · ${e.data.location}` : ""}
                </p>
                {(e.data.eventUrl || e.data.materialUrl) && (
                  <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 text-sm">
                    {e.data.eventUrl && <a href={e.data.eventUrl} class="font-medium text-primary hover:text-primary-dark" target="_blank" rel="noopener noreferrer">Event ↗</a>}
                    {e.data.materialUrl && <a href={e.data.materialUrl} class="font-medium text-primary hover:text-primary-dark" target="_blank" rel="noopener noreferrer">Materials ↗</a>}
                  </div>
                )}
              </li>
            ))}
        </ul>
      </section>
    ))}

    <section class="rounded-2xl border border-line bg-primary-soft/60 p-10 text-center">
      <h2 class="text-2xl font-bold tracking-tight">Invite me to speak</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">
        Available for seminars, workshops, guest lectures, and training on AI, NLP, and data science — for universities, communities, and professional audiences.
      </p>
      <a href={`mailto:${profiles.email}?subject=${inviteSubject}`} class="btn btn-primary mt-7">Email me</a>
    </section>
  </div>
</Layout>
