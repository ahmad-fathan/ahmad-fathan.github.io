---
import Layout from "../components/Layout.astro";
---

<Layout path="/404" title="Page Not Found — Ahmad Fathan Hidayatullah">
  <div class="container-site flex flex-col items-center py-28 text-center">
    <p class="font-mono text-6xl font-bold text-primary">404</p>
    <h1 class="mt-5 text-2xl font-bold tracking-tight sm:text-3xl">Page not found</h1>
    <p class="mt-3 max-w-md text-muted">The page you are looking for does not exist or has moved.</p>
    <a href="/" class="btn btn-primary mt-8">Back to home</a>
  </div>
</Layout>
