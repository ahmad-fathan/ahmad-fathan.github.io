---
import Layout from "../components/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PublicationCite from "../components/PublicationCite.astro";
import TeachingGroups from "../components/TeachingGroups.astro";
import { site, profiles, researchInterests } from "../config/site";
import { publications } from "../data/publications";
import { ui } from "../i18n/ui";
import { getCollection } from "astro:content";

const t = (k: keyof typeof ui.en) => ui.en[k];
const latest = [...publications].sort((a, b) => b.year - a.year).slice(0, 4);
const talks = (await getCollection("speaking"))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .slice(0, 4);
---

<Layout path="/">
  <!-- Hero -->
  <section class="border-b border-line bg-soft">
    <div class="container-site flex flex-col items-center gap-10 py-16 sm:py-20 md:flex-row md:gap-14">
      <img
        src="/images/profile.jpg"
        alt="Ahmad Fathan Hidayatullah"
        width="512"
        height="512"
        class="h-40 w-40 shrink-0 rounded-full border-4 border-paper object-cover shadow-xl ring-1 ring-line sm:h-48 sm:w-48"
      />
      <div class="text-center md:text-left">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Ahmad Fathan Hidayatullah, PhD</h1>
        <p class="mt-3 text-lg font-semibold text-primary">{site.tagline.en}</p>
        <p class="mt-1 text-sm text-muted">{site.affiliation}</p>
        <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-muted md:mx-0">{site.intro.en}</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3 md:justify-start">
          <a href={profiles.scopus} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Scopus ↗</a>
          <a href={profiles.googleScholar} class="btn btn-outline" target="_blank" rel="noopener noreferrer">Google Scholar ↗</a>
          <a href={`mailto:${profiles.email}`} class="btn btn-outline">{t("cta.emailMe")}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Research interests -->
  <section class="container-site py-14">
    <SectionHeading title={t("home.focus")} linkHref="/research" linkLabel={t("cta.viewAll")} />
    <div class="flex flex-wrap gap-2">
      {researchInterests.map((r) => (
        <span class="rounded-full border border-line bg-soft px-4 py-2 text-sm font-medium text-ink">{r}</span>
      ))}
    </div>
  </section>

  <!-- Recent publications -->
  <section class="border-t border-line bg-soft">
    <div class="container-site py-14">
      <SectionHeading title={t("home.recentPublications")} linkHref="/publications" linkLabel={t("cta.allPublications")} />
      <ol class="grid list-none gap-5 md:grid-cols-2">
        {latest.map((p) => (
          <li class="rounded-xl border border-line bg-paper p-5">
            <PublicationCite pub={p} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Teaching -->
  <section class="container-site py-14">
    <SectionHeading title={t("home.teaching")} linkHref="/teaching" linkLabel={t("cta.viewAll")} />
    <TeachingGroups lang="en" />
  </section>

  <!-- Recent talks -->
  <section class="border-t border-line bg-soft">
    <div class="container-site py-14">
      <SectionHeading title={t("home.talks")} linkHref="/talks" linkLabel={t("cta.viewAll")} />
      <ul class="grid list-none gap-4 sm:grid-cols-2">
        {talks.map((e) => (
          <li class="rounded-xl border border-line bg-paper p-5">
            <p class="text-xs font-semibold uppercase tracking-widest text-faint">{e.data.year}</p>
            <p class="mt-2 font-semibold leading-snug tracking-tight">{e.data.talk ?? e.data.event_name}</p>
            <p class="mt-1 text-sm text-muted">{e.data.event_name}{e.data.organizer ? ` · ${e.data.organizer}` : ""}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
