---
import Layout from "../components/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import PublicationCite from "../components/PublicationCite.astro";
import { profiles } from "../config/site";
import { publications } from "../data/publications";

const sorted = [...publications].sort((a, b) => b.year - a.year);
const years = [...new Set(sorted.map((p) => p.year))].sort((a, b) => b - a);
const profilesList = [
  { label: "Google Scholar", href: profiles.googleScholar },
  { label: "Scopus", href: profiles.scopus },
  { label: "ORCID", href: profiles.orcid },
];
---

<Layout
  path="/publications"
  title="Publications — Ahmad Fathan Hidayatullah"
  description="Peer-reviewed publications by Ahmad Fathan Hidayatullah on natural language processing, code-mixed text, text mining, and data science."
>
  <PageHeader
    eyebrow="Publications"
    title="Publications"
    lede="Peer-reviewed journal articles, conference papers, and book chapters on natural language processing, code-mixed text, text mining, and data science."
  />

  <div class="container-site py-14 space-y-14">
    <section aria-labelledby="author-profiles">
      <h2 id="author-profiles" class="text-2xl font-bold tracking-tight">Author Profiles</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
        The complete, always up-to-date record — including citation metrics — lives on the author profiles below.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        {profilesList.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="btn btn-outline" aria-label={`${s.label} profile (opens in a new tab)`}>
            {s.label} ↗
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="list" class="space-y-10">
      <h2 id="list" class="sr-only">Publication list</h2>
      {years.map((year) => (
        <div>
          <h3 class="flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-faint">
            <span>{year}</span>
            <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
          </h3>
          <ol class="mt-4 list-none space-y-5">
            {sorted
              .filter((p) => p.year === year)
              .map((p) => (
                <li class="pl-8 -indent-8">
                  <PublicationCite pub={p} />
                </li>
              ))}
          </ol>
        </div>
      ))}
    </section>
  </div>
</Layout>
