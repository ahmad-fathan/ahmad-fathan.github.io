---
// Course page: course details plus its interactive simulations, grouped by material.
// One page is generated for every entry in `coursePages` (src/data/simulations.ts).
import Layout from "../../components/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getEntry } from "astro:content";
import { coursePages, simulationsFor, simulationHref, groupByMaterial } from "../../data/simulations";

export function getStaticPaths() {
  return coursePages.map((c) => ({ params: { course: c.slug }, props: { courseId: c.courseId, slug: c.slug } }));
}

const { courseId, slug } = Astro.props as { courseId: string; slug: string };
const entry = await getEntry("teaching", courseId);
if (!entry) throw new Error(`Course "${courseId}" not found in src/content/teaching`);
const { data } = entry;
const name = data.name.en;
const desc = data.description?.en ?? "";
const groups = groupByMaterial(simulationsFor(courseId));
const total = groups.reduce((n, g) => n + g.items.length, 0);
const levelLabel: Record<string, string> = { S1: "Undergraduate (S1)", D4: "Applied Bachelor (D4)", S2: "Master (S2)" };
const prodiLabel: Record<string, string> = { Informatika: "Informatics", "Bisnis Digital": "Digital Business", "Informatika (IP)": "Informatics (International Programme)" };
const prodiRaw = data.fakultasProdi?.split(" - ")[1] ?? data.fakultasProdi;
---

<Layout
  path={`/teaching/${slug}`}
  title={`${name} — Ahmad Fathan Hidayatullah`}
  description={`${desc} Interactive simulations for the course materials.`.trim()}
>
  <PageHeader
    eyebrow={`Teaching · ${levelLabel[data.jenjang ?? ""] ?? data.level}`}
    title={name}
    lede={desc || undefined}
  />

  <div class="container-site py-12">
    <nav class="text-sm text-muted" aria-label="Breadcrumb">
      <a href="/teaching" class="font-medium text-primary hover:text-primary-dark">Teaching</a>
      <span class="mx-1.5">/</span>
      <span>{name}</span>
    </nav>

    <p class="mt-4 text-sm text-muted">
      {data.institution}{prodiRaw && <> · {prodiLabel[prodiRaw] ?? prodiRaw}</>}
    </p>
    {data.topics && data.topics.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {data.topics.map((t: string) => (
          <li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{t}</li>
        ))}
      </ul>
    )}

    <section class="mt-12">
      <h2 class="text-2xl font-bold tracking-tight">Interactive Simulations</h2>
      <p class="mt-2 max-w-2xl text-muted">
        Step-by-step simulations for the course materials. Each one explains the idea first, then works through examples, then lets you practice.
      </p>

      {total === 0 && <p class="mt-6 text-muted">Simulations for this course will be added soon.</p>}

      {groups.map((g) => (
        <div class="mt-10">
          <h3 class="eyebrow">{g.material}</h3>
          <ul class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((s) => (
              <li class="flex">
                <a
                  href={simulationHref(s)}
                  class="group flex w-full flex-col rounded-xl border border-line bg-paper p-6 transition-colors hover:border-primary/50 hover:bg-soft"
                >
                  <h4 class="text-xl font-bold tracking-tight group-hover:text-primary">{s.title}</h4>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{s.summary}</p>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {s.topics.map((t) => (
                      <li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{t}</li>
                    ))}
                  </ul>
                  <span class="mt-5 text-sm font-semibold text-primary">Open simulation →</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      {total > 0 && <p class="mt-10 text-sm text-muted">More simulations for other materials will be added over time.</p>}
    </section>
  </div>
</Layout>
