---
import Layout from "../../../components/Layout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import SetSim from "../../../components/simulations/SetSim.astro";
---

<Layout
  path="/teaching/fundamentals-of-mathematics/sets"
  title="Sets and Set Operations: Interactive Simulation — Ahmad Fathan Hidayatullah"
  description="Interactive, step-by-step Venn diagram simulation of set operations (union, intersection, complement, difference, symmetric difference) and counting with the Principle of Inclusion-Exclusion."
>
  <PageHeader
    eyebrow="Fundamentals of Mathematics · Set Theory"
    title="Sets and Set Operations"
    lede="Watch each set operation happen on a Venn diagram, one step at a time. Every step says where to look, what to write, and why."
  />

  <div class="container-site py-10">
    <nav class="mb-6 text-sm text-muted" aria-label="Breadcrumb">
      <a href="/teaching" class="font-medium text-primary hover:text-primary-dark">Teaching</a>
      <span class="mx-1.5">/</span>
      <a href="/teaching/fundamentals-of-mathematics" class="font-medium text-primary hover:text-primary-dark">Fundamentals of Mathematics</a>
      <span class="mx-1.5">/</span>
      <span>Sets and Set Operations</span>
    </nav>

    <SetSim />

    <section class="mt-14 max-w-3xl">
      <h2 class="text-xl font-bold tracking-tight">How to use this page</h2>
      <ul class="mt-3 list-disc space-y-2 pl-6 text-muted marker:text-primary">
        <li><b class="text-ink">Pick an example</b> with the buttons at the top. They go from easy to harder: basic operations, symmetric difference, a combined expression, then counting with two and three sets.</li>
        <li><b class="text-ink">Step through</b> with <b class="text-ink">Next</b> and <b class="text-ink">Back</b> (or the ← → keys). The shaded region on the diagram is the answer to the current step.</li>
        <li><b class="text-ink">Guess first</b> hides each answer until you choose it yourself. A wrong choice gets a short hint.</li>
        <li><b class="text-ink">Play</b> runs the steps automatically, useful when presenting in class. Each example has its own link (for example <code>#ex4</code> for counting two sets).</li>
      </ul>
    </section>
  </div>
</Layout>
