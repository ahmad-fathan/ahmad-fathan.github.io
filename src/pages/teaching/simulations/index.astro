---
import Layout from "../../../components/Layout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { simulations } from "../../../data/simulations";
---

<Layout
  path="/teaching/simulations"
  title="Interactive Simulations — Ahmad Fathan Hidayatullah"
  description="Interactive, step-by-step simulations of machine learning and data science methods, built for courses at Universitas Islam Indonesia."
>
  <PageHeader
    eyebrow="Teaching"
    title="Interactive Simulations"
    lede="Step-by-step simulations of machine learning and data science methods. Each one follows the worked examples used in class, so students can replay a calculation at their own pace."
  />

  <div class="container-site py-14">
    <p class="text-sm text-muted">
      <a href="/teaching" class="font-medium text-primary hover:text-primary-dark">← Teaching</a>
    </p>

    <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {simulations.map((s) => (
        <li class="flex">
          <a
            href={`/teaching/simulations/${s.slug}`}
            class="group flex w-full flex-col rounded-xl border border-line bg-paper p-6 transition-colors hover:border-primary/50 hover:bg-soft"
          >
            <p class="eyebrow">{s.course}</p>
            <h2 class="mt-2 text-xl font-bold tracking-tight group-hover:text-primary">{s.title}</h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{s.summary}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {s.topics.map((t) => (
                <li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{t}</li>
              ))}
            </ul>
            <span class="mt-5 text-sm font-semibold text-primary">Open simulation →</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-10 text-sm text-muted">More simulations will be added over time.</p>
  </div>
</Layout>
