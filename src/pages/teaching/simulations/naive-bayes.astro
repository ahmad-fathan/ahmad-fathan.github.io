---
import Layout from "../../../components/Layout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import NaiveBayesSim from "../../../components/simulations/NaiveBayesSim.astro";
---

<Layout
  path="/teaching/simulations/naive-bayes"
  title="Naïve Bayes Classifier: Interactive Simulation — Ahmad Fathan Hidayatullah"
  description="Interactive, step-by-step simulation of Bayes' theorem and the Naïve Bayes classifier: spam example, Play Golf solver, Laplace smoothing, Gaussian Naïve Bayes, and practice questions."
>
  <PageHeader
    eyebrow="Interactive Simulation · Data Science Fundamentals"
    title="Naïve Bayes Classifier"
    lede="Follow the worked examples from class one step at a time: Bayes' theorem with a single feature, the five-step solution of the Play Golf problem, Laplace smoothing, and Gaussian Naïve Bayes for continuous features."
  />

  <div class="container-site py-10">
    <p class="mb-6 text-sm text-muted">
      <a href="/teaching/simulations" class="font-medium text-primary hover:text-primary-dark">← All simulations</a>
    </p>

    <NaiveBayesSim />

    <section class="mt-14 max-w-3xl">
      <h2 class="text-xl font-bold tracking-tight">How to use this page</h2>
      <ul class="mt-3 list-disc space-y-2 pl-6 text-muted marker:text-primary">
        <li><b class="text-ink">Bayes' theorem</b>: change the counts and see how prior, likelihood, and evidence produce the posterior.</li>
        <li><b class="text-ink">Step-by-step solver</b>: pick any weather combination and step through count, prior, likelihood, score, and decide. Use the arrow keys or Play. The "Zero-probability case" button shows why Laplace smoothing is needed.</li>
        <li><b class="text-ink">Gaussian NB</b>: see how a continuous value is scored by the height of each class's normal curve.</li>
        <li><b class="text-ink">Your turn</b>: practice on random days and check the full solution.</li>
      </ul>
    </section>
  </div>
</Layout>
